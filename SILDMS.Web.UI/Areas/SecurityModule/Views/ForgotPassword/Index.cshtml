        app.controller('defaultValueSetupController', ['$scope', '$http', '$window', '$timeout', function ($scope, $http, $window, $timeout) {

            applySecurity();
            $scope.email = '';
            $scope.sendCredentials = function () {
                $http.post("/SecurityModule/ForgotPassword/SendCredentials", { email: $scope.email })
                    .success(function (response) {
                        if (response.Msg == '2') {
                            toastr.success('Password sent to the Mail');
                            // Delay the redirection by 1 second
                            $timeout(function () {
                                $window.location.href = '/';
                            }, 2000); // 1000 milliseconds = 1 second
                        } else if (response.Msg == '0') {
                            toastr.error('Error: Failed to send email !!!');
                            $timeout(function () {
                                $window.location.href = '/';
                            }, 2000); // 1000 milliseconds = 1 second
                        } else {
                            toastr.error('Not registered yet');
                            $timeout(function () {
                                $window.location.href = '/';
                            }, 2000); // 1000 milliseconds = 1 second
                        }
                        $scope.loading = false;
                    })
                    .error(function () {
                        toastr.error('An error occurred while sending credentials.');
                        $timeout(function () {
                            $window.location.href = '/';
                        }, 2000); // 1000 milliseconds = 1 second
                        $scope.loading = false;
                    });
            };

            $scope.toggleRefreshTable = function () {
                $scope.loading = true;
            };
        }]);














</script>
