        $scope.InvWiseMaterialFinancial = function (detail) {
            $http.post('/VendorSelectionModule/FinancialQuotation/InvWiseMaterial',
                { InvNumber: detail })
                .success(function (response) {
                    //$scope.flagToShow = false;
                    //$scope.flagToShowMasterTbl = true;
                    $scope.MaterialList = response.InvMaterialList;

                    $scope.InvitationSendingPerson = $scope.MaterialList[0].InvitationSendPerson;

                    $scope.GridDisplayCollection = [].concat($scope.MaterialList);
                    $scope.loading = false;
                }).error(function () {
                    $scope.loading = false;
                    toastr.error('Data Loading Failed.');
                });

            $('#QuotedInvits').modal('show');
        }




        $scope.InvWiseMaterial = function (detail) {
