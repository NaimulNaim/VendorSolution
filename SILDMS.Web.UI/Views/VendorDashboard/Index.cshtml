                    <h3 class="modal-title">RFQ - {{InvitationNumber}}</h3>
                    <h4>Contact Person - {{InvitationSendingPerson}}</h4>
                </div>

                <!-- Modal Body -->
                <div id="PndRecomAndApprovalTable" class="table-responsive">
                    <table id="tableId" style="width:100%;" st-table="GridDisplayCollection" st-safe-src="MaterialList" class="table table-condensed table-bordered table-striped table-hover pnlView">
