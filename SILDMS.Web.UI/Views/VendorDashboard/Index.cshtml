<div class="row">

    <!-- ===================== TQ DETAILS ===================== -->
    <div class="col-md-4 col-sm-12">
        <div class="box box-primary box-solid">
            <div class="box-header with-border" style="padding:5px"></div>
            <div class="box-body">
                <div class="responsive-table-wrapper">
                    <table st-table="displayedCollection"
                           st-safe-src="invitationTecnicalList"
                           class="table table-condensed table-bordered table-striped table-hover">
                        <thead>
                            <tr>
                                <th style="color:black">RFQ No</th>
                                <th style="color:black">RFQ Date</th>
                                <th style="color:black">RFQ Deadline</th>
                                <th style="color:black">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="item in invitationTecnicalList">
                                <td class="text-center" ng-style="item.TotalItem == 0 ? {'cursor':'not-allowed'} : {'cursor':'pointer'}">
                                    <a ng-if="item.TotalItem != 0"
                                       ng-href="/VendorSelectionModule/TechnicalQuotation?InvitationNumber={{item.InnvitationNumber}} &QuotationSendingDeadline={{formatDatetest(item.QuotationlastDt)}}""
                                       class="text-primary">{{item.InnvitationNumber}}</a>
                                    <span ng-if="item.TotalItem == 0" class="text-muted">{{item.InnvitationNumber}}</span>
                                </td>
                                <td class="text-center">{{formatDatetest(item.InnvitationDt)}}</td>
                                <td class="text-center">{{formatDatetest(item.QuotationlastDt)}}</td>
                                <td class="text-center">
                                    <button class="btn btn-xs btn-info" ng-click="selectPR(item)" title="Select">
                                        <i class="fa fa-info"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-center">
                                    <div st-pagination st-items-by-page="itemsByPage" st-displayed-pages="10"></div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ===================== FQ DETAILS ===================== -->
    <div class="col-md-4 col-sm-12">
        <div class="box box-primary box-solid">
            <div class="box-header with-border" style="padding:5px"></div>
            <div class="box-body">
                <div class="responsive-table-wrapper">
                    <table st-table="displayedCollection"
                           st-safe-src="invitationFinanList"
                           class="table table-condensed table-bordered table-striped table-hover">
                        <thead>
                            <tr>
                                <th style="color:black">RFQ No</th>
                                <th style="color:black">RFQ Date</th>
                                <th style="color:black">RFQ Deadline</th>
                                <th style="color:black">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="item in invitationFinanList">
                                <td class="text-center" ng-style="item.TotalItem == 0 ? {'cursor':'not-allowed'} : {'cursor':'pointer'}">
                                    <a ng-if="item.TotalItem != 0"
                                       ng-href="/VendorSelectionModule/FinancialQuotation?InvitationNumber={{item.InnvitationNumber}} &QuotationSendingDeadline={{formatDatetest(item.QuotationlastDt)}}"
                                       class="text-primary">{{item.InnvitationNumber}}</a>
                                    <span ng-if="item.TotalItem == 0" class="text-muted">{{item.InnvitationNumber}}</span>
                                </td>
                                <td class="text-center">{{formatDatetest(item.InnvitationDt)}}</td>
                                <td class="text-center">{{formatDatetest(item.QuotationlastDt)}}</td>
                                <td class="text-center">
                                    <button class="btn btn-xs btn-info" ng-click="selectPRFinancial(item)" title="Select">
                                        <i class="fa fa-info"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-center">
                                    <div st-pagination st-items-by-page="itemsByPage" st-displayed-pages="10"></div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ===================== RUNNING QUOTATION ===================== -->
