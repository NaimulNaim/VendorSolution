
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}
@*<link href="~/Content/AdminLTE/plugins/css/adminlte.min.css" rel="stylesheet" />*@
@*<link href="~/Content/AdminLTE/plugins/css/all.min.css" rel="stylesheet" />*@
<style>
    .link_total_bm {
        color: black;
        font-weight: bold;
    }

        .link_total_bm :hover {
            color: #0091EA !important;
            font-weight: bold;
        }

    .link_within_bm {
        color: green;
        font-weight: bold;
    }

        .link_within_bm :hover {
            color: #0091EA;
            font-weight: bold;
        }

    .link_out_bm {
        color: firebrick;
        font-weight: bold;
    }

        .link_out_bm :hover {
            color: #0091EA;
            font-weight: bold;
        }

    .global-search {
        height: 34px;
    }

    .btn-round {
        border-radius: 17px;
    }

    .box.box-solid.box-primary > .box-header {
        text-align: center;
    }

    .box.box-solid.box-primary > .box-headerVCMS {
        color: #fff;
        background: #9fc17b;
        background-color: #689b6d;
    }

    .divBox {
        background-color: #c4e7f3;
        height: 110px;
        width: 100%;
        padding-top: 5px;
        padding-bottom: 5px;
        border-radius: 10px;
    }

    .divPU {
        background-color: lightslategray;
        height: 80px;
        width: 100%;
        padding-top: 5px;
        padding-bottom: 5px;
        border-radius: 10px;
    }

    .divDU {
        background-color: skyblue;
        height: 80px;
        width: 100%;
        padding-top: 5px;
        padding-bottom: 5px;
        border-radius: 10px;
    }

    .divCHQ {
        background-color: rosybrown;
        height: 80px;
        width: 100%;
        padding-top: 5px;
        padding-bottom: 5px;
        border-radius: 10px;
    }

    .divAgg {
        background-color: lightgreen;
        height: 80px;
        width: 480px;
        padding-top: 5px;
        padding-bottom: 5px;
        border-radius: 10px;
    }
</style>
<div class="box box-primary box-body" ng-controller="VendorSideDashboardVCMSCtrl">

    <div class="box box-primary box-solid">
        <div class="box-header with-border" style="padding-top:5px;padding-bottom:5px">
            <i class="fa fa-user"></i>
            <h3 class="box-title text-center">Vendor Invitations</h3>
        </div>
        <div class="box-body">
            <div class="row">
                <div class="col-md-12">
                    <div class="divBox">
                        <div class="box-body">
                            <div class="row">
                                <a class="link_within_bm">
                                    <div class="col-sm-4 border-right">
                                        <div class="divCHQ">
                                            <div class="description-block">
                                                <h5 class="description-header">{{TechInvToRespTotal === "" ? 0 : TechInvToRespTotal}}</h5>
                                                <span><b>Technical Invitation to Response </b></span>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                                <a class="link_within_bm">
                                    <div class="col-sm-4 border-right">
                                        <div class="divDU">
                                            <div class="description-block">
                                                <h5 class="description-header">{{FinanInvToRespTotal === "" ? 0 : FinanInvToRespTotal}}</h5>
                                                <span>Financial Invitations to Response</span>
                                            </div>
                                        </div>

                                    </div>
                                </a>
                                <a class="link_out_bm">
                                    <div class="col-sm-4">
                                        <div class="divPU">
                                            <div class="description-block">
                                                <h5 class="description-header">{{RunInvTotal === "" ? 0 : RunInvTotal}}</h5>
                                                <span>Running Invitations</span>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <br />
                <br /><br /><br /><br /><br />
            </div>


        </div>

    </div>



    @*TQ DETAILS*@
    <div class="row">
        <div class="col-sm-4">
            <div class="box box-primary box-solid">
                <div class="box-header with-border" style="padding-top:5px;padding-bottom:5px">
                    <h3 class="box-title text-center">Technical Quotation to Response</h3>
                </div>
                <div class="box-body">
                    <table st-table="displayedCollection" st-safe-src="" class="table table-condensed table-bordered table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Invitation No</th>
                                <th>Invitation Date</th>
                                <th>Quot. Last Dt</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr ng-repeat="item in invitationTecnicalList">
                                <td ng-style="item.TotalItem == 0 ? {'cursor': 'not-allowed'} : {'cursor': 'pointer'}">
                                    <a ng-if="item.TotalItem != 0" href="/VendorSelectionModule/TechnicalQuotation?InnvitationNumber={{item.InnvitationNumber}}" style="color: #3c8dbc !important;">

                                        {{item.InnvitationNumber}}
                                    </a>
                                </td>


                                <td>{{formatDatetest(item.InnvitationDt)}}</td>
                                <td>{{formatDatetest(item.QuotationlastDt)}}</td>
                                <td>
                                    <button type="button" ng-click="selectPR(item)" data-dismiss="modal" title="Select">
                                        <i class="fa fa-info"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>

                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-center">
                                    <div st-pagination="" st-items-by-page="itemsByPage" st-displayed-pages="10"></div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

            </div>

        </div>

        @*FQ DETAILS*@
        <div class="col-sm-4">
            <div class="box box-primary box-solid">
                <div class="box-header with-border" style="padding-top:5px;padding-bottom:5px">
                    <h3 class="box-title text-center">Financial Quotation to Response</h3>
                </div>
                <div class="box-body">
                    <table st-table="displayedCollection" st-safe-src="" class="table table-condensed table-bordered table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Invitation No</th>
                                <th>Invitation Date</th>
                                <th>Quot. Last Dt</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr ng-repeat="item in invitationFinanList">
                                <td ng-style="item.TotalItem == 0 ? {'cursor': 'not-allowed'} : {'cursor': 'pointer'}">
                                    <a ng-if="item.TotalItem != 0" href="/VendorSelectionModule/FinancialQuotation?InnvitationNumber={{item.InnvitationNumber}}"  style="color: #3c8dbc !important;">

                                        {{item.InnvitationNumber}}
                                    </a>
                                </td>
                                <td>{{formatDatetest(item.InnvitationDt)}}</td>
                                <td>{{formatDatetest(item.QuotationlastDt)}}</td>
                                <td>
                                    <button type="button" ng-click="selectPR(item)" data-dismiss="modal" title="Select">
                                        <i class="fa fa-info"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>

                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-center">
                                    <div st-pagination="" st-items-by-page="itemsByPage" st-displayed-pages="10"></div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

            </div>

        </div>


        @*running*@

        <div class="col-md-4">
            <div class="box box-primary box-solid">
                <div class="box-header with-border" style="padding-top:5px;padding-bottom:5px">
                    <h3 class="box-title text-center">Running Quotation to Response</h3>
                </div>
                <div class="box-body">
                    <table st-table="displayedCollection" st-safe-src="" class="table table-condensed table-bordered table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Invitation No</th>
                                <th>Invitation Date</th>
                                <th>Quot. Last Dt</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr ng-repeat="item in invitationRunninglList">
                                <td>{{item.InnvitationNumber}}</td>
                                <td>{{formatDatetest(item.InnvitationDt)}}</td>
                                <td>{{formatDatetest(item.QuotationlastDt)}}</td>
                                <td>
                                    <button type="button" ng-click="selectPR(item)" data-dismiss="modal" title="Select">
                                        <i class="fa fa-info"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>

                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-center">
                                    <div st-pagination="" st-items-by-page="itemsByPage" st-displayed-pages="10"></div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>


    <div id="QuotedInvits" class="modal fade">
        <div class="modal-dialog">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" ng-click="ResetSearchModel()" aria-hidden="true">x</button>
                    <h3 class="modal-title">RFQ - {{InvitationNumber}}</h3>
                </div>

                <!-- Modal Body -->
                <div id="PndRecomAndApprovalTable" class="table-responsive">
                    <table id="tableId" style="width:100%;" st-table="GridDisplayCollection" st-safe-src="MaterialList" class="table table-condensed table-bordered table-striped table-hover pnlView">
                        <thead>
                            <tr>
                                <th class="col-lg-1 col-md-1 col-sm-1">Material Code</th>
                                <th class="col-lg-1 col-md-1 col-sm-1">Material Name</th>
                                <th class="col-lg-1 col-md-1 col-sm-1">Quantity</th>
                                <th class="col-lg-1 col-md-1 col-sm-1">Unit</th>
                                <th class="col-lg-1 col-md-1 col-sm-1">Material Type</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="row in GridDisplayCollection | orderBy:'IsBack':true">
                                <td class="text-right" style="text-align:center">{{formatMaterialCode(row.materialCode)}}</td>
                                <td class="text-left">{{row.materialName}}</td>
                                <td class="text-right">{{row.MaterialQuantity | number:3}}</td>
                                <td class="text-right" style="text-align:center">{{row.Unit}}</td>
                                <!-- Removed Button for Documents -->
                                <td class="text-left">{{row.MatInvType}}</td>
                            </tr>
                        </tbody>
                        <tfoot>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>




    <div id="mydiv" data-ng-show="ParkingLoading || PostingLoading || ClearingLoading || countLoading || tableLoading">
        <div class="overlay">
            <div class="loder">
                <img src="~/Content/AdminLTE/img/cube.gif" /> <span class="text-bold">Loading...</span>
            </div>
        </div>
    </div>



</div>



