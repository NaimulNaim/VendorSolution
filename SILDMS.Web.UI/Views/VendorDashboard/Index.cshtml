<style>

       .link_total_bm {
           color: black;
           font-weight: bold;
       }

           .link_total_bm :hover {
               color: #0091EA !important;
               font-weight: bold;
           }

       .link_within_bm {
           color: green;
           font-weight: bold;
       }

           .link_within_bm :hover {
               color: #0091EA;
               font-weight: bold;
           }

       .link_out_bm {
           color: firebrick;
           font-weight: bold;
       }

           .link_out_bm :hover {
               color: #0091EA;
               font-weight: bold;
           }

       .global-search {
           height: 34px;
       }

       .btn-round {
           border-radius: 17px;
       }

       .box.box-solid.box-primary > .box-header {
           text-align: center;
       }

       .box.box-solid.box-primary > .box-headerVCMS {
           color: #fff;
           background: #9fc17b;
           background-color: #689b6d;
       }

       .divBox {
           background-color: #c4e7f3;
           height: 110px;
           width: 100%;
           padding-top: 5px;
           padding-bottom: 5px;
           border-radius: 10px;
       }

    .divPU {
        background-color: #C9E2B8;
        height: 80px;
        width: 100%;
        padding-top: 5px;
        padding-bottom: 5px;
        border-radius: 10px;
    }

    .divDU {
        background-color: #B9CBE9;
        height: 80px;
        width: 100%;
        padding-top: 5px;
        padding-bottom: 5px;
        border-radius: 10px;
    }

    .divCHQ {
        background-color: #FCB788;
        height: 80px;
        width: 100%;
        padding-top: 5px;
        padding-bottom: 5px;
        border-radius: 10px;
    }

       .divAgg {
           background-color: lightgreen;
           height: 80px;
           width: 480px;
           padding-top: 5px;
           padding-bottom: 5px;
           border-radius: 10px;
       }
    .responsive-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

        /* Base table styling */
        .responsive-table-wrapper table {
            width: 100%;
            table-layout: fixed; /* REQUIRED for column widths */
            font-size: clamp(10px, 0.8vw, 14px);
        }

        /* Cell styling */
        .responsive-table-wrapper th,
        .responsive-table-wrapper td {
            padding: clamp(4px, 0.5vw, 8px);
            word-break: break-word;
            text-align: center;
        }

        /* Vertically center grouped headers (rowspan / colspan) */
        .responsive-table-wrapper thead tr:first-child th {
            vertical-align: middle;
        }

        /* Quotation No column — ~40% width */
            .responsive-table-wrapper td:nth-child(1),
            .responsive-table-wrapper thead tr:first-child th:nth-child(1)
            {
                width: 28%;
            }

        .responsive-table-wrapper td:nth-child(2),
        .responsive-table-wrapper thead tr:first-child th:nth-child(2) {
            width: 23%;
        }

        /* Column 3 — RFQ Deadline */
        .responsive-table-wrapper td:nth-child(3),
        .responsive-table-wrapper thead tr:first-child th:nth-child(3) {
            width: 24%;
        }

        /* Column 4 — Tech */
        .responsive-table-wrapper td:nth-child(4),
        .responsive-table-wrapper thead tr:nth-child(2) th:nth-child(1) {
            width: 14%;
        }

        /* Column 5 — Fin */
        .responsive-table-wrapper td:nth-child(5),
        .responsive-table-wrapper thead tr:nth-child(2) th:nth-child(2) {
            width: 13%;
        }

        /* Vertically center grouped headers */
        .responsive-table-wrapper thead tr:first-child th {
            vertical-align: middle;
        }




        /* Buttons scale proportionally */
        .responsive-table-wrapper .btn-xs {
            font-size: clamp(8px, 0.7vw, 12px);
            padding: clamp(2px, 0.4vw, 4px) clamp(4px, 1vw, 6px);
        }

    /* Small screens — Razor-safe */
    @@media screen and (max-width: 1080px) {
        .responsive-table-wrapper table {
            font-size: clamp(8px, 1.5vw, 12px);
        }

        .responsive-table-wrapper th,
        .responsive-table-wrapper td {
            text-align: left;
        }

        .responsive-table-wrapper .btn-xs {
            font-size: clamp(6px, 1.2vw, 10px);
        }
    }

</style>


