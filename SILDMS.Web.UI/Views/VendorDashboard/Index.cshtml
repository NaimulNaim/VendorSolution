                        </tbody>
                        <tfoot>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>




    <div id="mydiv" data-ng-show="ParkingLoading || PostingLoading || ClearingLoading || countLoading || tableLoading">
        <div class="overlay">
            <div class="loder">
                <img src="~/Content/AdminLTE/img/cube.gif" /> <span class="text-bold">Loading...</span>
            </div>
        </div>
    </div>



</div>



<script type="text/javascript">





    app.controller('VendorSideDashboardVCMSCtrl', ['$scope', '$http', function ($scope, $http) {
        //Start Region for personal data Declaration
        $scope.InvitationList = {};

        $scope.postingResult = {};
        $scope.clearingResult = {};
        $scope.isSupervisor = false;
        $scope.assignmentDivShowHide = false;
        $scope.buttonChecked = false;
        $scope.showAssignmentArea = false;
        $scope.invitationTecnicalList = {};

        var LoadParkingData = function () {
            $scope.ParkingLoading = true;
            $http.get('/VendorSelectionModule/VendorDashboard/GetUserWiseInvList')
                .then(
                    function (response) {
                        $scope.InvitationList = response.data.totalList;

                        $scope.TechInvToRespTotal = $scope.InvitationList.TechInvToRespTotal;
                        $scope.FinanInvToRespTotal = $scope.InvitationList.FinanInvToRespTotal;
                        $scope.RunInvTotal = $scope.InvitationList.RunInvTotal;
                        $scope.invitationTecnicalList = $scope.InvitationList.InvitationTecnicalList;
                        $scope.invitationFinanList = $scope.InvitationList.InvitationFinanList;
