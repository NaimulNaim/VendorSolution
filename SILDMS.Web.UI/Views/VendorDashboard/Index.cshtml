                    $scope.InvitationSendingPerson=$scope.MaterialList[0].InvitationSendPerson;
                    $scope.GridDisplayCollection = [].concat($scope.MaterialList);
                    $scope.loading = false;
                }).error(function () {
                    $scope.loading = false;
                    toastr.error('Data Loading Failed.');
                });

            $('#QuotedInvits').modal('show');
        }



        $scope.formatDatetest = function (dateString) {
            var date = new Date(dateString); // Parse the input date string
            var day = String(date.getDate()).padStart(2, '0'); // Ensure 2-digit day
            var month = String(date.getMonth() + 1).padStart(2, '0'); // Ensure 2-digit month (months are 0-based)
            var year = date.getFullYear(); // Get full year
            return `${day}/${month}/${year}`; // Format as DD/MM/YYYY
        };
        $scope.formatMaterialCode = function (materialCode) {
            return materialCode.replace(/^0+/, '');
        };




