                            <tr>
                                <th class="col-lg-1 col-md-1 col-sm-1">Material Code</th>
                                <th class="col-lg-1 col-md-1 col-sm-1">Material Name</th>
                                <th class="col-lg-1 col-md-1 col-sm-1">Quantity</th>
                                <th class="col-lg-1 col-md-1 col-sm-1">Unit</th>
                                @*<th class="col-lg-1 col-md-1 col-sm-1">Material Type</th>*@
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="row in GridDisplayCollection | orderBy:'IsBack':true">
                                <td class="text-right" style="text-align:center">{{formatMaterialCode(row.materialCode)}}</td>
                                <td class="text-left">{{row.materialName}}</td>
                                <td class="text-right">{{row.MaterialQuantity | number:3}}</td>
                                <td class="text-right" style="text-align:center">{{row.Unit}}</td>
