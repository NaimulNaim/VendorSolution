    <div class="row">
        <table st-table="displayScannedDocuments" st-safe-src="scannedDocuments"
               class="table table-condensed table-bordered table-striped table-hover">
            <thead>
                <tr>
                    <th st-sort="DocPropertyName">Document Name</th>
                    <th st-sort="IdentificationAttribute">Identification Attribute</th>
                    <th st-sort="MetaValue">Attribute Value</th>
                    <th st-sort="FileServerURL" class="hidden">FileServerURL</th>
                    <th st-sort="">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="row in displayScannedDocuments">
                    @*<td class="hidden">{{row.DocMetaID}}</td>*@
                    <td class="hidden">{{row.DocumentID}}</td>
                    <td class="col-lg-2">{{row.DocPropertyName}}</td>
                    <td class="col-lg-3">{{row.IdentificationAttribute}}</td>
                    <td class="col-lg-3">{{row.MetaValue}}</td>
                    <td class="hidden">{{row.FileServerURL}}</td>
                    <td class="col-lg-3">
                        @*<button type="button" class="btn btn-xs btn-info btn-flat" data-ng-click="LoadImage(row)" style="display: inline-block;"><i class="fa fa-search-plus"></i> Quick View</button>*@
                        <button type="button" class="btn btn-xs btn-success btn-flat" data-ng-click="getScannedDocs(row)"><i class="fa fa-list"></i> Detail View</button>
                        <button type="button" ng-if="row.DocClassification != 'Required'" class="btn btn-xs btn-primary btn-flat" data-ng-click="showDeleteConfirmModal(row)" style="display: inline-block;"><i class="fa fa-edit"></i> Delete</button>
                        <button type="button" class="btn btn-xs btn-primary btn-flat" data-ng-click="showEditModal(row)" style="display: inline-block;"><i class="fa fa-edit"></i> Edit</button>
                        @*<button type="button" class="btn btn-xs btn-danger btn-flat" data-ng-click="ShowDeleteConfirmModal(row)" style="display: inline-block;"><i class="fa fa-edit"></i> Delete</button>*@
                    </td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="6" class="text-center">
                        <div st-pagination="" st-items-by-page="itemsByPage"></div>
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>







