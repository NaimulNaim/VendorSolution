                    style="font-size: smaller; padding: 3px 6px 3px;">
                <option value="">-- Select Business Nature --</option>
            </select>
        </div>


    </div>


    <div class="row" style="margin-top: 5px;">
        <div class="col-lg-2">
            <div class="form-group" style="font-size: smaller;">
                <label for="Country">Country </label>
            </div>
        </div>
        <div class="col-lg-4">
            <select class="form-control"
                    ng-model="PurreqDtl.Vendor.Country"
                    ng-options="bn as bn.CountryName for bn in CountryList track by bn.CountryID"
                   
