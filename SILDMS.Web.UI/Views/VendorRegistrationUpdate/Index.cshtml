    <div class="row" style="margin-top: 5px;">
        <div class="col-lg-2" style="font-size: smaller;">
            <label for="VendorPhoneNumber">Contact Number<span style="color: red;"> *</span></label>
        </div>

        <!-- First number with + button -->
        <div class="col-lg-2" style="display: flex; align-items: center;">
            <input type="text" class="form-control"
                   ng-model="PurreqDtl.Vendor.VendorPhoneNumber"
                   placeholder="" style="flex:1;" required />
            <button type="button" ng-if="!AddNumber"
                    ng-click="AddAnotherNumber('add')"
                    class="btn btn-default" style="margin-left: 5px;">
                +
            </button>
        </div>

        <!-- Second number with - button -->
        <div class="col-lg-2" ng-if="AddNumber" style="display: flex; align-items: center;">
            <input type="text" class="form-control"
                   ng-model="PurreqDtl.Vendor.VendorPhoneNumber2"
                   placeholder="" style="flex:1;" required />
            <button type="button" ng-click="AddAnotherNumber('remove')"
                    class="btn btn-default" style="margin-left: 5px;">
                -
            </button>
        </div>
    </div>





    <div class="row" style="margin-top: 5px;">
        <div class="col-lg-2" style="font-size: smaller;">
            <label for="TIN">TIN </label>
        </div>
        <div class="col-lg-2">
            <input id="TIN" type="text" autocomplete="off" name="TIN" class="form-control" ng-model="PurreqDtl.Vendor.TIN" placeholder="" style="font-size: smaller; padding: 3px 6px 3px;" />
