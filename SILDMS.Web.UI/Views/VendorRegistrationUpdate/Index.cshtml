            <div class="form-group" style="font-size: smaller;">
                <label for="BusinessType">Business Type </label>
            </div>
        </div>

        <div class="col-lg-4">
            <select class="form-control"
                    ng-model="PurreqDtl.Vendor.BusinessType"
                    ng-options="bt as bt.BusinessTypeName for bt in BusinessTypeList track by bt.BusinessTypeID"
                    style="font-size: smaller; padding: 3px 6px 3px;">
                <option value="">-- Select Business Type --</option>
            </select>
        </div>


    </div>

    <div class="row" style="margin-top: 5px;">
        <div class="col-lg-2">
            <div class="form-group" style="font-size: smaller;">
                <label for="BusinessType">Business Nature </label>
            </div>
        </div>

        <div class="col-lg-4">
            <select class="form-control"
                    ng-model="PurreqDtl.Vendor.BusinessNature"
