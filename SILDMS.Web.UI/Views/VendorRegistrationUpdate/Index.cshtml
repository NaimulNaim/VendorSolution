@{
    ViewBag.Title = "Temporary";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<style>
    /* ── Section card ── */
    .reg-card {
        background: #fff;
        border: 1px solid #dce1e7;
        border-radius: 6px;
        box-shadow: 0 2px 8px rgba(0,0,0,.08);
        padding: 24px 28px;
        margin-top: 16px;
    }

    /* ── Uniform label column ── */
    .field-label {
        font-size: smaller;
        font-weight: 600;
        color: #444;
        padding-top: 7px;
        text-align: right;
    }

    @@media (min-width: 1200px) {
        .col-lg-2 {
            width: 22.666667%;
        }
    }

    /* ── Required star ── */
    .req {
        color: #c0392b;
        margin-left: 2px;
    }

    /* ── Inputs ── */
    .reg-card .form-control {
        font-size: 12px;
        height: 32px;
        padding: 4px 8px;
        border-radius: 4px;
        border: 1px solid #ccd0d5;
        transition: border-color .2s, box-shadow .2s;
    }

        .reg-card .form-control:focus {
            border-color: #5d9b5e;
            box-shadow: 0 0 0 3px rgba(93,155,94,.15);
            outline: none;
        }

    .reg-card select.form-control {
        height: 32px;
    }

    /* ── File input ── */
    .file-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 6px;
    }

        .file-wrap input[type="file"] {
            font-size: 11px;
            color: #555;
        }

    /* ── Form rows ── */
    .form-row-item {
        margin-bottom: 5px;
    }

    /* ── Page header bar ── */
    .box-header.with-border {
        background: #e4e9e3 !important;
        border-bottom: 2px solid #c8d4c6;
    }

    .box-header .box-title {
        font-family: Verdana, sans-serif;
        font-size: 15px;
        font-weight: 700;
        color: #2c3e2d;
    }

    /* ── Submit button row ── */
    .btn-submit-row {
        border-top: 1px solid #e4e9e3;
        padding-top: 16px;
        margin-top: 20px;
        display: flex;
        justify-content: flex-end;
    }

        .btn-submit-row .btn {
            font-size: 12px;
            padding: 7px 20px;
            border-radius: 4px;
        }

    /* ── Error messages ── */
    .field-error {
        font-size: 11px;
        color: #c0392b;
        margin-top: 3px;
        display: none;
    }

    /* ── View document button (eye icon) ── */
    .button-custom {
        background: transparent;
        border: none;
        color: #000000;
    }

        .button-custom:hover {
            color: #3f6f40;
        }
</style>

<div class="box box-primary box-body" ng-controller="VendorRegistrationUpdateCtrl">

    <!-- ── Page Header ── -->
    <div class="box-header with-border">
        <i class="fa fa-user"></i>
        <h3 class="box-title" ng-if="fromMenu">Update Vendor Registration</h3>
        <div class="box-tools pull-right">
            <button type="button" id="btnRefresh" data-ng-click="toggleRefreshTable(row)"
                    class="btn btn-warning btn-flat btn-sm" ng-disabled="loading">
                <i class="fa fa-refresh"></i> Refresh
            </button>
            <button type="button" id="btnUpdate" data-ng-click="updateRegistration()"
                    class="btn btn-danger btn-flat btn-sm" ng-disabled="loading">
                <i class="fa fa-edit"></i> Update
            </button>
        </div>
    </div>

    <!-- ══════════════════════════════════════
         Registration form (mirrors VendorRegistrationCtrl layout)
    ══════════════════════════════════════ -->
    <div class="reg-card">

        <!-- ── Business Info ── -->
        <div class="row form-row-item">
            <div class="col-lg-2 col-md-3 field-label">
                Business Name <span class="req">*</span>
            </div>
            <div class="col-lg-4 col-md-5">
                <input id="BusinessName" autocomplete="off" type="text" name="BusinessName"
                       class="form-control" ng-model="PurreqDtl.Vendor.BusinessName" required />
                <span class="field-error" id="errorMessageBusinessName">Please input a valid Business Name.</span>
            </div>
        </div>

        <div class="row form-row-item">
            <div class="col-lg-2 col-md-3 field-label">Business Type</div>
            <div class="col-lg-4 col-md-5">
                <select class="form-control"
                        ng-model="PurreqDtl.Vendor.BusinessType"
                        ng-options="bt as bt.BusinessTypeName for bt in BusinessTypeList track by bt.BusinessTypeID">
                    <option value="">-- Select Business Type --</option>
                </select>
            </div>
        </div>

        <div class="row form-row-item">
            <div class="col-lg-2 col-md-3 field-label">Business Nature</div>
            <div class="col-lg-4 col-md-5">
                <select class="form-control"
                        ng-model="PurreqDtl.Vendor.BusinessNature"
                        ng-options="bn as bn.BusinessNatureName for bn in BusinessNatureList track by bn.BusinessNatureID">
                    <option value="">-- Select Business Nature --</option>
                </select>
            </div>
        </div>

        <div class="row form-row-item">
            <div class="col-lg-2 col-md-3 field-label">Country</div>
            <div class="col-lg-4 col-md-5">
                <select class="form-control"
                        ng-model="PurreqDtl.Vendor.Country"
                        ng-options="c as c.CountryName for c in CountryList track by c.CountryID">
                    <option value="">-- Select Country --</option>
                </select>
            </div>
        </div>

        <div class="row form-row-item">
            <div class="col-lg-2 col-md-3 field-label">Company Address</div>
            <div class="col-lg-6 col-md-7">
                <input id="CompanyAddress" autocomplete="off" type="text" name="CompanyAddress"
                       class="form-control" ng-model="PurreqDtl.Vendor.CompanyAddress" />
            </div>
        </div>

        <div class="row form-row-item">
            <div class="col-lg-2 col-md-3 field-label">Established Year</div>
            <div class="col-lg-4 col-md-5">
                <input id="EstablishedYear" name="EstablishedYear" readonly type="text"
                       class="DatePicker form-control" placeholder="DD/MM/YYYY"
                       ng-model="PurreqDtl.Vendor.EstablishedYear"
                       style="background-color:#ffffff; text-align:center" />
            </div>
        </div>

        <div class="row form-row-item">
            <div class="col-lg-2 col-md-3 field-label">Services / Goods Details</div>
            <div class="col-lg-6 col-md-7">
                <input id="GeneralDetails" autocomplete="off" type="text" name="GeneralDetails"
                       class="form-control" ng-model="PurreqDtl.Vendor.GenaralDetailsServices" />
            </div>
        </div>

        <div class="row form-row-item">
            <div class="col-lg-2 col-md-3 field-label">Contact Person</div>
            <div class="col-lg-2 col-md-3">
                <input id="FirstName" autocomplete="off" type="text" class="form-control"
                       ng-model="PurreqDtl.Vendor.ContactPersonFirstName" placeholder="First Name" />
            </div>
            <div class="col-lg-2 col-md-3">
                <input id="LastName" autocomplete="off" type="text" class="form-control"
                       ng-model="PurreqDtl.Vendor.ContactPersonLastName" placeholder="Last Name" />
            </div>
        </div>

        <div class="row form-row-item">
            <div class="col-lg-2 col-md-3 field-label">
                Contact Number <span class="req">*</span>
            </div>
            <div class="col-lg-3 col-md-4" style="display:flex; align-items:center;">
                <input type="text" class="form-control" style="flex:1;"
                       ng-model="PurreqDtl.Vendor.VendorPhoneNumber"
                       placeholder="(+880) 00 0000 0000" required />
                <button type="button" ng-if="!AddNumber" ng-click="AddAnotherNumber('add')"
                        class="btn btn-default" style="margin-left:5px;">
                    +
                </button>
            </div>
            <div class="col-lg-3 col-md-4" ng-if="AddNumber" style="display:flex; align-items:center;">
                <input type="text" class="form-control" style="flex:1;"
                       ng-model="PurreqDtl.Vendor.VendorPhoneNumber2"
                       placeholder="(+880) 00 0000 0000" />
                <button type="button" ng-click="AddAnotherNumber('remove')"
                        class="btn btn-default" style="margin-left:5px;">
                    -
                </button>
            </div>
            <span class="field-error" id="errorMessageVendorPhoneNumber">Please input a valid Contact Number.</span>
        </div>

        <!-- ── Documents ── -->
        <div class="row form-row-item">
            <div class="col-lg-2 col-md-3 field-label">TIN</div>
            <div class="col-lg-2 col-md-3">
                <div style="position: relative;">
                    <input id="TIN" type="text" autocomplete="off" name="TIN"
                           class="form-control" ng-model="PurreqDtl.Vendor.TIN"
                           placeholder="Optional" style="padding-right:35px;" />
                    <button  ng-if="!docExistsMap.TIN" ng-click="viewDoc('TIN')"
                            class="btn button-custom"
                            style="position:absolute; right:5px; top:50%; transform:translateY(-50%); padding:5px 10px;">
                        <i class="fa fa-eye"></i>
                    </button>
                </div>
            </div>
            <div class="col-lg-4 col-md-4">
                <div class="file-wrap">
                    <input type="file" id="TINFile" accept=".pdf"
                           onchange="angular.element(this).scope().fileSelected(this,'TIN')" />
                </div>
            </div>
        </div>

        <div class="row form-row-item">
            <div class="col-lg-2 col-md-3 field-label">BIN</div>
            <div class="col-lg-2 col-md-3">
                <div style="position: relative;">
                    <input id="BIN" type="text" autocomplete="off" name="BIN"
                           class="form-control" ng-model="PurreqDtl.Vendor.BIN"
                           placeholder="Optional" style="padding-right:35px;" />
                    <button ng-if="!docExistsMap.BIN" ng-click="viewDoc('BIN')"
                            class="btn button-custom"
                            style="position:absolute; right:5px; top:50%; transform:translateY(-50%); padding:5px 10px;">
                        <i class="fa fa-eye"></i>
                    </button>
                </div>
            </div>
            <div class="col-lg-4 col-md-4">
                <div class="file-wrap">
                    <input type="file" id="BINFile" accept=".pdf"
                           onchange="angular.element(this).scope().fileSelected(this,'BIN')" />
                </div>
            </div>
        </div>

        <div class="row form-row-item">
            <div class="col-lg-2 col-md-3 field-label">Company Profile</div>
            <div class="col-lg-2 col-md-3">
                <div style="position: relative;">
                    <input id="CompanyProfile" type="text" autocomplete="off"
                           class="form-control" ng-model="PurreqDtl.Vendor.CompanyProfile"
                           placeholder="Optional" style="padding-right:35px;" />
                    <button ng-if="!docExistsMap.CompanyProfile" ng-click="viewDoc('CompanyProfile')"
                            class="btn button-custom"
                            style="position:absolute; right:5px; top:50%; transform:translateY(-50%); padding:5px 10px;">
                        <i class="fa fa-eye"></i>
                    </button>
                </div>
            </div>
            <div class="col-lg-4 col-md-4">
                <div class="file-wrap">
                    <input type="file" id="CompanyProfileFile" accept=".pdf"
                           onchange="angular.element(this).scope().fileSelected(this,'CompanyProfile')" />
                </div>
            </div>
        </div>

        <div class="row form-row-item">
            <div class="col-lg-2 col-md-3 field-label">Trade License</div>
            <div class="col-lg-2 col-md-3">
                <div style="position: relative;">
                    <input id="TradeLicense" type="text" autocomplete="off"
                           class="form-control" ng-model="PurreqDtl.Vendor.TradeLicense"
                           placeholder="Optional" style="padding-right:35px;" />
                    <button ng-if="!docExistsMap.TradeLicense" ng-click="viewDoc('TradeLicense')"
                            class="btn button-custom"
                            style="position:absolute; right:5px; top:50%; transform:translateY(-50%); padding:5px 10px;">
                        <i class="fa fa-eye"></i>
                    </button>
                </div>
            </div>
            <div class="col-lg-4 col-md-4">
                <div class="file-wrap">
                    <input type="file" id="TradeLicenseFile" accept=".pdf"
                           onchange="angular.element(this).scope().fileSelected(this,'TradeLicense')" />
                </div>
            </div>
        </div>

        <div class="row form-row-item">
            <div class="col-lg-2 col-md-3 field-label">Trade License Validity</div>
            <div class="col-lg-2 col-md-3">
                <input id="TradeLicenseValidity" name="TradeLicenseValidity" readonly type="text"
                       class="DatePicker form-control" placeholder="DD/MM/YYYY"
                       ng-model="PurreqDtl.Vendor.TradeLicenseValidity"
                       style="background-color:#ffffff; text-align:center" />
            </div>
        </div>

        <div class="row form-row-item">
            <div class="col-lg-2 col-md-3 field-label">Partnership Deed / Agencyship</div>
            <div class="col-lg-2 col-md-3">
                <div style="position: relative;">
                    <input id="PartnershipDeed" type="text" autocomplete="off"
                           class="form-control" ng-model="PurreqDtl.Vendor.PartnershipDeed"
                           placeholder="Optional" style="padding-right:35px;" />
                    <button ng-if="!docExistsMap.PartnershipDeed" ng-click="viewDoc('PartnershipDeed')"
                            class="btn button-custom"
                            style="position:absolute; right:5px; top:50%; transform:translateY(-50%); padding:5px 10px;">
                        <i class="fa fa-eye"></i>
                    </button>
                </div>
            </div>
            <div class="col-lg-4 col-md-4">
                <div class="file-wrap">
                    <input type="file" id="PartnershipDeedFile" accept=".pdf"
                           onchange="angular.element(this).scope().fileSelected(this,'PartnershipDeed')" />
                </div>
            </div>
        </div>

        <div class="row form-row-item">
            <div class="col-lg-2 col-md-3 field-label">Import Registration Certificate</div>
            <div class="col-lg-2 col-md-3">
                <div style="position: relative;">
                    <input id="ImportRegistration" type="text" autocomplete="off"
                           class="form-control" ng-model="PurreqDtl.Vendor.ImportRegistration"
                           placeholder="Optional" style="padding-right:35px;" />
                    <button ng-if="!docExistsMap.ImportRegistration" ng-click="viewDoc('ImportRegistration')"
                            class="btn button-custom"
                            style="position:absolute; right:5px; top:50%; transform:translateY(-50%); padding:5px 10px;">
                        <i class="fa fa-eye"></i>
                    </button>
                </div>
            </div>
            <div class="col-lg-4 col-md-4">
                <div class="file-wrap">
                    <input type="file" id="ImportRegistrationFile" accept=".pdf"
                           onchange="angular.element(this).scope().fileSelected(this,'ImportRegistration')" />
                </div>
            </div>
        </div>

        <div class="row form-row-item">
            <div class="col-lg-2 col-md-3 field-label">Indenting License</div>
            <div class="col-lg-2 col-md-3">
                <div style="position: relative;">
                    <input id="IndentingLicense" type="text" autocomplete="off"
                           class="form-control" ng-model="PurreqDtl.Vendor.IndentingLicense"
                           placeholder="Optional" style="padding-right:35px;" />
                    <button ng-if="!docExistsMap.IndentingLicense" ng-click="viewDoc('IndentingLicense')"
                            class="btn button-custom"
                            style="position:absolute; right:5px; top:50%; transform:translateY(-50%); padding:5px 10px;">
                        <i class="fa fa-eye"></i>
                    </button>
                </div>
            </div>
            <div class="col-lg-4 col-md-4">
                <div class="file-wrap">
                    <input type="file" id="IndentingLicenseFile" accept=".pdf"
                           onchange="angular.element(this).scope().fileSelected(this,'IndentingLicense')" />
                </div>
            </div>
        </div>

        <div class="row form-row-item">
            <div class="col-lg-2 col-md-3 field-label">Others</div>
            <div class="col-lg-2 col-md-3">
                <div style="position: relative;">
                    <input id="Others" type="text" autocomplete="off"
                           class="form-control" ng-model="PurreqDtl.Vendor.Others"
                           placeholder="Optional" style="padding-right:35px;" />
                    <button ng-if="!docExistsMap.Others" ng-click="viewDoc('Others')"
                            class="btn button-custom"
                            style="position:absolute; right:5px; top:50%; transform:translateY(-50%); padding:5px 10px;">
                        <i class="fa fa-eye"></i>
                    </button>
                </div>
            </div>
            <div class="col-lg-4 col-md-4">
                <div class="file-wrap">
                    <input type="file" id="OthersFile" accept=".pdf"
                           onchange="angular.element(this).scope().fileSelected(this,'Others')" />
                </div>
            </div>
        </div>

        <!-- ── Submit ── -->
        <div class="btn-submit-row">
            <button id="btnSaveMasterUpdate" type="button" class="btn btn-success"
                    title="Update" ng-click="updateRegistration()" ng-disabled="loading">
                <i class="fa fa-save"></i>&nbsp; Update Registration
            </button>
        </div>
    </div><!-- /reg-card -->
    @* ==================== PDF VIEWER MODAL ==================== *@
    <div id="ShowPDFModal" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-fullscreen modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header" style="padding: 5px 10px;">
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                    <h4 class="modal-title">Document Viewer</h4>
                </div>
                <div class="modal-body" style="padding: 0; margin: 0;">
                    <iframe id="pdfViewer" style="width: 100%; height: 100vh; border: none;" title="PDF Viewer"></iframe>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Loading overlay ── -->
    <div id="mydiv" ng-show="loading">
        <div class="overlay">
            <i class="fa fa-refresh fa-spin"></i> Loading...
        </div>
    </div>

</div>

<script type="text/javascript">
    app.controller('VendorRegistrationUpdateCtrl', function ($scope, $http, $q) {

        $scope.itemsByPage = 8;
        $scope.fromMenu = 1;
        $scope.showAssignmentArea = false;

        $('.DatePicker').datepicker({
            format: "dd/mm/yyyy",
            autoclose: true
        });

        $('.DatePicker').on('changeDate', function (ev) {
            $('.datepicker').hide();
        });

        //------------- Model ----------------//

        $scope.PurreqDtl = {
            Vendor: {
                BusinessName: "",
                ContactPerson: "",
                ContactPersonFirstName: "",
                ContactPersonLastName: "",
                Email: "",
                VendorPhoneNumber: "",
                VendorPhoneNumber2: "",
                TIN: "",
                BIN: "",
                CompanyAddress: "",
                GenaralDetailsServices: "",
                UserName: "",
                Password: "",
                ConfirmPassword: "",
                VendorId: "",
                TinBinDocId: "",
                CompanyProfile: "",
                TradeLicense: "",
                PartnershipDeed: "",
                ImportRegistration: "",
                IndentingLicense: "",
                Others: "",
                Country: { CountryID: "", CountryCode: "", CountryName: "" },
                BusinessType: { BusinessTypeID: "", BusinessTypeName: "" },
                BusinessNature: { BusinessNatureID: "", BusinessNatureName: "" },
                EstablishedYear: "",
                TradeLicenseValidity: ""
            }
        };

        $scope.AddNumber = false;

        $scope.AddAnotherNumber = function (action) {
            if (action === 'add') {
                $scope.AddNumber = true;
            } else if (action === 'remove') {
                $scope.AddNumber = false;
                $scope.PurreqDtl.Vendor.VendorPhoneNumber2 = '';
            }
        };

        //------------- File upload state ----------------//

        $scope.tinFile = null;
        $scope.binFile = null;
        $scope.companyProfileFile = null;
        $scope.tradeLicenseFile = null;
        $scope.partnershipDeedFile = null;
        $scope.importRegistrationFile = null;
        $scope.indentingLicenseFile = null;
        $scope.othersFile = null;

        $scope.fileSelected = function (input, type) {
            if (input.files && input.files[0]) {
                if (type === 'TIN') {
                    $scope.tinFile = input.files[0];
                } else if (type === 'BIN') {
                    $scope.binFile = input.files[0];
                } else if (type === 'CompanyProfile') {
                    $scope.companyProfileFile = input.files[0];
                } else if (type === 'TradeLicense') {
                    $scope.tradeLicenseFile = input.files[0];
                } else if (type === 'PartnershipDeed') {
                    $scope.partnershipDeedFile = input.files[0];
                } else if (type === 'ImportRegistration') {
                    $scope.importRegistrationFile = input.files[0];
                } else if (type === 'IndentingLicense') {
                    $scope.indentingLicenseFile = input.files[0];
                } else if (type === 'Others') {
                    $scope.othersFile = input.files[0];
                }
            }
        };

        //------------- Document key map ----------------//

        var docKeyMap = {
            'TIN': 'TIN',
            'BIN': 'BIN',
            'Company Profile': 'CompanyProfile',
            'CompanyProfile': 'CompanyProfile',
            'Trade License': 'TradeLicense',
            'TradeLicense': 'TradeLicense',
            'Partnership Deed / Agencyship': 'PartnershipDeed',
            'PartnershipDeed': 'PartnershipDeed',
            'Import Registration Certificate': 'ImportRegistration',
            'ImportRegistration': 'ImportRegistration',
            'IRC': 'ImportRegistration',
            'Indenting License': 'IndentingLicense',
            'IndentingLicense': 'IndentingLicense',
            'Others': 'Others'
        };

        //------------- Existing document lookups ----------------//

        $scope.docExistsMap = {};
        $scope.docPropertyIDMap = {};
        $scope.scannedDocuments = [];

        $scope.setDocProperties = function (obj) {
            $scope.docExistsMap = {};
            $scope.docPropertyIDMap = {};

            (obj || []).forEach(function (element) {
                var key = docKeyMap[element.DocPropertyName] || element.DocPropertyName;

                if (element.Exist) {
                    $scope.docExistsMap[key] = true;
                }

                // Always store DocPropertyID regardless of Exist flag
                if (element.DocPropertyID) {
                    $scope.docPropertyIDMap[key] = element.DocPropertyID;
                }
            });
        };

        // Opens the already-uploaded document for the given field key
        $scope.viewDoc = function (type) {

            var doc = ($scope.scannedDocuments || []).find(function (d) {
                var key = docKeyMap[d.DocPropertyName] || d.DocPropertyName;
                return key === type;
            });

            if (!doc) {
                toastr.error("No document found to view.");
                return;
            }

            $scope.loading = true;

            var requestUrl = "/VendorSelectionModule/VendorRegistrationUpdate/ViewDocument?" +
                "serverIP=" + encodeURIComponent(doc.ServerIP) +
                "&ftpPort=" + encodeURIComponent(doc.FtpPort || doc.ServerPort) +
                "&ftpUserName=" + encodeURIComponent(doc.FtpUserName) +
                "&ftpPassword=" + encodeURIComponent(doc.FtpPassword) +
                "&fileServerURL=" + encodeURIComponent(doc.FileServerURL) +
                "&vendorId=" + encodeURIComponent($scope.VendorID) +
                "&ext=" + encodeURIComponent("pdf");

            $http.get(requestUrl, { responseType: 'arraybuffer' })
                .then(function (response) {
                    var file = new Blob([response.data], { type: 'application/pdf' });
                    var fileURL = URL.createObjectURL(file);
                    $("#pdfViewer").attr("src", fileURL + "#view=Fit");
                    $('#ShowPDFModal').modal('show');
                })
                .catch(function (error) {
                    toastr.warning("No document has been uploaded yet.");
                    console.error(error);
                })
                .finally(function () {
                    $scope.loading = false;
                });
        };

        //------------- Lookup lists ----------------//

        $scope.BusinessTypeList = [];
        $scope.BusinessNatureList = [];
        $scope.CountryList = [];

        function loadLists() {
            return $q.all([
                $http.get('/VendorSelectionModule/VendorRegistration/GetBusinessTypeList'),
                $http.get('/VendorSelectionModule/VendorRegistration/GetBusinessNatureList'),
                $http.get('/VendorSelectionModule/VendorRegistration/GetCountryList')
            ]).then(function (res) {
                $scope.BusinessTypeList = res[0].data;
                $scope.BusinessNatureList = res[1].data;
                $scope.CountryList = res[2].data;
            });
        }

        //------------- Initial load ----------------//

        $scope.loading = true;

        $http.post('/VendorSelectionModule/VendorRegistrationUpdate/GetVendorInformation')
            .then(function (response) {

                $scope.IndvVendorData = response.data.IndvVendorData;
                $scope.VendorID = $scope.IndvVendorData[0].VendorID;
                $scope.PurreqDtl.Vendor.TinBinDocId = $scope.IndvVendorData[0].TinBinDocId || "";

                var vendor = $scope.IndvVendorData[0];

                return loadLists().then(function () {
                    return vendor;
                });

            })
            .then(function (vendor) {

                $scope.PurreqDtl.Vendor.BusinessName = vendor.BusinessName || "";
                $scope.PurreqDtl.Vendor.CompanyAddress = vendor.CompanyAddress || "";
                $scope.PurreqDtl.Vendor.ContactPerson = vendor.ContactPerson || "";
                $scope.PurreqDtl.Vendor.VendorId = vendor.VendorID || "";
                $scope.PurreqDtl.Vendor.TinBinDocId = vendor.TinBinDocId || "";

                if (vendor.ContactPerson) {
                    var nameParts = vendor.ContactPerson.split(' ');
                    $scope.PurreqDtl.Vendor.ContactPersonFirstName = nameParts[0] || "";
                    $scope.PurreqDtl.Vendor.ContactPersonLastName = nameParts.slice(1).join(' ') || "";
                } else {
                    $scope.PurreqDtl.Vendor.ContactPersonFirstName = "";
                    $scope.PurreqDtl.Vendor.ContactPersonLastName = "";
                }

                $scope.PurreqDtl.Vendor.VendorPhoneNumber = vendor.VendorPhoneNumber || "";
                $scope.PurreqDtl.Vendor.VendorPhoneNumber2 = vendor.VendorPhoneNumber2 || "";
                $scope.AddNumber = !!$scope.PurreqDtl.Vendor.VendorPhoneNumber2;

                $scope.PurreqDtl.Vendor.GenaralDetailsServices = vendor.GenaralDetailsServices || "";
                $scope.PurreqDtl.Vendor.Email = vendor.VendorEmail || "";
                $scope.PurreqDtl.Vendor.TIN = vendor.TIN || "";
                $scope.PurreqDtl.Vendor.BIN = vendor.BIN || "";
                $scope.PurreqDtl.Vendor.CompanyProfile = vendor.CompanyProfile || "";
                $scope.PurreqDtl.Vendor.TradeLicense = vendor.TradeLicense || "";
                $scope.PurreqDtl.Vendor.PartnershipDeed = vendor.PartnershipDeed || "";
                $scope.PurreqDtl.Vendor.ImportRegistration = vendor.IRC || "";
                $scope.PurreqDtl.Vendor.IndentingLicense = vendor.IndentingLicense || "";
                $scope.PurreqDtl.Vendor.Others = vendor.Others || "";
                $scope.PurreqDtl.Vendor.UserName = "";
                $scope.PurreqDtl.Vendor.Password = "";
                $scope.PurreqDtl.Vendor.ConfirmPassword = "";
                $scope.PurreqDtl.Vendor.EstablishedYear = vendor.EstablishedYear;
                $scope.PurreqDtl.Vendor.TradeLicenseValidity = vendor.TradeLicenseValidity;

                if (vendor.Country) {
                    var countryObj = $scope.CountryList.find(function (i) {
                        return i.CountryID == vendor.Country;
                    });
                    $scope.PurreqDtl.Vendor.Country = countryObj || vendor.Country;
                }

                if (vendor.BusinessType) {
                    var businessTypeObj = $scope.BusinessTypeList.find(function (i) {
                        return i.BusinessTypeID == vendor.BusinessType ||
                            i.BusinessTypeName == vendor.BusinessType;
                    });
                    $scope.PurreqDtl.Vendor.BusinessType = businessTypeObj || vendor.BusinessType;
                }

                if (vendor.BusinessNature) {
                    var businessNatureObj = $scope.BusinessNatureList.find(function (i) {
                        return i.BusinessNatureID == vendor.BusinessNature ||
                            i.BusinessNatureName == vendor.BusinessNature;
                    });
                    $scope.PurreqDtl.Vendor.BusinessNature = businessNatureObj || vendor.BusinessNature;
                }

                return $http.get("/VendorSelectionModule/VendorRegistrationUpdate/GetDocsForFurtherDoc", {
                    params: { "TinBinDocId": $scope.PurreqDtl.Vendor.TinBinDocId }
                });

            })
            .then(function (response) {
                $scope.setDocProperties(response.data.docProperties);
                $scope.scannedDocuments = response.data.documents || [];
                $scope.loading = false;
            })
            .catch(function () {
                $scope.loading = false;
                toastr.error('Data Loading Failed.');
            });

        //------------- Save ----------------//
        $scope.updateRegistration = function () {

            var estYearVal = $('#EstablishedYear').val();
            $scope.PurreqDtl.Vendor.EstablishedYear = estYearVal
                ? $scope.formatDate(estYearVal) : "";

            var tradeVal = $('#TradeLicenseValidity').val();
            $scope.PurreqDtl.Vendor.TradeLicenseValidity = tradeVal
                ? $scope.formatDate(tradeVal) : "";


            //------------- Document Validation ----------------//
            var documentValidation = [
                { file: $scope.tinFile, value: $scope.PurreqDtl.Vendor.TIN, name: 'TIN' },
                { file: $scope.binFile, value: $scope.PurreqDtl.Vendor.BIN, name: 'BIN' },
                { file: $scope.companyProfileFile, value: $scope.PurreqDtl.Vendor.CompanyProfile, name: 'Company Profile' },
                { file: $scope.tradeLicenseFile, value: $scope.PurreqDtl.Vendor.TradeLicense, name: 'Trade License' },
                { file: $scope.partnershipDeedFile, value: $scope.PurreqDtl.Vendor.PartnershipDeed, name: 'Partnership Deed / Agencyship' },
                { file: $scope.importRegistrationFile, value: $scope.PurreqDtl.Vendor.ImportRegistration, name: 'Import Registration Certificate' },
                { file: $scope.indentingLicenseFile, value: $scope.PurreqDtl.Vendor.IndentingLicense, name: 'Indenting License' },
                { file: $scope.othersFile, value: $scope.PurreqDtl.Vendor.Others, name: 'Others' }
            ];

            for (var i = 0; i < documentValidation.length; i++) {
                if (documentValidation[i].file &&
                    (!documentValidation[i].value || !documentValidation[i].value.trim())) {

                    toastr.error(
                        'Please enter the ' + documentValidation[i].name +
                        ' number/details before uploading the document.'
                    );
                    return;
                }
            }

            $scope.loading = true;

            $http.post('/VendorSelectionModule/VendorRegistration/VendorupdateRegistrationDetails', {
                BusinessName: $scope.PurreqDtl.Vendor.BusinessName,
                ContactPersonFirstName: $scope.PurreqDtl.Vendor.ContactPersonFirstName,
                ContactPersonLastName: $scope.PurreqDtl.Vendor.ContactPersonLastName,
                VendorPhoneNumber: $scope.PurreqDtl.Vendor.VendorPhoneNumber,
                VendorPhoneNumber2: $scope.PurreqDtl.Vendor.VendorPhoneNumber2,
                CompanyAddress: $scope.PurreqDtl.Vendor.CompanyAddress,
                Country: $scope.PurreqDtl.Vendor.Country.CountryID,
                BusinessType: $scope.PurreqDtl.Vendor.BusinessType.BusinessTypeName,
                BusinessNature: $scope.PurreqDtl.Vendor.BusinessNature.BusinessNatureName,
                TIN: $scope.PurreqDtl.Vendor.TIN,
                BIN: $scope.PurreqDtl.Vendor.BIN,
                GeneralDetailsServices: $scope.PurreqDtl.Vendor.GenaralDetailsServices,
                Status: 'Temporary',
                Vendor: $scope.PurreqDtl.Vendor.VendorId,
                companyProfile: $scope.PurreqDtl.Vendor.CompanyProfile,
                tradeLicense: $scope.PurreqDtl.Vendor.TradeLicense,
                partnershipDeed: $scope.PurreqDtl.Vendor.PartnershipDeed,
                irc: $scope.PurreqDtl.Vendor.ImportRegistration,
                indentingLicense: $scope.PurreqDtl.Vendor.IndentingLicense,
                others: $scope.PurreqDtl.Vendor.Others,
                EstablishedYear: $scope.PurreqDtl.Vendor.EstablishedYear,
                TradeLicenseValidity: $scope.PurreqDtl.Vendor.TradeLicenseValidity,
                UserName: "",
                Password: ""
            })
                .then(function (response) {

                    if (!response.data.user || !response.data.user.UserID) {
                        toastr.error("Vendor update failed");
                        $scope.loading = false;
                        return;
                    }

                    var uploads = [];

                    // ── Get FTP credentials from any existing scanned document
                    //    (all docs share the same FTP server, so any entry works)
                    var docInfo = ($scope.scannedDocuments && $scope.scannedDocuments.length > 0)
                        ? $scope.scannedDocuments[0]
                        : null;

                    if (!docInfo) {
                        toastr.error("FTP server info not available. Cannot upload documents.");
                        $scope.loading = false;
                        return;
                    }

                    function uploadFile(file, docType) {
                        var fileData = new FormData();
                        fileData.append('serverIP', docInfo.ServerIP);
                        fileData.append('ftpPort', docInfo.FtpPort || docInfo.ServerPort);
                        fileData.append('ftpUserName', docInfo.FtpUserName);
                        fileData.append('ftpPassword', docInfo.FtpPassword);
                        fileData.append('vendorId', $scope.PurreqDtl.Vendor.VendorId);
                        fileData.append('docType', docType);
                        fileData.append('file', file);

                        return $http.post(
                            '/VendorSelectionModule/VendorRegistration/UploadOtherFiles',
                            fileData,
                            {
                                transformRequest: angular.identity,
                                headers: { 'Content-Type': undefined }
                            }
                        );
                    }

                    if ($scope.tinFile) uploads.push(uploadFile($scope.tinFile, 'TIN'));
                    if ($scope.binFile) uploads.push(uploadFile($scope.binFile, 'BIN'));
                    if ($scope.companyProfileFile) uploads.push(uploadFile($scope.companyProfileFile, 'CompanyProfile'));
                    if ($scope.tradeLicenseFile) uploads.push(uploadFile($scope.tradeLicenseFile, 'TradeLicense'));
                    if ($scope.partnershipDeedFile) uploads.push(uploadFile($scope.partnershipDeedFile, 'PartnershipDeed'));
                    if ($scope.importRegistrationFile) uploads.push(uploadFile($scope.importRegistrationFile, 'ImportRegistration'));
                    if ($scope.indentingLicenseFile) uploads.push(uploadFile($scope.indentingLicenseFile, 'IndentingLicense'));
                    if ($scope.othersFile) uploads.push(uploadFile($scope.othersFile, 'Others'));

                    if (uploads.length === 0) {
                        toastr.success('Data Updated Successfully');
                        $scope.loading = false;
                        $scope.refreshPage();
                        return;
                    }

                    Promise.all(uploads)
                        .then(function () {
                            toastr.success('Data updated and documents uploaded successfully');
                        })
                        .catch(function () {
                            toastr.warning('Data updated but some documents failed to upload');
                        })
                        .finally(function () {
                            $scope.loading = false;
                            $scope.refreshPage();
                        });
                })
                .catch(function () {
                    toastr.error("Data Save Failed");
                    $scope.loading = false;
                });
        };

        //--------------utilities----------------//

        $scope.formatDate = function (date) {
            var res = date.split("/");
            return res[1] + "/" + res[0] + "/" + res[2];
        };

        $scope.refreshPage = function () {
            setTimeout(function () {
                window.location = "/VendorSelectionModule/VendorDashboard/";
            }, 2000);
        };

        $scope.toggleRefreshTable = function (row) {
            location.reload();
        };

    });
</script>
