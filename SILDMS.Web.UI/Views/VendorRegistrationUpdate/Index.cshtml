                   type="text"
                   class="DatePicker form-control"
                   placeholder="DD/MM/YYYY"
                   ng-model="PurreqDtl.Vendor.EstablishedYear"
                   style="background-color:#ffffff; text-align:center; font-size: smaller;" />
        </div>
    </div>


    <div class="row" style="margin-top: 5px;">
