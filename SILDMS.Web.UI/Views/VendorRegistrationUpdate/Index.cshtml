        $scope.updateRegistration = function () {

            var estYearVal = $('#EstablishedYear').val();
            $scope.PurreqDtl.Vendor.EstablishedYear = estYearVal
                ? $scope.formatDate(estYearVal)
                : "";

            var tradeVal = $('#TradeLicenseValidity').val();
            $scope.PurreqDtl.Vendor.TradeLicenseValidity = tradeVal
                ? $scope.formatDate(tradeVal)
                : "";


            //$scope.PurreqDtl.Vendor.EstablishedYear = $scope.formatDate($('#EstablishedYear').val());
            //$scope.PurreqDtl.Vendor.TradeLicenseValidity = $scope.formatDate($('#TradeLicenseValidity').val());




            $http.post('/VendorSelectionModule/VendorRegistration/VendorupdateRegistrationDetails', {
                BusinessName: $scope.PurreqDtl.Vendor.BusinessName,
                ContactPersonFirstName: $scope.PurreqDtl.Vendor.ContactPersonFirstName,
                ContactPersonLastName: $scope.PurreqDtl.Vendor.ContactPersonLastName,
                VendorPhoneNumber: $scope.PurreqDtl.Vendor.VendorPhoneNumber,
                VendorPhoneNumber2: $scope.PurreqDtl.Vendor.VendorPhoneNumber2,
                CompanyAddress: $scope.PurreqDtl.Vendor.CompanyAddress,

                Country: $scope.PurreqDtl.Vendor.Country.CountryID,
                BusinessType: $scope.PurreqDtl.Vendor.BusinessType.BusinessTypeName,

                TIN: $scope.PurreqDtl.Vendor.TIN,
                BIN: $scope.PurreqDtl.Vendor.BIN, 
                GeneralDetailsServices: $scope.PurreqDtl.Vendor.GenaralDetailsServices,
                Status: 'Temporary',
                Vendor: $scope.PurreqDtl.Vendor.VendorId,
                companyProfile: $scope.PurreqDtl.Vendor.CompanyProfile,
                tradeLicense: $scope.PurreqDtl.Vendor.TradeLicense,
                partnershipDeed: $scope.PurreqDtl.Vendor.PartnershipDeed,
                irc: $scope.PurreqDtl.Vendor.ImportRegistration,
                indentingLicense: $scope.PurreqDtl.Vendor.IndentingLicense,
                others: $scope.PurreqDtl.Vendor.Others,
     
               
                BusinessNature: $scope.PurreqDtl.Vendor.BusinessNature.BusinessNatureName,
                EstablishedYear: $scope.PurreqDtl.Vendor.EstablishedYear,
                TradeLicenseValidity: $scope.PurreqDtl.Vendor.TradeLicenseValidity,

               
                UserName: "",
                Password: "",
               


            })
                .success(function (response) {
                    if (response.user.UserID != "") {
                        toastr.success('Data Updated Successfully');
                        $scope.refreshPage();
                    }

                   
                })
                .catch(function () {
                    toastr.error("Data Save Failed");
                    $scope.loading = false;
                });
        } 






        //--------------utilities



        $scope.formatDate = function (date) {

            var res = date.split("/");
            return res[1] + "/" + res[0] + "/" + res[2];

        };

        $scope.refreshPage = function () {
            setTimeout(function () {
                window.location = "/VendorSelectionModule/VendorDashboard/";// Reload the current page
            }, 2000); // 2000 milliseconds = 3 seconds
        }





