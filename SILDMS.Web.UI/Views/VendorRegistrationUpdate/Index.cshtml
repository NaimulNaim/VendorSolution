<script src="~/Scripts/jquery-barcode.min.js"></script>
@{
    ViewBag.Title = "Temporary";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}


<div class="box box-primary box-body" ng-controller="VendorRegistrationUpdateCtrl">
    @* Header *@
    <div class="box-header with-border" style="font-family: Verdana; background: #E4E9E3; color: black; ">
        <i class="fa fa-user"></i>
        <h3 style="font-family: Verdana" class="box-title" ng-if="fromMenu">Update Vendor Registration</h3>
        @*<h3 style="font-family: Verdana" class="box-title" ng-if="!fromMenu">Temporary Vendor Registration From</h3>*@
        <div class="box-tools pull-right">
            <button type="button" id="btnRefresh" data-ng-click="toggleRefreshTable(row)" class="btn btn-warning btn-flat pull-right" ng-disabled="loading"><i class="fa fa-refresh"></i> Refresh</button>
            <button type="button" id="btnRefresh" data-ng-click="updateRegistration()" class="btn btn-danger" ng-disabled="loading"><i class="fa fa-edit"></i> Update</button>
        </div>
    </div>





    <div class="row" style="margin-top: 5px;">
        <div class="col-lg-2">
            <div class="form-group" style="font-size: smaller;">
                <label for="BusinessName">Business Name :<span style="color: red;"> *</span></label>
            </div>
        </div>
        <div class="col-lg-4">
            <input id="BusinessName" autocomplete="off" type="text" name="BusinessName" class="form-control" ng-model="PurreqDtl.Vendor.BusinessName" placeholder="" style="font-size: smaller; padding: 3px 6px 3px;" required />
        </div>
        <div class="col-md-3">
            <span class="center-block text-red" id="errorMessageBusinessName" style="display: none;">Please input valid Business Name.</span>
        </div>


    </div>

    <div class="row" style="margin-top: 5px;">

        <div class="col-lg-2 col-md-2 col-sm-2" style="font-size: smaller;">
            <label for="ContactPerson">Contact Person :</label>
        </div>
        <div class="col-lg-2 col-md-2 col-sm-2">
            <input id="FirstName" autocomplete="off" type="text" name="FirstName" class="form-control" ng-model="PurreqDtl.Vendor.ContactPersonFirstName" placeholder="First Name" style="font-size: smaller; padding: 3px 6px 3px;" required />
        </div>
        <div class="col-lg-2 col-md-2 col-sm-2">
            <input id="LastName" autocomplete="off" type="text" name="LastName" class="form-control" ng-model="PurreqDtl.Vendor.ContactPersonLastName" placeholder="Last Name" style="font-size: smaller; padding: 3px 6px 3px;" required />
        </div>
        <div class="col-md-3">
            <span class="center-block text-red" id="errorMessageContactPerson" style="display: none;">Please input valid ContactPerson.</span>
        </div>
    </div>

    <div class="row" style="margin-top: 5px;">
        <div class="col-lg-2" style="font-size: smaller;">
            <label for="VendorPhoneNumber">Contact Number :<span style="color: red;"> *</span></label>
        </div>

        <!-- First number with + button -->
        <div class="col-lg-2" style="display: flex; align-items: center;">
            <input type="text" class="form-control"
                   ng-model="PurreqDtl.Vendor.VendorPhoneNumber"
                   placeholder="" style="flex:1;" required />
            <button type="button" ng-if="!AddNumber"
                    ng-click="AddAnotherNumber('add')"
                    class="btn btn-default" style="margin-left: 5px;">
                +
            </button>
        </div>

        <!-- Second number with - button -->
        <div class="col-lg-2" ng-if="AddNumber" style="display: flex; align-items: center;">
            <input type="text" class="form-control"
                   ng-model="PurreqDtl.Vendor.VendorPhoneNumber2"
                   placeholder="" style="flex:1;" required />
            <button type="button" ng-click="AddAnotherNumber('remove')"
                    class="btn btn-default" style="margin-left: 5px;">
                -
            </button>
        </div>
    </div>





    <div class="row" style="margin-top: 5px;">
        <div class="col-lg-2" style="font-size: smaller;">
            <label for="TIN">TIN :</label>
        </div>
        <div class="col-lg-4">
            <input id="TIN" type="text" autocomplete="off" name="TIN" class="form-control" ng-model="PurreqDtl.Vendor.TIN" placeholder="" style="font-size: smaller; padding: 3px 6px 3px;" />
        </div>
        <div class="col-md-3">
            <span class="center-block text-red" id="errorMessageTIN" style="display: none;">Please input valid TIN</span>
        </div>
    </div>

    <div class="row" style="margin-top: 5px;">
        <div class="col-lg-2" style="font-size: smaller;">
            <label for="BIN">BIN :</label>
        </div>
        <div class="col-lg-4">
            <input id="BIN" autocomplete="off" type="text" name="BIN" class="form-control" ng-model="PurreqDtl.Vendor.BIN" placeholder="" style="font-size: smaller; padding: 3px 6px 3px;" />
        </div>
        <div class="col-md-3">
            <span class="center-block text-red" id="errorMessageBIN" style="display: none;">Please input valid BIN</span>
        </div>
    </div>
    <div class="row" style="margin-top: 5px;">
        <div class="col-lg-2" style="font-size: smaller;">
            <label for="CompanyProfile">Company Profile :</label>
        </div>
        <div class="col-lg-4">
            <input id="CompanyProfile" type="text" autocomplete="off" class="form-control"
                   ng-model="PurreqDtl.Vendor.CompanyProfile" placeholder=""
                   style="font-size: smaller; padding: 3px 6px 3px;" />
        </div>
    </div>

    <!-- Trade License -->
    <div class="row" style="margin-top: 5px;">
        <div class="col-lg-2" style="font-size: smaller;">
            <label for="TradeLicense">Trade License :</label>
        </div>
        <div class="col-lg-4">
            <input id="TradeLicense" type="text" autocomplete="off" class="form-control"
                   ng-model="PurreqDtl.Vendor.TradeLicense" placeholder=""
                   style="font-size: smaller; padding: 3px 6px 3px;" />
        </div>
    </div>

    <!-- Partnership Deed / Agencyship -->
    <div class="row" style="margin-top: 5px;">
        <div class="col-lg-2" style="font-size: smaller;">
            <label for="PartnershipDeed">Partnership Deed / Agencyship :</label>
        </div>
        <div class="col-lg-4">
            <input id="PartnershipDeed" type="text" autocomplete="off" class="form-control"
                   ng-model="PurreqDtl.Vendor.PartnershipDeed" placeholder=""
                   style="font-size: smaller; padding: 3px 6px 3px;" />
        </div>
    </div>

    <!-- Import Registration Certificate (IRC) -->
    <div class="row" style="margin-top: 5px;">
        <div class="col-lg-2" style="font-size: smaller;">
            <label for="ImportRegistration">Import Registration Certificate :</label>
        </div>
        <div class="col-lg-4">
            <input id="ImportRegistration" type="text" autocomplete="off" class="form-control"
                   ng-model="PurreqDtl.Vendor.ImportRegistration" placeholder=""
                   style="font-size: smaller; padding: 3px 6px 3px;" />
        </div>
    </div>

    <!-- Indenting License -->
    <div class="row" style="margin-top: 5px;">
        <div class="col-lg-2" style="font-size: smaller;">
            <label for="IndentingLicense">Indenting License :</label>
        </div>
        <div class="col-lg-4">
            <input id="IndentingLicense" type="text" autocomplete="off" class="form-control"
                   ng-model="PurreqDtl.Vendor.IndentingLicense" placeholder=""
                   style="font-size: smaller; padding: 3px 6px 3px;" />
        </div>
    </div>

    <div class="row" style="margin-top: 5px;">
        <div class="col-lg-2" style="font-size: smaller;">
            <label for="Others">Others :</label>
        </div>
        <div class="col-lg-4">
            <input id="Others" type="text" autocomplete="off" class="form-control"
                   ng-model="PurreqDtl.Vendor.Others" placeholder=""
                   style="font-size: smaller; padding: 3px 6px 3px;" />
        </div>
    </div>


    <div class="row" style="margin-top: 5px;">
        <div class="col-lg-2" style="font-size: smaller;">
            <label for="GeneralDetails">Details of Services/ Goods :</label>
        </div>
        <div class="col-lg-4">
            <input id="GeneralDetails" autocomplete="off" type="text" name="GeneralDetails" class="form-control" ng-model="PurreqDtl.Vendor.GenaralDetailsServices" placeholder="" style="font-size: smaller; padding: 3px 6px 3px;" required />
        </div>
    </div>
    <br />

    <div class="row">
        <table st-table="displayScannedDocuments" st-safe-src="scannedDocuments"
               class="table table-condensed table-bordered table-striped table-hover">
            <thead>
                <tr>
                    <th st-sort="DocPropertyName">Document Name</th>
                    <th st-sort="IdentificationAttribute">Identification Attribute</th>
                    <th st-sort="MetaValue">Attribute Value</th>
                    <th st-sort="FileServerURL" class="hidden">FileServerURL</th>
                    <th st-sort="">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="row in displayScannedDocuments">
                    @*<td class="hidden">{{row.DocMetaID}}</td>*@
                    <td class="hidden">{{row.DocumentID}}</td>
                    <td class="col-lg-2">{{row.DocPropertyName}}</td>
                    <td class="col-lg-3">{{row.IdentificationAttribute}}</td>
                    <td class="col-lg-3">{{row.MetaValue}}</td>
                    <td class="hidden">{{row.FileServerURL}}</td>
                    <td class="col-lg-3">
                        @*<button type="button" class="btn btn-xs btn-info btn-flat" data-ng-click="LoadImage(row)" style="display: inline-block;"><i class="fa fa-search-plus"></i> Quick View</button>*@
                        <button type="button" class="btn btn-xs btn-success btn-flat" data-ng-click="getScannedDocs(row)"><i class="fa fa-list"></i> Detail View</button>
                        <button type="button" ng-if="row.DocClassification != 'Required'" class="btn btn-xs btn-primary btn-flat" data-ng-click="showDeleteConfirmModal(row)" style="display: inline-block;"><i class="fa fa-edit"></i> Delete</button>
                        <button type="button" class="btn btn-xs btn-primary btn-flat" data-ng-click="showEditModal(row)" style="display: inline-block;"><i class="fa fa-edit"></i> Edit</button>
                        @*<button type="button" class="btn btn-xs btn-danger btn-flat" data-ng-click="ShowDeleteConfirmModal(row)" style="display: inline-block;"><i class="fa fa-edit"></i> Delete</button>*@
                    </td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="6" class="text-center">
                        <div st-pagination="" st-items-by-page="itemsByPage"></div>
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>

    <br />



    <div id="DetailViewModal" class="modal fade">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" ng-click="" aria-hidden="true">x</button>
                    <h4 class="modal-title">Document Detail View</h4>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-lg-2">
                            <h4><label>Thumbnail:</label></h4>
                        </div>
                        <div class="col-lg-10">
                            <button class="btn btn-flat btn-sm btn-default" data-ng-click="ZoomIn()"> Zoom In</button>
                            <button class="btn btn-flat btn-sm btn-default" data-ng-click="ZoomOut()"> Zoom Out</button>
                            <button class="btn btn-flat btn-sm btn-default" data-ng-click="printData2()">Print</button>
                        </div>

                    </div>
                    <div class="row">
                        <div class="col-lg-2">
                            <div id="dwtVerticalThumbnil" class="box-body"></div>
                        </div>
                        <div class="col-lg-10">
                            <div id="dwtLargeViewer" class="box-body"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="col-sm-12 col-md-12 col-lg-12">
                        <div class="form-group">
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>





    <div id="viewerModal" class="modal fade">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">x</button>
                    <h3 class="modal-title">Image Viewer</h3>
                </div>

                <div class="modal-body">
                    <div class="box-body">
                        <button class="btn btn-flat btn-sm btn-default" data-ng-click="ZoomIn()"> Zoom In</button>
                        <button class="btn btn-flat btn-sm btn-default" data-ng-click="ZoomOut()"> Zoom Out</button>

                        <div id="dwtHorizontalThumbnil" class="box-body"></div>
                    </div>
                </div>

                <div class="modal-footer">
                    <div class="col-sm-12 col-md-12 col-lg-12">
                        <div class="form-group">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>



    <div id="docUpdateModal" class="modal fade">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">x</button>
                    <h3 class="modal-title">Update Document - {{DocumentName}}</h3>
                </div>

                <div class="modal-body">

                    <div class="row">
                        <div class="col-lg-12">
                            <label>Process Documents: </label>

                            <button class="btn btnc1 btn-app btn-flat btnScan" ng-click="AcquireImage_Update();">
                                <i class="fa fa-print"></i> Scan
                            </button>
                            <a class="btn btnc2 btn-app btn-flat btnLoad" ng-click="LoadImage_Update()">
                                <i class="fa fa-inbox"></i> Load PDF
                            </a>

                            <a class="btn btnc3 btn-app btn-flat btnRemove" ng-click="RemoveAllSelectedImages_Update()">
                                <i class="fa fa-remove"></i> Remove
                            </a>
                            <a class="btn btnc2 btn-app btn-flat btnRotate" ng-click="RotateRight_Update()">
                                <i class="fa fa-rotate-right"></i> Rotate
                            </a>

                            <a class="btn btnc2 btn-app btn-flat btnMoveImage" ng-click="ShowMoveImageDiv_Update()">
                                <i class="fa fa-reorder"></i> Move Image
                            </a>
                        </div>
                    </div>
                    <br />
                    <div class="row">
                        <div id="MoveImageUpdate" class="row hidden">
                            <div class="col-lg-2"></div>
                            <div class="col-lg-10">
                                <label>Which Image</label><input type="text" id="WhichImage_Update" />
                                <label>Where</label><input type="text" id="Where_Update" />
                                <button class="btn btn-primary btn-flat btn-sm" ng-click="MoveImage_Update()">Move</button>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-12 col-md-12 col-lg-12">
                            <div id="dwtDocumentUpdate" style="height:200px;"></div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-primary" ng-click="UpdateDocument()" type="button">Update</button>
                </div>
            </div>
        </div>
    </div>

</div>

<script type="text/javascript" src="~/Resources/dynamsoft.webtwain.intellisense.js"></script>
<script type="text/javascript" src="~/Resources/dynamsoft.webtwain.initiate.js"></script>
<script type="text/javascript" src="~/Resources/dynamsoft.webtwain.config.js"></script>
<script type="text/javascript" src="~/Resources/addon/dynamsoft.webtwain.addon.pdf.js"></script>



<script type="text/javascript">

    app.controller('VendorRegistrationUpdateCtrl', function ($scope, $http) {

        $scope.itemsByPage = 8;
        $scope.fromMenu = 1;
        $scope.showAssignmentArea = false;

        $('.DatePicker').datepicker({
            format: "dd/mm/yyyy",
            autoclose: true
        });

        $('.DatePicker')
            .on('changeDate', function (ev) {
                $('.datepicker').hide();
            });

        //------------- Model ----------------//

        $scope.PurreqDtl = {
            Vendor: {
                BusinessName: "",
                ContactPerson: "",
                ContactPersonFirstName: "",
                ContactPersonLastName: "",
                Email: "",
                VendorPhoneNumber: "",
                VendorPhoneNumber2:"",
                TIN: "",
                BIN: "",
                CompanyAddress: "",
                GenaralDetailsServices: "",
                UserName: "",
                Password: "",
                ConfirmPassword: "",
                VendorId: "",
                TinBinDocId: "",
                CompanyProfile: "",
                TradeLicense: "",
                PartnershipDeed: "",
                ImportRegistration: "",
                IndentingLicense: "",
                Others: ""
            }
        }
        $scope.AddNumber = false;

        $scope.AddAnotherNumber = function (action) {
            if (action === 'add') {
                $scope.AddNumber = true;
            } else if (action === 'remove') {
                $scope.AddNumber = false;
                $scope.PurreqDtl.Vendor.VendorPhoneNumber2 = '';
            }
        };


        //#region Twain Code
        var dwObject;
        var dwObject2;
        var dwObjectLargeViewer;
        var zoomFactor = .5;;

        var dwtLargeViewer_single;

        Dynamsoft.WebTwainEnv.CreateDWTObject('dwtLargeViewer_single',
            function (dwtObject) {
                dwtLargeViewer_single = dwtObject;
                dwtLargeViewer_single.SetViewMode(-1, -1);
                dwtLargeViewer_single.MaxImagesInBuffer = 1;
                dwtLargeViewer_single.Width = 9.69 * 90;
                dwtLargeViewer_single.Height = $(window).height();
            },
            function (errorString) {
                alert('WebTwain Loading Error');
            }
        );

        function dynamsoftOnReady() {
            dwObject = Dynamsoft.WebTwainEnv.GetWebTwain("dwtHorizontalThumbnil");
            dwObject2 = Dynamsoft.WebTwainEnv.GetWebTwain("dwtVerticalThumbnil");

            dwObjectLargeViewer = Dynamsoft.WebTwainEnv.GetWebTwain("dwtLargeViewer");

            dwObjectLargeViewer.SetViewMode(-1, -1);
            dwObjectLargeViewer.MaxImagesInBuffer = 1;

            dwObject.SetViewMode(4, -1);
            // DWObject.PDFCompressionType = EnumDWT_PDFCompressionType.PDF_JPEG;
            dwObject.JPEGQuality = 20;
            dwObject.FitWindowType = 0;
            dwObject.SelectionImageBorderColor = 0x691254;
            dwObject.ShowPageNumber = true;
            dwObject.IfAppendImage = true;
            dwObject.RegisterEvent("OnMouseDoubleClick", function () {
                dwObject.CopyToClipboard(dwObject.CurrentImageIndexInBuffer);
                dwtLargeViewer_single.LoadDibFromClipboard();
                $('#viewerModal').modal('show');
            });
            dwObject.RegisterEvent("OnImageAreaSelected", function (sImageIndex, left, top, right, bottom) {
                dwObject.Erase(sImageIndex, left, top, right, bottom);
            });

            dwObject2.SetViewMode(-1, 4);
            //// DWObject.PDFCompressionType = EnumDWT_PDFCompressionType.PDF_JPEG;
            dwObject2.JPEGQuality = 20;
            dwObject2.FitWindowType = 0;
            dwObject2.SelectionImageBorderColor = 0x691254;
            dwObject2.ShowPageNumber = true;
            dwObject2.IfAppendImage = true;
            dwObject2.RegisterEvent("OnMouseClick", function () {
                dwObject2.CopyToClipboard(dwObject2.CurrentImageIndexInBuffer);
                dwObjectLargeViewer.LoadDibFromClipboard();
            });
            dwObject2.RegisterEvent("OnImageAreaSelected", function (sImageIndex, left, top, right, bottom) {
                dwObject2.Erase(sImageIndex, left, top, right, bottom);
            });

            dwObject.Addon.PDF.Download("../Resources/addon/Pdf.zip",  // specify the url of the add-on resource
                function () { console.log('Successfully Downloaded PDF add-on'); }, // successful callback
                function (errorCode, errorString) { alert(errorString); }  // failure callback and show error message
            );
        }


        Dynamsoft.WebTwainEnv.RegisterEvent("OnWebTwainReady", dynamsoftOnReady);


        var DWObjectOFMakeUpdate;
        Dynamsoft.WebTwainEnv.CreateDWTObject('dwtDocumentUpdate',
            function (dwtObject) {
                DWObjectOFMakeUpdate = dwtObject;
                DWObjectOFMakeUpdate.SetViewMode(4, -1);
                DWObjectOFMakeUpdate.PDFCompressionType = EnumDWT_PDFCompressionType.PDF_JPEG;
                DWObjectOFMakeUpdate.JPEGQuality = 20;
                DWObjectOFMakeUpdate.FitWindowType = 0;
                DWObjectOFMakeUpdate.Width = $(window).width() - 235;
                DWObjectOFMakeUpdate.SelectionImageBorderColor = 0x691254;
                DWObjectOFMakeUpdate.ShowPageNumber = true;
                DWObjectOFMakeUpdate.IfAppendImage = true;
                DWObjectOFMakeUpdate.RegisterEvent('OnMouseDoubleClick', function () {
                    DWObjectOFMakeUpdate.CopyToClipboard(DWObjectOFMakeUpdate.CurrentImageIndexInBuffer);
                    dwtLargeViewer_single.LoadDibFromClipboard();
                    $('#viewerModal').modal('show');
                });
                DWObjectOFMakeUpdate.RegisterEvent('OnImageAreaSelected', function (sImageIndex, left, top, right, bottom) {
                    DWObjectOFMakeUpdate.Erase(sImageIndex, left, top, right, bottom);
                });
            },
            function (errorString) {
                alert('WebTwain Loading Error');
            }
        );





        $scope.getImages = function (e) {

            if (dwObject && $scope.clkBtn !== 1) {
                dwObject.IfShowUI = false;
                dwObject.IfAutomaticDeskew = true;
                // DWObject.IfAutoDiscardBlankpages = false;
                dwObject.AcquireImage();
            } else {
                $scope.clkBtn = 0;
            }
        };

        $scope.ZoomIn = function () {
            dwObjectLargeViewer.Zoom = zoomFactor * 1.2;
            zoomFactor = zoomFactor * 1.2;
        };

        $scope.ZoomOut = function () {
            dwObjectLargeViewer.Zoom = zoomFactor / 1.2;
            zoomFactor = zoomFactor / 1.2;
        };

        $scope.RemoveAllSelectedImages = function () {
            dwObject.RemoveAllSelectedImages();
        }

        $scope.LoadImage = function () {

            dwObject.Addon.PDF.SetResolution(200);
            dwObject.Addon.PDF.SetConvertMode(EnumDWT_ConverMode.CM_RENDERALL);

            dwObject.IfShowFileDialog = true;

            dwObject.RemoveAllImages();
            dwObject.LoadImageEx("", EnumDWT_ImageType.IT_PDF, function () { }, function () { });

            $scope.ShowUploadImageDivVar = false;
        };

        $scope.RotateRight = function () {
            dwObject.RotateRight(dwObject.GetSelectedImageIndex(0));
        };

        $scope.ShowMoveImageDiv = function () {
            $("#MoveImage").toggleClass("hidden");
        };

        $scope.MoveImage = function () {
            dwObject.MoveImage(($("#WhichImage").val() - 1), ($("#Where").val() - 1));
            $("#MoveImage").toggleClass("hidden");
        };


        //#region Dynamo_Helper_update
        $scope.AcquireImage_Update = function () {
            if (DWObjectOFMakeUpdate) {
                DWObjectOFMakeUpdate.IfAutomaticDeskew = true;
                DWObjectOFMakeUpdate.IfAutoDiscardBlankpages = false;
                $scope.ShowUploadImageDivVar = false;
                var OnAcquireImageSuccess, OnAcquireImageFailure;
                OnAcquireImageSuccess = OnAcquireImageFailure = function () {
                    DWObjectOFMakeUpdate.CloseSource();
                };

                DWObjectOFMakeUpdate.IfDisableSourceAfterAcquire = true;	// Scanner source will be disabled/closed automatically after the scan.
                DWObjectOFMakeUpdate.AcquireImage(OnAcquireImageSuccess, OnAcquireImageFailure);
            }
        };

        $scope.LoadImage_Update = function () {

            DWObjectOFMakeUpdate.Addon.PDF.SetResolution(200);
            DWObjectOFMakeUpdate.Addon.PDF.SetConvertMode(EnumDWT_ConverMode.CM_RENDERALL);

            DWObjectOFMakeUpdate.IfShowFileDialog = true;

            DWObjectOFMakeUpdate.RemoveAllImages();
            DWObjectOFMakeUpdate.LoadImageEx("", EnumDWT_ImageType.IT_PDF, function () { }, function () { });

            $scope.ShowUploadImageDivVar = false;
        };

        $scope.RemoveAllSelectedImages_Update = function () {
            DWObjectOFMakeUpdate.RemoveAllSelectedImages();
        }

        $scope.RotateRight_Update = function () {
            DWObjectOFMakeUpdate.RotateRight(DWObjectOFMakeUpdate.GetSelectedImageIndex(0));
        }

        $scope.ShowMoveImageDiv_Update = function () {
            $("#MoveImageUpdate").toggleClass("hidden");
            $scope.ShowUploadImageDivVar = false;
        }

        $scope.MoveImage_Update = function () {
            DWObjectOFMakeUpdate.MoveImage(($("#WhichImage_Update").val() - 1), ($("#Where_Update").val() - 1));
            $("#MoveImageUpdate").toggleClass("hidden");
            $scope.ShowUploadImageDivVar = false;
        };



        $http.post('/VendorSelectionModule/VendorRegistrationUpdate/GetVendorInformation')
            .success(function (response) {
                $scope.IndvVendorData = response.IndvVendorData;
                $scope.VendorID = $scope.IndvVendorData[0].VendorID;
                $scope.PurreqDtl.Vendor.TinBinDocId = $scope.IndvVendorData[0].TinBinDocId || "";
                $scope.AutoCompleteVendorInfo($scope.IndvVendorData);

                $http.get("/VendorSelectionModule/VendorRegistrationUpdate/GetDocsForFurtherDoc", { params: { "TinBinDocId": $scope.PurreqDtl.Vendor.TinBinDocId } })
                    .success(function (response) {
                    
                        $scope.docProperties = [];
                        $scope.scannedDocuments = [];
                        $scope.displayScannedDocuments = [];
                      
                        $scope.setDocProperties(response.docProperties);
                        //$scope.docProperties = response.docProperties;
                        $scope.scannedDocuments = response.documents;
                        $scope.displayScannedDocuments = [].concat($scope.scannedDocuments);
                    })
                    .error(function (response) {

                    });

               



                $scope.loading = false;
            }).error(function () {
                $scope.loading = false;
                toastr.error('Data Loading Failed.');
            });








        $scope.setDocProperties = function (obj) {
            obj.forEach(function (element) {
                $scope.docProperty = {
                    DocPropertyID: element.DocPropertyID,
                    DocPropertyName: element.DocPropertyName,
                    DocClassification: element.DocClassification,
                    Exist: element.Exist,
                    Checked: false
                }
                $scope.docProperties.push($scope.docProperty);
            });
        }




        $scope.getScannedDocs = function (row) {
            //console.log(dwObject2);
            dwObject2.IfShowFileDialog = false;
            dwObject2.RemoveAllImages();
            dwObjectLargeViewer.RemoveAllImages();
            dwObject2.FTPPort = row.FtpPort;
            dwObject2.FTPUserName = row.FtpUserName;
            dwObject2.FTPPassword = row.FtpPassword;
            dwObject2.FTPDownload(row.ServerIP, (row.FileServerURL + "//" +
                $scope.VendorID + ".pdf"));
            $("#DetailViewModal").modal("show");
        }



        var UpdatedItem = {};

        $scope.showEditModal = function (row) {

            $("#docUpdateModal").modal("show");

            UpdatedItem = row;

            $scope.DocumentName = row.DocPropertyName;

            DWObjectOFMakeUpdate.IfShowFileDialog = false;
            DWObjectOFMakeUpdate.RemoveAllImages();

            DWObjectOFMakeUpdate.FTPPort = row.ServerPort;
            DWObjectOFMakeUpdate.FTPUserName = row.FtpUserName;
            DWObjectOFMakeUpdate.FTPPassword = row.FtpPassword;

            DWObjectOFMakeUpdate.FTPDownload(row.ServerIP, (row.FileServerURL +
                "//" + row.DocumentID + ".pdf"));
        };

        $scope.UpdateDocument = function () {
            if (UpdatedItem.DocumentID) {
                DWObjectOFMakeUpdate.IfShowFileDialog = false;
                var strFTPServer = UpdatedItem.ServerIP;
                DWObjectOFMakeUpdate.FTPPort = UpdatedItem.ServerPort;
                DWObjectOFMakeUpdate.FTPUserName = UpdatedItem.FtpUserName;
                DWObjectOFMakeUpdate.FTPPassword = UpdatedItem.FtpPassword;

                var isSave = DWObjectOFMakeUpdate.FTPUploadAllAsPDF(strFTPServer,
                    UpdatedItem.FileServerURL + "//" +
                    $scope.VendorID + ".pdf");

                if (isSave) {
                    $scope.loading = false;
                    toastr.success("Upload Successful");
                    UpdatedItem = {};
                    $('#docUpdateModal').modal('hide');
                }
                else {
                    toastr.error('Document Update Failed');
                }
            }
            else
                toastr.error('No Document Selected');

        };

        $scope.resetPage = function () {
            window.location.reload();
        }












        $scope.AutoCompleteVendorInfo = function (vendorData) {
            if (!vendorData || !Array.isArray(vendorData) || vendorData.length === 0) {
                toastr.error('No data available to populate vendor information.');
                return;
            }

            // Assuming vendorData is an array and we take the first element as the vendor details
            const vendor = vendorData[0];

            $scope.PurreqDtl.Vendor.BusinessName = vendor.BusinessName || "";
            $scope.PurreqDtl.Vendor.CompanyAddress = vendor.CompanyAddress || "";
            $scope.PurreqDtl.Vendor.ContactPerson = vendor.ContactPerson || "";
            $scope.PurreqDtl.Vendor.VendorId = vendor.VendorID || "";
            $scope.PurreqDtl.Vendor.TinBinDocId = vendor.TinBinDocId || "";



            // Split the ContactPerson into FirstName and LastName if available
            if (vendor.ContactPerson) {
                const nameParts = vendor.ContactPerson.split(' ');
                $scope.PurreqDtl.Vendor.ContactPersonFirstName = nameParts[0] || "";
                $scope.PurreqDtl.Vendor.ContactPersonLastName = nameParts.slice(1).join(' ') || "";
            } else {
                $scope.PurreqDtl.Vendor.ContactPersonFirstName = "";
                $scope.PurreqDtl.Vendor.ContactPersonLastName = "";
            }
            $scope.PurreqDtl.Vendor.VendorPhoneNumber = vendor.VendorPhoneNumber || "";
            $scope.PurreqDtl.Vendor.VendorPhoneNumber2 = vendor.VendorPhoneNumber2 || "";

            // Automatically show second input if VendorPhoneNumber2 exists
            $scope.AddNumber = !!$scope.PurreqDtl.Vendor.VendorPhoneNumber2;
            $scope.PurreqDtl.Vendor.GenaralDetailsServices = vendor.GenaralDetailsServices || "";
            $scope.PurreqDtl.Vendor.Email = vendor.VendorEmail || "";
            $scope.PurreqDtl.Vendor.TIN = vendor.TIN || "";
            $scope.PurreqDtl.Vendor.BIN = vendor.BIN || "";
            $scope.PurreqDtl.Vendor.CompanyProfile = vendor.CompanyProfile || "";
            $scope.PurreqDtl.Vendor.TradeLicense = vendor.TradeLicense || "";
            $scope.PurreqDtl.Vendor.PartnershipDeed = vendor.PartnershipDeed || "";
            $scope.PurreqDtl.Vendor.ImportRegistration = vendor.IRC || "";
            $scope.PurreqDtl.Vendor.IndentingLicense = vendor.IndentingLicense || "";
            $scope.PurreqDtl.Vendor.Others = vendor.Others || "";

 
            $scope.PurreqDtl.Vendor.UserName = ""; // Default value, assuming it's entered manually
            $scope.PurreqDtl.Vendor.Password = ""; // Default value, assuming it's entered manually
            $scope.PurreqDtl.Vendor.ConfirmPassword = ""; // Default value, assuming it's entered manually






        };




        $scope.updateRegistration = function () {
            $http.post('/VendorSelectionModule/VendorRegistration/VendorupdateRegistrationDetails', {
                BusinessName: $scope.PurreqDtl.Vendor.BusinessName,
                ContactPersonFirstName: $scope.PurreqDtl.Vendor.ContactPersonFirstName,
                ContactPersonLastName: $scope.PurreqDtl.Vendor.ContactPersonLastName,
                VendorPhoneNumber: $scope.PurreqDtl.Vendor.VendorPhoneNumber,
                VendorPhoneNumber2: $scope.PurreqDtl.Vendor.VendorPhoneNumber2,
                CompanyAddress: $scope.PurreqDtl.Vendor.CompanyAddress,

                Country: $scope.PurreqDtl.Vendor.Country,
                BusinessType: $scope.PurreqDtl.Vendor.BusinessType,

                TIN: $scope.PurreqDtl.Vendor.TIN,
                BIN: $scope.PurreqDtl.Vendor.BIN, 
                GeneralDetailsServices: $scope.PurreqDtl.Vendor.GenaralDetailsServices,
                Status: 'Temporary',
                Vendor: $scope.PurreqDtl.Vendor.VendorId,
                companyProfile: $scope.PurreqDtl.Vendor.CompanyProfile,
                tradeLicense: $scope.PurreqDtl.Vendor.TradeLicense,
                partnershipDeed: $scope.PurreqDtl.Vendor.PartnershipDeed,
                irc: $scope.PurreqDtl.Vendor.ImportRegistration,
                indentingLicense: $scope.PurreqDtl.Vendor.IndentingLicense,
                others: $scope.PurreqDtl.Vendor.Others,
               
                UserName: "",
                Password: "",
               


            })
                .success(function (response) {
                    if (response.user.UserID != "") {
                        toastr.success('Data Updated Successfully');
                        $scope.refreshPage();
                    }

                   
                })
                .catch(function () {
                    toastr.error("Data Save Failed");
                    $scope.loading = false;
                });
        } 






        //--------------utilities

        $scope.refreshPage = function () {
            setTimeout(function () {
                window.location = "/VendorSelectionModule/VendorDashboard/";// Reload the current page
            }, 2000); // 2000 milliseconds = 3 seconds
        }





    });
</script>

