                   ng-model="PurreqDtl.Vendor.CompanyAddress"
                   style="font-size: smaller; padding: 3px 6px 3px;" />
        </div>
    </div>

    <div class="row" style="margin-top: 5px;">
        <div class="col-lg-2">
            <div class="form-group" style="font-size: smaller;">
                <label for="EstablishedYear">Established Year </label>
            </div>
        </div>
        <div class="col-lg-2">
            <input id="EstablishedYear"
                   name="EstablishedYear"
