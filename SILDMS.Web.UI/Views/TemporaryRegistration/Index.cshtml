        $scope.RegistrationVendor = function () {

            var selectedPropID = [];

            angular.forEach($scope.docPropertyForSpecificDocType, function (item) {
                if (item.DocClassification === "Required") {
                    item.IsSelected = true;
                    selectedPropID.push(item.DocPropertyID);
                }
            });

            if ($scope.PurreqDtl.Vendor.Password !== $scope.PurreqDtl.Vendor.ConfirmPassword) {
                toastr.error("Passwords do not match");
                return;
            }

            $scope.loading = true;

            // 1️⃣ Save Vendor
            $http.post('/VendorSelectionModule/VendorRegistration/VendorRegistrationDetails', {
                businessName: $scope.PurreqDtl.Vendor.BusinessName,
                contactPersonFirstName: $scope.PurreqDtl.Vendor.ContactPersonFirstName,
                contactPersonLastName: $scope.PurreqDtl.Vendor.ContactPersonLastName,
                vendorPhoneNumber: $scope.PurreqDtl.Vendor.VendorPhoneNumber,
                email: $scope.info2,
                companyAddress: $scope.PurreqDtl.Vendor.CompanyAddress,
                country: $scope.PurreqDtl.Vendor.Country,
                businessType: $scope.PurreqDtl.Vendor.BusinessType.BusinessTypeName,
                tin: $scope.PurreqDtl.Vendor.TIN,
                bin: $scope.PurreqDtl.Vendor.BIN,
                generalDetailsServices: $scope.PurreqDtl.Vendor.GenaralDetailsServices,
                userName: $scope.PurreqDtl.Vendor.UserName,
                password: $scope.PurreqDtl.Vendor.Password,
                status: 'Temporary',
                vendor: $scope.info1,
                companyProfile: $scope.PurreqDtl.Vendor.CompanyProfile,
                tradeLicense: $scope.PurreqDtl.Vendor.TradeLicense,
                partnershipDeed: $scope.PurreqDtl.Vendor.PartnershipDeed,
                irc: $scope.PurreqDtl.Vendor.ImportRegistration,
                indentingLicense: $scope.PurreqDtl.Vendor.IndentingLicense,
                others: $scope.PurreqDtl.Vendor.Others
            })

                .then(function (vendorResp) {

                    if (!vendorResp.data.success) {
                        toastr.error(vendorResp.data.message);
                        return Promise.reject();
                    }

                    var userId = vendorResp.data.user.UserID;
                    var vendorId = vendorResp.data.user.VendorId;

                    // 2️⃣ Save Document Metadata
                    return $http.post('/VendorSelectionModule/VendorRegistration/AddDocument', {
                        UserId: userId,
                        VendorId: vendorId,
                        _selectedPropID: selectedPropID.join(),
                        _docMetaValues: $scope.docPropIdentityGridData
                    }).then(function (docResp) {

                        if (docResp.data.ResponseCode !== "S201") {
                            toastr.error("Document metadata save failed");
                            return Promise.reject();
                        }

                        return {
                            docInfo: docResp.data.DistinctID[0],
                            vendorId: vendorId
                        };
                    });
                })

                .then(function (context) {

                    if (!context) return;

                    var uploads = [];

                    function uploadFile(file, docType) {

                        var fileData = new FormData();
                        fileData.append('serverIP', context.docInfo.ServerIP);
                        fileData.append('ftpPort', context.docInfo.ServerPort);
                        fileData.append('ftpUserName', context.docInfo.FtpUserName);
                        fileData.append('ftpPassword', context.docInfo.FtpPassword);
                        fileData.append('vendorId', context.vendorId);
                        fileData.append('docType', docType);
                        fileData.append('file', file);

                        return $http.post(
                            '/VendorSelectionModule/VendorRegistration/UploadOtherFiles',
                            fileData,
                            {
                                transformRequest: angular.identity,
                                headers: { 'Content-Type': undefined }
                            }
                        );
                    }

                    // Optional uploads
                    if ($scope.tinFile) uploads.push(uploadFile($scope.tinFile, 'TIN'));
                    if ($scope.binFile) uploads.push(uploadFile($scope.binFile, 'BIN'));
                    if ($scope.companyProfileFile) uploads.push(uploadFile($scope.companyProfileFile, 'CompanyProfile'));
                    if ($scope.tradeLicenseFile) uploads.push(uploadFile($scope.tradeLicenseFile, 'TradeLicense'));
                    if ($scope.partnershipDeedFile) uploads.push(uploadFile($scope.partnershipDeedFile, 'PartnershipDeed'));
                    if ($scope.importRegistrationFile) uploads.push(uploadFile($scope.importRegistrationFile, 'ImportRegistration'));
                    if ($scope.indentingLicenseFile) uploads.push(uploadFile($scope.indentingLicenseFile, 'IndentingLicense'));
                    if ($scope.othersFile) uploads.push(uploadFile($scope.othersFile, 'Others'));

                    // 🔥 Critical: Handle empty upload array explicitly
                    if (uploads.length === 0) {
                        toastr.success("Vendor registered successfully");
                        $scope.refreshPage();
                        return;
                    }

                    // If files exist → wait for all
                    return Promise.all(uploads)
                        .then(function () {
                            toastr.success("Vendor registered and documents uploaded successfully");
                            $scope.refreshPage();
                        })
                        .catch(function () {
                            toastr.error("File upload failed");
                        });
                })

                .catch(function () {
                    // Already handled specific errors above
                })

                .finally(function () {
                    $scope.loading = false;
                });
        };





        $scope.AutoCompleteVendorInfo = function (vendorData) {
            if (!vendorData || !Array.isArray(vendorData) || vendorData.length === 0) {
                toastr.error('No data available to populate vendor information.');
                return;
            }

            // Assuming vendorData is an array and we take the first element as the vendor details
            const vendor = vendorData[0];

            $scope.PurreqDtl.Vendor.BusinessName = vendor.BusinessName || "";
            $scope.PurreqDtl.Vendor.CompanyAddress = vendor.CompanyAddress || "";
            $scope.PurreqDtl.Vendor.ContactPerson = vendor.ContactPerson || "";

            // Split the ContactPerson into FirstName and LastName if available
            if (vendor.ContactPerson) {
                const nameParts = vendor.ContactPerson.split(' ');
                $scope.PurreqDtl.Vendor.ContactPersonFirstName = nameParts[0] || "";
                $scope.PurreqDtl.Vendor.ContactPersonLastName = nameParts.slice(1).join(' ') || "";
            } else {
                $scope.PurreqDtl.Vendor.ContactPersonFirstName = "";
                $scope.PurreqDtl.Vendor.ContactPersonLastName = "";
            }
            $scope.PurreqDtl.Vendor.VendorPhoneNumber = vendor.VendorPhoneNumber || "";
            $scope.PurreqDtl.Vendor.GenaralDetailsServices = vendor.GenaralDetailsServices || "";
            $scope.PurreqDtl.Vendor.Email = vendor.VendorEmail || "";
            $scope.PurreqDtl.Vendor.TIN = vendor.TIN || "";
            $scope.PurreqDtl.Vendor.BIN = vendor.BIN || "";

            $scope.PurreqDtl.Vendor.UserName = ""; // Default value, assuming it's entered manually
            $scope.PurreqDtl.Vendor.Password = ""; // Default value, assuming it's entered manually
            $scope.PurreqDtl.Vendor.ConfirmPassword = ""; // Default value, assuming it's entered manually
        };



        $scope.updateRegistration = function () {
            var selectedPropID = [];

            angular.forEach($scope.docPropertyForSpecificDocType, function (item) {
                if (item.DocClassification === "Required") {
                    item.IsSelected = true;
                    selectedPropID.push(item.DocPropertyID);
                }
            });

            if ($scope.PurreqDtl.Vendor.Password !== $scope.PurreqDtl.Vendor.ConfirmPassword) {
                toastr.error("Passwords do not match");
                return;
            }

            // Optional: Documents are not mandatory for update
            // Remove this check if documents are optional
            // if (!$scope.tinFile && !$scope.binFile) {
            //     toastr.error("Please upload at least one document (TIN or BIN)");
            //     return;
            // }

            $scope.loading = true;

            // 1️⃣ Update Vendor Info
            $http.post('/VendorSelectionModule/VendorRegistration/VendorupdateRegistrationDetails', {
                BusinessName: $scope.PurreqDtl.Vendor.BusinessName,
                ContactPersonFirstName: $scope.PurreqDtl.Vendor.ContactPersonFirstName,
                ContactPersonLastName: $scope.PurreqDtl.Vendor.ContactPersonLastName,
                VendorPhoneNumber: $scope.PurreqDtl.Vendor.VendorPhoneNumber,
                CompanyAddress: $scope.PurreqDtl.Vendor.CompanyAddress,
                Country: $scope.PurreqDtl.Vendor.Country,
                BusinessType: $scope.PurreqDtl.Vendor.BusinessType,
                TIN: $scope.PurreqDtl.Vendor.TIN,
                BIN: $scope.PurreqDtl.Vendor.BIN,
                GeneralDetailsServices: $scope.PurreqDtl.Vendor.GenaralDetailsServices,
                Status: 'Temporary',
                Vendor: $scope.Vendor,
                UserName: $scope.PurreqDtl.Vendor.UserName,
                Password: $scope.PurreqDtl.Vendor.Password
            })
                .success(function (vendorResp) {

                    if (!vendorResp.user || !vendorResp.user.UserID) {
                        $scope.loading = false;
                        toastr.error("Vendor update failed");
                        return;
                    }

                    // 2️⃣ Save Document Metadata
                    $http.post('/VendorSelectionModule/VendorRegistration/AddDocument', {
                        UserId: vendorResp.user.UserID,
                        VendorId: vendorResp.user.VendorId,
                        _selectedPropID: selectedPropID.join(),
                        _docMetaValues: $scope.docPropIdentityGridData
                    })
                        .success(function (docResp) {

                            if (docResp.ResponseCode === "S201") {
                                var docInfo = docResp.DistinctID[0];

                                // Reusable upload function
                                function uploadFile(file, docType) {
                                    var fileData = new FormData();
                                    fileData.append('serverIP', docInfo.ServerIP);
                                    fileData.append('ftpPort', docInfo.ServerPort);
                                    fileData.append('ftpUserName', docInfo.FtpUserName);
                                    fileData.append('ftpPassword', docInfo.FtpPassword);
                                    fileData.append('vendorId', vendorResp.user.VendorId);
                                    fileData.append('docType', docType);
                                    fileData.append('file', file);

                                    return $.ajax({
                                        url: '/VendorSelectionModule/VendorRegistration/UploadOtherFiles',
                                        type: 'POST',
                                        data: fileData,
                                        contentType: false,
                                        processData: false
                                    });
                                }

                                var uploads = [];
                                if ($scope.tinFile) uploads.push(uploadFile($scope.tinFile, 'TIN'));
                                if ($scope.binFile) uploads.push(uploadFile($scope.binFile, 'BIN'));

                                // 3️⃣ Upload files if any
                                if (uploads.length > 0) {
                                    $.when.apply($, uploads)
                                        .done(function () {
                                            $scope.loading = false;
                                            toastr.success("Vendor updated and documents uploaded successfully");
                                            $scope.tinFile = null;
                                            $scope.binFile = null;
                                            $('#TINFile').val('');
                                            $('#BINFile').val('');
                                            $scope.$apply(() => $scope.refreshPage());
                                        })
                                        .fail(function () {
                                            $scope.loading = false;
                                            toastr.warning("Vendor updated but some documents failed to upload");
                                            $scope.$apply(() => $scope.refreshPage());
                                        });
                                } else {
                                    // No documents to upload
                                    $scope.loading = false;
                                    toastr.success("Vendor updated successfully");
                                    $scope.$apply(() => $scope.refreshPage());
                                }
                            } else {
                                $scope.loading = false;
                                toastr.error("Document metadata save failed");
                            }
                        })
                        .error(function () {
                            $scope.loading = false;
                            toastr.error("Document metadata save failed");
                        });

                })
                .error(function () {
                    $scope.loading = false;
                    toastr.error("Vendor update failed");
                });
        };


        $scope.BusinessTypeList = [];
        $scope.BusinessNatureList = [];
        $scope.CountryList = [];


        $scope.loadBusinessType = function () {
            $http.get('/VendorSelectionModule/VendorRegistration/GetBusinessTypeList')
                .then(function (response) {
                    $scope.BusinessTypeList = response.data;
                });
        };

        $scope.loadBusinessNature = function () {
            $http.get('/VendorSelectionModule/VendorRegistration/GetBusinessNatureList')
                .then(function (response) {
                    $scope.BusinessNatureList = response.data;
                });
        };

        $scope.LoadCountryList = function () {
            $http.get('/VendorSelectionModule/VendorRegistration/GetCountryList')
                .then(function (res) {
                    $scope.CountryList = res.data;
                });
        };

        // call on page load
        $scope.loadBusinessType();
        $scope.loadBusinessNature();
        $scope.LoadCountryList();



        //--------------utilities

        $scope.refreshPage = function () {
            setTimeout(function () {
                window.location = "/SecurityModule/Account/Login";// Reload the current page
            }, 2000); // 2000 milliseconds = 3 seconds
        }

        $scope.toggleRefreshTable = function (row) {
            location.reload();
        };

    });
</script>

