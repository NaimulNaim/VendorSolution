<script src="~/Scripts/jquery-barcode.min.js"></script>
@{
    ViewBag.Title = "Temporary";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}


<div class="box box-primary box-body" ng-controller="VendorRegistrationCtrl">
    @* Header *@

    <div class="box-header with-border" style="font-family: Verdana; background: #E4E9E3; color: black; ">
        <i class="fa fa-user"></i>
        <h3 style="font-family: Verdana" class="box-title" ng-if="fromMenu">Temporary Vendor Registration</h3>
        <h3 style="font-family: Verdana" class="box-title" ng-if="!fromMenu">Temporary Vendor Registration</h3>
        <div class="box-tools pull-right">
            <button type="button" id="btnRefresh" data-ng-click="toggleRefreshTable(row)" class="btn btn-warning btn-flat pull-right" ng-disabled="loading"><i class="fa fa-refresh"></i> Refresh</button>
        </div>
    </div>

  
    <div class="col-sm-12 col-md-12 col-lg-12" id="EntryHolderDiv" ng-show="p==1">
        <div style="margin: 1%; background-color: #F0F0F0; box-shadow: 2px 2px 5px #888888; padding: 10px 10px 10px 10px;" ng-show="q === 1">
            <div style="height: 30px; margin-bottom:1%">
                <p style="font-family: Verdana; position: center;  bottom: 5px;">Register your business and please provide all required details to register your business with us</p>
            </div>

            <!-- Bussiness Name -->
            <div class="row" style="margin-top: 5px;">
                <div class="col-lg-2">
                    <div class="form-group" style="font-size: smaller;">
                        <label for="BusinessName">Business Name :<span style="color: red;"> *</span></label>
                    </div>
                </div>
                <div class="col-lg-4">
                    <input id="BusinessName" autocomplete="off" type="text" name="BusinessName" class="form-control" ng-model="PurreqDtl.Vendor.BusinessName" placeholder="" style="font-size: smaller; padding: 3px 6px 3px;" required />
                </div>
                @*<div class="col-md-3">
                <span class="center-block text-red" id="errorMessageBusinessName" style="display: none;">Please input valid Business Name.</span>
            </div>*@

                <!-- Business Type -->
                <div class="col-lg-2">
                    <div class="form-group" style="font-size: smaller;">
                        <label for="BusinessType">Business Type :</label>
                    </div>
                </div>

                <div class="col-lg-4">
                    <select class="form-control"
                            ng-model="PurreqDtl.Vendor.BusinessType"
                            ng-options="bt as bt.BusinessTypeName for bt in BusinessTypeList track by bt.BusinessTypeID">
                        <option value="">-- Select Business Type --</option>
                    </select>


                </div>



            </div>


            <!-- Contact Person -->
            <div class="row" style="margin-top: 5px;">

                <div class="col-lg-2 col-md-2 col-sm-2" style="font-size: smaller;">
                    <label for="ContactPerson">Contact Person :</label>
                </div>
                <div class="col-lg-2 col-md-2 col-sm-2">
                    <input id="FirstName" autocomplete="off" type="text" name="FirstName" class="form-control" ng-model="PurreqDtl.Vendor.ContactPersonFirstName" placeholder="First Name" style="font-size: smaller; padding: 3px 6px 3px;" required />
                </div>
                <div class="col-lg-2 col-md-2 col-sm-2">
                    <input id="LastName" autocomplete="off" type="text" name="LastName" class="form-control" ng-model="PurreqDtl.Vendor.ContactPersonLastName" placeholder="Last Name" style="font-size: smaller; padding: 3px 6px 3px;" required />
                </div>
                <div class="col-md-3">
                    <span class="center-block text-red" id="errorMessageContactPerson" style="display: none;">Please input valid ContactPerson.</span>
                </div>
            </div>

            <!-- Contact Number -->
            <div class="row" style="margin-top: 5px;">
                <div class="col-lg-2" style="font-size: smaller;">
                    <label for="VendorPhoneNumber">Contact Number :<span style="color: red;"> *</span></label>
                </div>
                <div class="col-lg-2">
                    <input id="VendorPhoneNumber" autocomplete="off" type="text" name="VendorPhoneNumber" class="form-control" ng-model="PurreqDtl.Vendor.VendorPhoneNumber" placeholder="(+880) 00 0000 0000" style="font-size: smaller; padding: 3px 6px 3px;" required />
                </div>
                <div class="col-md-3">
                    <span class="center-block text-red" id="errorMessageVendorPhoneNumber" style="display: none;">Please input valid Contact Number.</span>
                </div>
            </div>

            <!-- Email -->
            <div class="row" style="margin-top: 5px;">
                <div class="col-lg-2" style="font-size: smaller;">
                    <label for="Email">Email :<span style="color: red;"> *</span></label>
                </div>
                <div class="col-lg-2">
                    <input id="Email" type="email" autocomplete="off" name="Email" class="form-control" ng-model="PurreqDtl.Vendor.Email" placeholder="yourname@gmail.com" style="font-size: smaller; padding: 3px 6px 3px;" required />
                </div>
                <div class="col-md-3">
                    <span class="center-block text-red" id="errorMessageEmail" style="display: none;">Please input valid Email.</span>
                </div>
            </div>




            @*  Company Address *@
            <div class="row" style="margin-top: 5px;">
                <div class="col-lg-2" style="font-size: smaller;">
                    <label for="CompanyAddress">Company Address :</label>
                </div>
