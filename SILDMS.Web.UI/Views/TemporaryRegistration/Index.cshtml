        $scope.decrypt = function (encryptedText) {
            var key = CryptoJS.enc.Utf8.parse("1234567890abcdef");

            try {
                // Decode the Base64 encrypted text
                var decodedEncryptedText = CryptoJS.enc.Base64.parse(encryptedText);
                var iv = CryptoJS.lib.WordArray.create(decodedEncryptedText.words.slice(0, 4)); // First 16 bytes for IV
                var ciphertext = CryptoJS.lib.WordArray.create(decodedEncryptedText.words.slice(4)); // Remainder is ciphertext

                // Perform AES decryption using CBC mode
                var decrypted = CryptoJS.AES.decrypt(
                    { ciphertext: ciphertext },
                    key,
                    {
                        iv: iv,
                        mode: CryptoJS.mode.CBC,
                        padding: CryptoJS.pad.Pkcs7
                    }
                );

                // Convert the decrypted data to a UTF-8 string
                var decryptedText = decrypted.toString(CryptoJS.enc.Utf8);

                return decryptedText;
            } catch (e) {
                console.error("Decryption failed: ", e);
                return null;
            }
        };






