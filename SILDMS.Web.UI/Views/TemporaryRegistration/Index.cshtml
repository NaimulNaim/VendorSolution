                    // 2️⃣ Save Document Metadata
                    $http.post('/VendorSelectionModule/VendorRegistration/AddDocument', {
                        UserId: vendorResp.user.UserID,
                        VendorId: vendorResp.user.VendorId,
                        _selectedPropID: selectedPropID.join(),
                        _docMetaValues: $scope.docPropIdentityGridData
                    })
                        .success(function (docResp) {

                            if (docResp.ResponseCode === "S201") {

                                var docInfo = docResp.DistinctID[0];

                                // 🔁 Reusable upload function
                                function uploadFile(file, docType) {
                                    var fileData = new FormData();
                                    fileData.append('serverIP', docInfo.ServerIP);
                                    fileData.append('ftpPort', docInfo.ServerPort);
                                    fileData.append('ftpUserName', docInfo.FtpUserName);
                                    fileData.append('ftpPassword', docInfo.FtpPassword);
                                    fileData.append('vendorId', vendorResp.user.VendorId);
                                    fileData.append('docType', docType); // BIN / TIN
                                    fileData.append('file', file);

                                    return $.ajax({
                                        url: '/VendorSelectionModule/VendorRegistration/UploadOtherFiles',
                                        type: 'POST',
                                        data: fileData,
                                        contentType: false,
                                        processData: false
                                    });
                                }

                                var uploads = [];

                                if ($scope.tinFile)
                                    uploads.push(uploadFile($scope.tinFile, 'TIN'));

                                if ($scope.binFile)
                                    uploads.push(uploadFile($scope.binFile, 'BIN'));

                                // 3️⃣ Upload both files simultaneously
                                $.when.apply($, uploads)
                                    .done(function () {
                                        toastr.success("Vendor updated and documents uploaded successfully");

                                        $scope.tinFile = null;
                                        $scope.binFile = null;
                                        $('#TINFile').val('');
                                        $('#BINFile').val('');

                                        $scope.$apply(() => $scope.refreshPage());
                                    })
                                    .fail(function () {
                                        toastr.error("One or more document uploads failed");
                                    });
                            }
                        })
                        .error(function () {
                            toastr.error("Document metadata save failed");
                        });

                })
                .error(function () {
                    toastr.error("Vendor update failed");
                });
        };


