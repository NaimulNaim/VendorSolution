                        </div>
                    </div>
                </div>

                <div class="row form-row-item">
                    <div class="col-lg-2 col-md-3 field-label">Indenting License</div>
                    <div class="col-lg-2 col-md-3">
                        <input type="text" class="form-control" ng-model="PurreqDtl.Vendor.IndentingLicense" placeholder="Optional" />
                    </div>
                    <div class="col-lg-4 col-md-4">
                        <div class="file-wrap">
                            <input type="file" id="IndentingLicense" accept=".pdf"
                                   onchange="angular.element(this).scope().fileSelected(this,'IndentingLicense')" />
                        </div>
                    </div>
                </div>

                <div class="row form-row-item">
                    <div class="col-lg-2 col-md-3 field-label">Others</div>
                    <div class="col-lg-2 col-md-3">
                        <input type="text" class="form-control" ng-model="PurreqDtl.Vendor.Others" placeholder="Optional" />
                    </div>
                    <div class="col-lg-4 col-md-4">
                        <div class="file-wrap">
                            <input type="file" id="Others" accept=".pdf"
                                   onchange="angular.element(this).scope().fileSelected(this,'Others')" />
                        </div>
                    </div>
                </div>

                <!-- ── Credentials ── -->
                <div class="row form-row-item">
                    <div class="col-lg-2 col-md-3 field-label">
                        User Name <span class="req">*</span>
                    </div>
                    <div class="col-lg-3 col-md-4">
                        <input autocomplete="off" type="text" class="form-control"
                               ng-model="PurreqDtl.Vendor.UserName" />
                        <span class="field-error" id="errorMessageUserName">Please input a valid User Name.</span>
                    </div>
                </div>

                <div class="row form-row-item">
                    <div class="col-lg-2 col-md-3 field-label">
                        Password <span class="req">*</span>
                    </div>
                    <div class="col-lg-3 col-md-4">
                        <input autocomplete="off" type="password" class="form-control"
                               ng-model="PurreqDtl.Vendor.Password" />
                        <span class="field-error" id="errorMessagePassword">Please input a valid Password.</span>
                    </div>
                </div>

                <div class="row form-row-item">
                    <div class="col-lg-2 col-md-3 field-label">
                        Confirm Password <span class="req">*</span>
                    </div>
                    <div class="col-lg-3 col-md-4">
                        <input autocomplete="off" type="password" class="form-control"
                               ng-model="PurreqDtl.Vendor.ConfirmPassword" />
                    </div>
                </div>

                <!-- ── Submit ── -->
                <div class="btn-submit-row">
                    <button id="btnSaveMasterInitial" type="button"
                            class="btn btn-success"
                            data-dismiss="modal"
                            title="Submit"
                            ng-click="ValidationCheck()">
                        <i class="fa fa-save"></i>&nbsp; Submit Registration
                    </button>
                </div>
            </div><!-- /q=1 -->
            <!-- ─── q=2 : Already Registered ─── -->
            <div class="already-registered" ng-show="q==2">
                <h4><i class="fa fa-info-circle"></i>&nbsp; Already Registered — Please login with your credentials.</h4>
            </div>

            <!-- ─── q=3 : Update Registration ─── -->
            <!-- ─── q=3 : Update Registration ─── -->
            <div class="reg-card" ng-show="q === 3">
                <p style="font-family:Verdana;font-size:12px;color:#555;margin-bottom:4px;">
                    Update your registration information below.
                </p>

