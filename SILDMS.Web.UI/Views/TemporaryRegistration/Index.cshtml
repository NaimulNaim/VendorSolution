<script src="~/Scripts/jquery-barcode.min.js"></script>
@{
    ViewBag.Title = "Temporary";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<style>
    /* ── Section card ── */
    .reg-card {
        background: #fff;
        border: 1px solid #dce1e7;
        border-radius: 6px;
        box-shadow: 0 2px 8px rgba(0,0,0,.08);
        padding: 24px 28px;
        margin-top: 16px;
    }

    /* ── Section divider headings ── */
    .section-heading {
        font-family: Verdana, sans-serif;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: #6c757d;
        border-bottom: 2px solid #e4e9e3;
        padding-bottom: 6px;
        margin: 20px 0 14px;
    }
    .section-heading:first-of-type { margin-top: 4px; }

    /* ── Uniform label column ── */
    .field-label {
/*        font-family: Verdana, sans-serif;*/
        font-size: smaller;
        font-weight: 600;
        color: #444;
        padding-top: 7px;
        text-align: right;
    }
   @@media (min-width: 1200px) {
    .col-lg-2 {
        width: 22.666667%;
    }
}

    /* ── Required star ── */
    .req { color: #c0392b; margin-left: 2px; }

    /* ── Inputs ── */
    .reg-card .form-control {
        font-size: 12px;
        height: 32px;
        padding: 4px 8px;
        border-radius: 4px;
        border: 1px solid #ccd0d5;
        transition: border-color .2s, box-shadow .2s;
    }
    .reg-card .form-control:focus {
        border-color: #5d9b5e;
        box-shadow: 0 0 0 3px rgba(93,155,94,.15);
        outline: none;
    }
    .reg-card select.form-control { height: 32px; }

    /* ── File input ── */
    .file-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 6px;
    }
    .file-wrap input[type="file"] {
        font-size: 11px;
        color: #555;
    }

    /* ── Form rows ── */
    .form-row-item {
        margin-bottom: 5px;
    }

    /* ── Already registered banner ── */
    .already-registered {
        background: #fff8f0;
        border: 1px solid #f0c070;
        border-left: 4px solid #e67e22;
        border-radius: 4px;
        padding: 16px 20px;
        margin-top: 16px;
        font-family: Verdana, sans-serif;
    }
    .already-registered h4 {
        margin: 0;
        font-size: 14px;
        color: #7d4e00;
    }

    .small-modal {
        width: 350px;
    }
    /* ── Page header bar ── */
    .box-header.with-border {
        background: #e4e9e3 !important;
        border-bottom: 2px solid #c8d4c6;
    }
    .box-header .box-title {
        font-family: Verdana, sans-serif;
        font-size: 15px;
        font-weight: 700;
        color: #2c3e2d;
    }

    /* ── Submit button row ── */
    .btn-submit-row {
        border-top: 1px solid #e4e9e3;
        padding-top: 16px;
        margin-top: 20px;
        display: flex;
        justify-content: flex-end;
    }
    .btn-submit-row .btn {
        font-size: 12px;
        padding: 7px 20px;
        border-radius: 4px;
    }

    /* ── Error messages ── */
    .field-error {
        font-size: 11px;
        color: #c0392b;
        margin-top: 3px;
        display: none;
    }

    /* ── Check-email confirmation ── */
    .email-confirm {
        text-align: center;
        padding: 48px 0;
        font-family: Verdana, sans-serif;
        color: #2c3e2d;
    }
    .email-confirm i {
        font-size: 48px;
        color: #5d9b5e;
        margin-bottom: 12px;
        display: block;
    }
</style>

<div class="box box-primary box-body" ng-controller="VendorRegistrationCtrl">

    <!-- ── Page Header ── -->
    <div class="box-header with-border">
        <i class="fa fa-user"></i>
        <h3 class="box-title">Temporary Vendor Registration</h3>
        <div class="box-tools pull-right">
            <button type="button" id="btnRefresh"
                    data-ng-click="toggleRefreshTable(row)"
                    class="btn btn-warning btn-flat btn-sm"
                    ng-disabled="loading">
                <i class="fa fa-refresh"></i> Refresh
            </button>
        </div>


        <!-- ══════════════════════════════════════
         PANEL 1 — Main entry (p==1)
    ══════════════════════════════════════ -->
        <div class="col-sm-12" id="EntryHolderDiv" ng-show="p==1">

            <!-- ─── q=1 : New Registration ─── -->
            <div class="reg-card" ng-show="q === 1">
                <p style="font-family:Verdana;font-size:12px;color:#555;margin-bottom:4px;">
                    Register your business and provide all required details below.
                </p>

                <!-- ── Business Info ── -->
                <div class="section-heading"></div>

                <div class="row form-row-item">
                    <div class="col-lg-2 col-md-3 field-label">
                        Business Name <span class="req">*</span>
                    </div>
                    <div class="col-lg-4 col-md-5">
                        <input id="BusinessName" autocomplete="off" type="text" name="BusinessName"
                               class="form-control" ng-model="PurreqDtl.Vendor.BusinessName" required />
                    </div>
                </div>

                <div class="row form-row-item">
                    <div class="col-lg-2 col-md-3 field-label">Business Type</div>
                    <div class="col-lg-4 col-md-5">
                        <select class="form-control"
                                ng-model="PurreqDtl.Vendor.BusinessType"
                                ng-options="bt as bt.BusinessTypeName for bt in BusinessTypeList track by bt.BusinessTypeID">
                            <option value="">-- Select Business Type --</option>
                        </select>
                    </div>
                </div>

                <div class="row form-row-item">
                    <div class="col-lg-2 col-md-3 field-label">Country</div>
                    <div class="col-lg-4 col-md-5">
                        <select class="form-control"
                                ng-model="PurreqDtl.Vendor.Country"
                                ng-options="c.CountryID as c.CountryName for c in CountryList">
                            <option value="">-- Select Country --</option>
                        </select>
                    </div>
                </div>

                <div class="row form-row-item">
                    <div class="col-lg-2 col-md-3 field-label">Company Address</div>
                    <div class="col-lg-6 col-md-7">
                        <input autocomplete="off" type="text" name="CompanyAddress"
                               class="form-control" ng-model="PurreqDtl.Vendor.CompanyAddress" />
                    </div>
                </div>

                <div class="row form-row-item">
                    <div class="col-lg-2 col-md-3 field-label">General Details of Services / Goods</div>
                    <div class="col-lg-6 col-md-7">
                        <input autocomplete="off" type="text" name="GeneralDetails"
                               class="form-control" ng-model="PurreqDtl.Vendor.GenaralDetailsServices" />
                    </div>
                </div>


                <div class="row form-row-item">
                    <div class="col-lg-2 col-md-3 field-label">Contact Person</div>
                    <div class="col-lg-2 col-md-3">
                        <input autocomplete="off" type="text" class="form-control"
                               ng-model="PurreqDtl.Vendor.ContactPersonFirstName" placeholder="First Name" />
                    </div>
                    <div class="col-lg-2 col-md-3">
                        <input autocomplete="off" type="text" class="form-control"
                               ng-model="PurreqDtl.Vendor.ContactPersonLastName" placeholder="Last Name" />
                    </div>
                </div>

                <div class="row form-row-item">
                    <div class="col-lg-2 col-md-3 field-label">
                        Contact Number <span class="req">*</span>
                    </div>
                    <div class="col-lg-3 col-md-4">
                        <input autocomplete="off" type="text" class="form-control"
                               ng-model="PurreqDtl.Vendor.VendorPhoneNumber" placeholder="(+880) 00 0000 0000" />
                        <span class="field-error" id="errorMessageVendorPhoneNumber">Please input a valid Contact Number.</span>
                    </div>
                </div>

                <div class="row form-row-item">
                    <div class="col-lg-2 col-md-3 field-label">
                        Email <span class="req">*</span>
                    </div>
                    <div class="col-lg-3 col-md-4">
                        <input type="email" autocomplete="off" class="form-control"
                               ng-model="PurreqDtl.Vendor.Email" placeholder="yourname@example.com" />
                        <span class="field-error" id="errorMessageEmail">Please input a valid Email.</span>
                    </div>
                </div>

                <!-- ── Documents ── -->
                <!-- helper macro rendered as repeated rows -->
                <div class="row form-row-item">
                    <div class="col-lg-2 col-md-3 field-label">TIN</div>
                    <div class="col-lg-2 col-md-3">
                        <input type="text" class="form-control" ng-model="PurreqDtl.Vendor.TIN" placeholder="Optional" />
                    </div>
                    <div class="col-lg-4 col-md-4">
                        <div class="file-wrap">
                            <input type="file" id="TINFile" accept=".pdf"
                                   onchange="angular.element(this).scope().fileSelected(this,'TIN')" />
                        </div>
                    </div>
                </div>

                <div class="row form-row-item">
                    <div class="col-lg-2 col-md-3 field-label">BIN</div>
                    <div class="col-lg-2 col-md-3">
                        <input type="text" class="form-control" ng-model="PurreqDtl.Vendor.BIN" placeholder="Optional" />
                    </div>
                    <div class="col-lg-4 col-md-4">
                        <div class="file-wrap">
                            <input type="file" id="BINFile" accept=".pdf"
                                   onchange="angular.element(this).scope().fileSelected(this,'BIN')" />
                        </div>
                    </div>
                </div>

                <div class="row form-row-item">
                    <div class="col-lg-2 col-md-3 field-label">Company Profile</div>
                    <div class="col-lg-2 col-md-3">
                        <input type="text" class="form-control" ng-model="PurreqDtl.Vendor.CompanyProfile" placeholder="Optional" />
                    </div>
                    <div class="col-lg-4 col-md-4">
                        <div class="file-wrap">
                            <input type="file" id="CompanyProfile" accept=".pdf"
                                   onchange="angular.element(this).scope().fileSelected(this,'CompanyProfile')" />
                        </div>
                    </div>
                </div>

                <div class="row form-row-item">
                    <div class="col-lg-2 col-md-3 field-label">Trade License</div>
                    <div class="col-lg-2 col-md-3">
                        <input type="text" class="form-control" ng-model="PurreqDtl.Vendor.TradeLicense" placeholder="Optional" />
                    </div>
                    <div class="col-lg-4 col-md-4">
