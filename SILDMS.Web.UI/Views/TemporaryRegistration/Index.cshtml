        $scope.RegistrationVendor = function () {
            var selectedPropID = [];

            angular.forEach($scope.docPropertyForSpecificDocType, function (item) {
                if (item.DocClassification === "Required") {
                    item.IsSelected = true;
                    selectedPropID.push(item.DocPropertyID);
                }
            });

            if ($scope.PurreqDtl.Vendor.Password !== $scope.PurreqDtl.Vendor.ConfirmPassword) {
                toastr.error("Passwords do not match");
                return;
            }

            //if (!$scope.tinFile && !$scope.binFile) {
            //    toastr.error("Please upload at least one PDF document (TIN or BIN)");
            //    return;
            //}

            // 1️⃣ Save Vendor
            $http.post('/VendorSelectionModule/VendorRegistration/VendorRegistrationDetails', {
                BusinessName: $scope.PurreqDtl.Vendor.BusinessName,
                ContactPersonFirstName: $scope.PurreqDtl.Vendor.ContactPersonFirstName,
                ContactPersonLastName: $scope.PurreqDtl.Vendor.ContactPersonLastName,
                VendorPhoneNumber: $scope.PurreqDtl.Vendor.VendorPhoneNumber,
                CompanyAddress: $scope.PurreqDtl.Vendor.CompanyAddress,
                Email: $scope.info2,
                Country: $scope.PurreqDtl.Vendor.Country,
                BusinessType: $scope.PurreqDtl.Vendor.BusinessType,
                TIN: $scope.PurreqDtl.Vendor.TIN,
                BIN: $scope.PurreqDtl.Vendor.BIN,
                GenaralDetailsServices: $scope.PurreqDtl.Vendor.GenaralDetailsServices,
                UserName: $scope.PurreqDtl.Vendor.UserName,
                Password: $scope.PurreqDtl.Vendor.Password,
                Status: 'Temporary',
                Vendor: $scope.info1
            }).success(function (vendorResp) {

                // 2️⃣ Save Document Metadata
                $http.post('/VendorSelectionModule/VendorRegistration/AddDocument', {
                    UserId: vendorResp.user.UserID,
                    VendorId: vendorResp.user.VendorId,
                    _selectedPropID: selectedPropID.join(),
                    _docMetaValues: $scope.docPropIdentityGridData
                }).success(function (docResp) {

                    if (docResp.ResponseCode === "S201") {
                        var docInfo = docResp.DistinctID[0];

                        // Helper function to upload a file to the backend
                        function uploadFile(file, docType) {
                            var fileData = new FormData();
                            fileData.append('serverIP', docInfo.ServerIP);
                            fileData.append('ftpPort', docInfo.ServerPort);
                            fileData.append('ftpUserName', docInfo.FtpUserName);
                            fileData.append('ftpPassword', docInfo.FtpPassword);
                            fileData.append('vendorId', vendorResp.user.VendorId);
                            fileData.append('docType', docType); // "TIN" or "BIN"
                            fileData.append('file', file);

                            return $.ajax({
                                url: '/VendorSelectionModule/VendorRegistration/UploadOtherFiles',
                                type: 'POST',
                                data: fileData,
                                contentType: false,
                                processData: false
                            });
                        }

                        // Array of upload promises
                        var uploads = [];
                        if ($scope.tinFile) uploads.push(uploadFile($scope.tinFile, 'TIN'));
                        if ($scope.binFile) uploads.push(uploadFile($scope.binFile, 'BIN'));

                        // Upload all files simultaneously
                        $.when.apply($, uploads).done(function () {
                            toastr.success("Data Saved and TIN & BIN documents uploaded successfully");
                            $scope.tinFile = null;
                            $scope.binFile = null;
                            $('#TINFile').val('');
                            $('#BINFile').val('');
                            $scope.$apply(() => $scope.refreshPage());
                        }).fail(function () {
                            toastr.error("One or more file uploads failed");
                        });
                    }

                }).error(function () {
                    toastr.error("Document metadata save failed");
                });

            }).error(function () {
                toastr.error("Vendor registration failed");
            });
        };



        $scope.AutoCompleteVendorInfo = function (vendorData) {
            if (!vendorData || !Array.isArray(vendorData) || vendorData.length === 0) {
                toastr.error('No data available to populate vendor information.');
                return;
            }

            // Assuming vendorData is an array and we take the first element as the vendor details
            const vendor = vendorData[0];

            $scope.PurreqDtl.Vendor.BusinessName = vendor.BusinessName || "";
            $scope.PurreqDtl.Vendor.CompanyAddress = vendor.CompanyAddress || "";
            $scope.PurreqDtl.Vendor.ContactPerson = vendor.ContactPerson || "";

            // Split the ContactPerson into FirstName and LastName if available
            if (vendor.ContactPerson) {
                const nameParts = vendor.ContactPerson.split(' ');
                $scope.PurreqDtl.Vendor.ContactPersonFirstName = nameParts[0] || "";
                $scope.PurreqDtl.Vendor.ContactPersonLastName = nameParts.slice(1).join(' ') || "";
            } else {
                $scope.PurreqDtl.Vendor.ContactPersonFirstName = "";
                $scope.PurreqDtl.Vendor.ContactPersonLastName = "";
            }
            $scope.PurreqDtl.Vendor.VendorPhoneNumber = vendor.VendorPhoneNumber || "";
            $scope.PurreqDtl.Vendor.GenaralDetailsServices = vendor.GenaralDetailsServices || "";
            $scope.PurreqDtl.Vendor.Email = vendor.VendorEmail || "";
            $scope.PurreqDtl.Vendor.TIN = vendor.TIN || "";
            $scope.PurreqDtl.Vendor.BIN = vendor.BIN || "";
            $scope.PurreqDtl.Vendor.GenaralDetailsServices = vendor.GenaralDetailsServices || "";
            $scope.PurreqDtl.Vendor.UserName = ""; // Default value, assuming it's entered manually
            $scope.PurreqDtl.Vendor.Password = ""; // Default value, assuming it's entered manually
            $scope.PurreqDtl.Vendor.ConfirmPassword = ""; // Default value, assuming it's entered manually
        };



        $scope.updateRegistration = function () {

            var selectedPropID = [];

