    label {
        margin-bottom: 2px;
        font-weight: bold;
        font-size: 12px;
    }

    .form-control {
        height: 25px;
        font-size: smaller;
        padding: 3px 6px 3px;
    }

    .selected-row {
        background-color: #a4f5da !important;
    }

    .select2-container--default .select2-search--inline .select2-search__field {
        width: 100% !important;
        min-width: 200px;
    }

    .col-lg-3 {
        padding-right: 5px;
        padding-left: 30px;
    }

    .btn-table {
        font-size: 12px !important;
        padding: 1px 5px !important;
        line-height: 1 !important;
        height: 20px;
        border-radius: 3px;
    }


    /*@@media (min-width: 768px) {
    #FileUpload1 {
        display: none !important;
    }
}*/

