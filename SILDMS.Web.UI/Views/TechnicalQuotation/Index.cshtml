<div class="box box-primary box-body" ng-controller="TechnicalQuotationCtrl">





    <div class="box-header with-border" style="font-family: Verdana; background: #E4E9E3; color: black; ">
        <i class="fa fa-user"></i>
        <h3 style="font-family: Verdana" class="box-title">Technical Quotation</h3>


        <div class="box-tools pull-right">
            <div class="col-lg-12 pull-right">
                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button type="button" data-ng-click="toggleRefreshTable()" class="btn btn-warning btn-flat pull-right" ng-disabled="btnRefresh"><i class="fa fa-refresh" style="padding-right: 5px"></i>Refresh</button>
                </div>

                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button type="button" data-ng-click="Search()" class="btn btn-flat btn-primary pull-right " ng-disabled="btnSave"><i class="fa fa-search" style="padding-right: 5px"></i>Search</button>
                </div>
                @*<div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                        <button type="button" data-ng-click="submit()" class="btn btn-flat btn-primary pull-right " ng-disabled="btnSave"><i class="fa fa-save" style="padding-right: 5px"></i>Submit</button>
                    </div>*@


            </div>
        </div>
    </div>




    <div class="box-body " style="margin: 1%; padding: 5px 10px 10px 10px;" data-ng-disabled="">
        <div class="row">
            <div class="col-lg-2">
                <div class="form-group">
                    <label for="InvitationNumber">RFQ No :</label>
                </div>
            </div>
            <div class="col-lg-2">
                <div class="form-group">
                    <input id="InvitationNumber" name="InvitationNumber" ng-model="InvitationNumber" readonly class="form-control" autofocus />

                </div>
            </div>

            <div class="col-lg-1">
                <button type="button"
                        ng-show="!fromDashboard && !Quotation"
                        ng-click="InvitationList()"
                        class="form-control">
                    Search
                </button>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-2">
                <div class="form-group">
                    <label for="InvitationSendingPerson">Contact Person </label>
                </div>
            </div>
            <div class="col-lg-3" style="padding-left:15px;">
                <div class="form-group">
                    <input id="InvitationSendingPerson" name="InvitationSendingPerson" ng-model="InvitationSendingPerson" readonly class="form-control" autofocus />

                </div>
            </div>

        </div>
        <div class="row">
            <div class="col-lg-2" ng-if="Quotation">
                <div class="form-group">
                    <label for="QuotationNumber">Quotation No :</label>
                </div>
            </div>
            <div class="col-lg-2" ng-if="Quotation">
                <div class="form-group">
                    <input id="QuotationNumber" name="QuotationNumber" type="text" data-ng-model="Quotation" class="form-control"
                           placeholder="Quotation Number" ng-readonly="true" />
                    @*<div ng-show="masterDataFrm.$submitted || masterDataFrm.UDCode.$touched">
                            <span ng-show="masterDataFrm.UDCode.$error.required" class="label label-danger">Please enter UD Code</span>
                        </div>*@
                </div>
            </div>

        </div>

    </div>



    <div style=" margin: 1%; background-color: #f0f0f0; box-shadow: 2px 2px 5px #888888; padding: 0px 10px 0px 10px;" ng-show="flagToShowMasterTbl">

        <div class="col-sm-12 col-md-12 col-lg-12" style="padding: 11px;">
            <div ng-if="flagToShow" style="text-align:center">
                <h4 style="color:red;">No data available!</h4>
            </div>
            @* Master Table *@
            <div id="PndRecomAndApprovalTable" class="table-responsive" ng-show="!flagToShow">
                @*<h5 style="color:chocolate; font-weight:bold">No of Requisitions: {{prList[0].Row_count}}</h5>*@
                <table id="tableId" st-table="GridDisplayCollection" st-safe-src="MaterialList" class="table table-condensed table-bordered table-striped table-hover pnlView">


                    <thead>
                        <tr style="font-size: 15px;">
                            <th colspan="7" style="text-align: left; font-weight: bold">Material List</th>
                        </tr>
                        <tr style="background-color: #84abc1; color: darkblue; font-size: 13px;">
                            <th style="text-align:center">Material Code</th>
                            <th style="text-align:center">Material Name</th>
                            <th style="text-align: center">RFQ Quantity</th>
                            <th style="text-align:center">RFQ Unit</th>
                            <th style="text-align:center">Documents</th>

                            <th style="text-align:center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr id="rowID" ng-repeat="row in GridDisplayCollection" style="height:20px; font-size:13px;" ng-class="{'selected-row': row.selected}">

                            <td class="col-lg-2 col-md-2 col-sm-2" style="text-align:center">{{formatMaterialCode(row.materialCode)}}</td>
                            <td class="col-lg-4 col-md-4 col-sm-4">{{row.materialName}}</td>
                            <td class="col-lg-2 col-md-2 col-sm-2" style="text-align:right">{{row.MaterialQuantity| number:3}}</td>
                            <td class="col-lg-1 col-md-1 col-sm-1" style="text-align:center">{{row.Unit}}</td>


                            <td class="col-lg-1 col-md-1 col-sm-1 text-center">
                                <button type="button"
                                        class="btn btn-info btn-table"
                                        ng-click="OpenAllDocumentsModal(row)"
                                        ng-show="row.sampleDocId || row.MasterDocumentID">
                                    Details <i class="fa fa-eye"></i>
                                </button>
                            </td>

                            @*<td class="col-lg-2 col-md-2 col-sm-2 text-center">
                                    <button ng-click="DetailItem(row, $index + 1)"
                                            ng-class="{
                                                      'btn btn-success btn-table': row.Action === 'A',
                                                      'btn btn-warning btn-table': row.Action !== 'A'
                                                      }">
                                        {{ row.Action === 'A' ? 'Add' : 'Edit' }}
                                    </button>

                                    <button ng-if="row.TechQuotationItemID"
                                            ng-click="openDeleteModal(row, $index)"
                                            class="btn btn-danger btn-table"
                                            style="margin-left:4px">
                                        Delete
                                    </button>
                                </td>*@


                            <td class="col-lg-2 col-md-2 col-sm-2 text-center">

                                <!-- Add/Edit Button -->
                                <button ng-if="lowestshowstatus == 1"
                                        ng-click="DetailItem(row, $index + 1)"
                                        ng-class="{
    'btn btn-success btn-table': row.Action === 'A',
    'btn btn-warning btn-table': row.Action !== 'A'
}">
                                    {{ row.Action === 'A' ? 'Add' : 'Edit' }}
                                </button>

                                <!-- Delete Button -->
                                <button ng-if="lowestshowstatus == 1 && row.TechQuotationItemID"
                                        ng-click="openDeleteModal(row)"
                                        class="btn btn-danger btn-table"
                                        style="margin-left:4px">
                                    Delete
                                </button>

                                <!-- View Button -->
                                <button ng-if="lowestshowstatus == 0"
                                        ng-click="DetailItem(row, $index + 1)"
                                        class="btn btn-info btn-table">
                                    View
                                </button>

                            </td>


                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="9" class="text-center">
                            </td>
                        </tr>
                    </tfoot>
                </table>



                @*<div class="box-tools pull-right">
                        <button type="button" id="btnRefresh" data-ng-click="fetchfromgoogle()" class="btn btn-warning btn-flat pull-right" ng-disabled="loading"><i class="fa fa-refresh"></i> Fetch from Google</button>
                    </div>*@
            </div>
        </div>
    </div>

    <div style=" margin: 1%; background-color: #f0f0f0; box-shadow: 2px 2px 5px #888888; padding: 0px 10px 0px 10px;" ng-show="TechnicalQuote">

        <!--<div class=" row" style=" margin: 1%;">-->
        @*Technical Quotation of Item {{Material}}*@
        <!--</div>-->

        <div class="row" ng-show="p===1" style="padding:11px; border-radius:10px; border:2px solid #b7ced5; background:#f8f9fa;">
            @*<div class="col-sm-12 col-md-12 col-lg-12" style="padding:11px; margin-left:15px; margin-right:15px;">*@
            <div class="readonly-section"
                 ng-class="{'readonly-mode': lowestshowstatus == 0}">
                <!-- Row 1: Item / Molecule Name & Manufacturer Name -->
                <div class="row">
                    <div class="col-lg-3">
                        <label for="MoleculeName">Item / Molecule Name:<span class="text-danger">*</span></label>
                    </div>
                    <div class="col-lg-3" style="padding-left:0px;">
                        <input id="MoleculeName" type="text" ng-model="TechnicalQuotation.MoleculeName" ng-required="true" class="form-control"
                               placeholder="Material Name" />
                    </div>

                    <div class="col-lg-3">
                        <label for="ManufacturerName">Manufacturer Name:<span class="text-danger">*</span></label>
                    </div>
                    <div class="col-lg-3" style="padding-left:0px;">
                        <input id="ManufacturerName" type="text" ng-model="TechnicalQuotation.Manufacturer" ng-required="true" class="form-control"
                               placeholder="Manufacturer Name" />
                    </div>
                </div>

                <!-- Row 2: Manufacturer Site Address & Supplier Name -->
                <div class="row">
                    <div class="col-lg-3">
                        <label for="ManufacturerAddress">Manufacturer Site Address:</label>
                    </div>
                    <div class="col-lg-3" style="padding-left:0px;">
                        <input id="ManufacturerAddress" type="text" ng-model="TechnicalQuotation.ManufactureAddress"
                               class="form-control" placeholder="Site Address" />
                    </div>

                    <div class="col-lg-3">
                        <label for="SupplierName">Supplier Name:</label>
                    </div>
                    <div class="col-lg-3" style="padding-left:0px;">
                        <input id="SupplierName" type="text" ng-model="TechnicalQuotation.Supplier" class="form-control"
                               placeholder="Supplier Name" />
                    </div>
                </div>

                <!-- Row 3: Currency & R&D Price -->
                <div class="row">
                    <div class="col-lg-3">

                        <label for="Currency">Currency :</label>

                    </div>
                    <div class="col-lg-3" style="padding-left:0px;">

                        <select id="Currency" class="form-control" ng-model="TechnicalQuotation.Currency"
                                ng-options="ItemTypes as ItemTypes.MasterDataValue for ItemTypes in ItemTypeList track by ItemTypes.MasterDataValue " ng-required="true">

                            <option value="" selected style="display: none">-- Select One --</option>


                        </select>


                    </div>

                    <div class="col-lg-3">
                        <label for="RDPrice">R&D Price:</label>
                    </div>
                    <div class="col-lg-3" style="padding-left:0px;">
                        <input id="RDPrice" type="number" ng-model="TechnicalQuotation.RDPrice" class="form-control"
                               ng-blur="checkAndFormat('RDPrice')"
                               placeholder="R&D Price" />
                    </div>
                </div>

                <!-- Row 4: Commercial Price & Price Per / Unit -->
                <div class="row">
                    <div class="col-lg-3">
                        <label for="CommercialPrice">Commercial Price:</label>
                    </div>
                    <div class="col-lg-3" style="padding-left:0px;">
                        <input id="CommercialPrice" type="number" ng-model="TechnicalQuotation.CommercialPrice"
                               ng-blur="checkAndFormat('CommercialPrice')"
                               class="form-control" placeholder="Commercial Price" />
                    </div>

                    <div class="col-lg-3">
                        <label for="PricePer">Price Per Unit:</label>
                    </div>
                    <div class="col-lg-2" style="padding-right:0px;padding-left:0px;">
                        <input id="PricePer" type="number" ng-model="TechnicalQuotation.PricePer" class="form-control"
                               placeholder="1" />
                    </div>

                    @*<div class="col-lg-1">
                            <label for="PriceUnit">Price Unit:</label>
                        </div>*@
                    <div class="col-lg-1" style="padding-left:0px;padding-right:5px;">
                        <select class="form-control" id="PriceUnit"
                                ng-model="TechnicalQuotation.PriceUnit"
                                ng-options="Item.Item_Code as Item.Item_Code for Item in ItemList track by Item.Item_Code">
                        </select>

                    </div>
                </div>

                <!-- Row 5: Minimum Order Qty & Shelf Life -->
                <div class="row">
                    <div class="col-lg-3">
                        <label for="MinOrderQty">Minimum Order Qty:</label>
                    </div>
                    <div class="col-lg-3" style="padding-left:0px;">
                        <input id="MinOrderQty" type="text" style="text-align:right;" ng-model="TechnicalQuotation.MinOrderQty" class="form-control"
                               three-decimals
                               onkeypress="return (event.charCode >= 48 && event.charCode <= 57) || event.charCode == 46"
                               placeholder="Minimum Order Qty" />
                    </div>

                    <div class="col-lg-3">
                        <label for="ShelfLife">Shelf Life:</label>
                    </div>
                    <div class="col-lg-2" style="padding-right: 0px; padding-left: 0px;">

                        <input id="ShelfLife" type="number" ng-model="TechnicalQuotation.ShelfLifeValue" class="form-control"
                               placeholder="Shelf Life" />

                    </div>
                    <div class="col-lg-1" style="padding-left:0px;padding-right:5px;">
                        <select ng-model="TechnicalQuotation.ShelfLifeUnit" class="form-control">
                            <option value="Days">Days</option>
                            <option value="Months">Months</option>
                            <option value="Years">Years</option>
                        </select>
                    </div>
                </div>


                <!-- Row 6: Storage Condition & Reference Customer List -->
                <div class="row">
                    <div class="col-lg-3">
                        <label for="StorageCondition">Storage Condition:</label>
                    </div>
                    <div class="col-lg-3" style="padding-left:0px;">
                        <input id="StorageCondition" type="text" ng-model="TechnicalQuotation.StorageCondition"
                               class="form-control" placeholder="Storage Condition" />
                    </div>

                    <div class="col-lg-3">
                        <label for="ReferenceCustomer">Reference Customer List:</label>
                    </div>
                    <div class="col-lg-3" style="padding-left:0px;">
                        <input id="ReferenceCustomer" type="text" ng-model="TechnicalQuotation.Reference" class="form-control"
                               placeholder="Reference Customer List" />
                    </div>
                </div>

                <!-- Row 7: Notes, CAS No, Catalogue No -->
                <div class="row">
                    <div class="col-lg-3">
                        <label for="Notes">Notes:</label>
                    </div>
                    <div class="col-lg-3" style="padding-left:0px;">
                        <input id="Notes" type="text" ng-model="TechnicalQuotation.Notes" class="form-control" placeholder="Notes" />
                    </div>




                </div>

                <div class="row mt-3">
                    <div class="col-lg-12">
                        <button type="button" class="btn btn-link"
                                ng-click="showOptional = !showOptional">
                            {{ showOptional ? 'Hide Additional Details' : 'Show Additional Details' }}
                        </button>
                    </div>
                </div>

                <div ng-show="showOptional">



                    <div class="row">
                        <div class="col-lg-3">
                            <label for="CASNo">CAS No:</label>
                        </div>
                        <div class="col-lg-3" style="padding-left:0px;">
                            <input id="CASNo" type="text" ng-model="TechnicalQuotation.CASNO" class="form-control" placeholder="CAS No" />
                        </div>

                        <div class="col-lg-3">
                            <label for="CatalogueNo">Catalogue No:</label>
                        </div>

                        <div class="col-lg-3" style="padding-left:0px;">
                            <input id="CatalogueNo" type="text" ng-model="TechnicalQuotation.CatalogueNo" class="form-control"
                                   placeholder="Catalogue No" />
                        </div>
                    </div>

                    <!-- Row 8: Production Lead Time -->
                    <div class="row">
                        <div class="col-lg-3">
                            <label for="ProductionLeadTime">Production Lead Time:</label>
                        </div>
                        <div class="col-lg-2" style="padding-right: 0px; padding-left: 0px;">

                            <input id="ProductionLeadTime" type="number" ng-model="TechnicalQuotation.ProductionLeadTimeValue"
                                   class="form-control" placeholder="Lead Time" />

                        </div>
                        <div class="col-lg-1" style="padding-left:0px;padding-right:5px;">
                            <select ng-model="TechnicalQuotation.ProductionLeadTimeUnit" class="form-control">
                                <option value="Days">Days</option>
                                <option value="Months">Months</option>
                                <option value="Years">Years</option>
                            </select>
                        </div>


                        <div class="col-lg-3">
                            <label for="CommercialPackSize">Commercial Pack Size:</label>
                        </div>
                        <div class="col-lg-3" style="padding-left:0px;">
                            <input id="CommercialPackSize" type="text" ng-model="TechnicalQuotation.CommercialPackSize"
                                   class="form-control" placeholder="Commercial Pack Size" />
                        </div>



                    </div>

                    <!-- Row 9: Commercial & Minimum Pack Size -->
                    <div class="row">

                        <div class="col-lg-3">
                            <label for="MinPackSize">Minimum Pack Size:</label>
                        </div>
                        <div class="col-lg-3" style="padding-left:0px;">
                            <input id="MinPackSize" type="text" ng-model="TechnicalQuotation.MinPack" class="form-control"
                                   placeholder="Minimum Pack Size" />
                        </div>

                        <div class="col-lg-3">
                            <label for="RepresentativeSample">Representative Sample:</label>
                        </div>
                        <div class="col-lg-3" style="padding-left:0px;">
                            <select id="RepresentativeSample" ng-model="TechnicalQuotation.RepresentativeSample"
                                    ng-change="showRepresentativeOther = (TechnicalQuotation.RepresentativeSample === 'Other')"
                                    class="form-control">
                                <option value="">--Select--</option>
                                <option value="Yes">Yes</option>
                                <option value="No">No</option>
                                <option value="Other">Other</option>
                            </select>
                            <input type="text" ng-show="showRepresentativeOther"
                                   ng-model="TechnicalQuotation.RepresentativeSampleOther" class="form-control"
                                   placeholder="Specify Other" style="margin-top:5px;" />
                        </div>
                    </div>

                    <!-- Row 10: Representative Sample -->
                    <!-- Row 11: Current Production Status & Production Capacity -->
                    <div class="row">
                        <div class="col-lg-3"><label>Representative Sample Pack Size:</label></div>
                        <div class="col-lg-3" style="padding-left:0px;">
                            <input type="text" class="form-control"
                                   ng-model="TechnicalQuotation.RepresentativeSamplePackSize">
                        </div>


                        <div class="col-lg-3">
                            <label for="CurrentProductionStatus">Current Production Status:</label>
                        </div>
                        <div class="col-lg-3" style="padding-left:0px;">
                            <select id="CurrentProductionStatus"
                                    ng-model="TechnicalQuotation.CurrentStatus"
                                    class="form-control">
                                <option value="">--Select--</option>
                                <option value="Commercialized">Commercialized</option>
                                <option value="Under Validation">Under Validation</option>
                                <option value="R&D Stage">R&D Stage</option>
                                <option value="Wish List">Wish List</option>
                            </select>
                        </div>






                    </div>
                    <div class="row">

                        <div class="col-lg-3">
                            <label for="ProductionCapacity">Production Capacity:</label>
                        </div>
                        <div class="col-lg-3" style="padding-left:0px;">
                            <input id="ProductionCapacity" type="text" ng-model="TechnicalQuotation.ProdCapacity" class="form-control"
                                   placeholder="Capacity" />
                        </div>

                        <div class="col-lg-3">
                            <label for="ProductionFrequency">Production Frequency:</label>
                        </div>
                        <div class="col-lg-3" style="padding-left:0px;">
                            <select id="ProductionFrequency" ng-model="TechnicalQuotation.ProductionFrequency" class="form-control">
                                <option value="">--Select--</option>
                                <option value="Campaign">Campaign</option>
                                <option value="Regular">Regular</option>
                            </select>
                        </div>
                    </div>

                    <!-- Row 12: Pharmacopeial Reference & Regulatory Approval -->
                    <div class="row">
                        <div class="col-lg-3">
                            <label for="PharmacopeialReference">Pharmacopeial Reference:</label>
                        </div>

                        <div class="col-lg-3" style="padding-left:0px;">
                            <select ui-select2="{ allowClear: true }"
                                    id="PharmacopeialReference"
                                    multiple
                                    ng-model="TechnicalQuotation.PharmacopeialReference"
                                    data-placeholder="Pharmacopeial Reference"
                                    style="width:100%; min-width: 200px;"
                                    class="form-control"
                                    ng-options="ref.value as ref.label for ref in pharmacopeialReferenceList">
                            </select>
                        </div>

                        <div class="col-lg-3">
                            <label for="RegulatoryApproval">Regulatory Approval:</label>
                        </div>
                        <div class="col-lg-3" style="padding-left:0px;">
                            <select id="RegulatoryApproval" ng-model="TechnicalQuotation.RegulatoryApproval"
                                    ng-change="showRegulatoryOther = (TechnicalQuotation.RegulatoryApproval === 'OTHER')"
                                    class="form-control">

                                <option value="">--Select--</option>
                                <option value="FDA">US FDA</option>
                                <option value="CEP">CEP</option>
                                <option value="OTHER">Other</option>
                            </select>
                            <input type="text" ng-show="showRegulatoryOther" ng-model="TechnicalQuotation.RegulatoryApprovalOther"
                                   class="form-control" placeholder="Specify Other" style="margin-top:5px;" />
                        </div>
                    </div>

                    <!-- Row 13: Column Specification -->
                    <div class="row">
                        <div class="col-lg-3">
                            <label for="ColumnSpecification">Column Specification:</label>
                        </div>
                        <div class="col-lg-3" style="padding-left:0px;">
                            <input id="ColumnSpecification" type="text" ng-model="TechnicalQuotation.ColumnSpecification"
                                   class="form-control" placeholder="Column Specification" />
                        </div>
                    </div>




                </div>

            </div>
            <br />
            <div class="btn-group pull-right" style=" margin-right: 5px;">
                <button type="submit" id="btnSubmit1" ng-if="MaterialInvitation.TechQuotationItemID!='' && lowestshowstatus == 1" ng-click=" Update()" class="btn btn-primary btn-flat">Update Quotation</button>
                <button type="submit" id="btnSubmit" ng-if="MaterialInvitation.TechQuotationItemID=='' && lowestshowstatus == 1" ng-click=" Post()" class="btn btn-primary btn-flat">Save Quotation</button>
            </div>
        </div>







        <div class="row" ng-show="p===2" style="padding:11px; border-radius:10px; border:2px solid #b7ced5; background:#f8f9fa;">
