        $scope.UpdateDocument = function () {
            if ($scope.loading) {
                return $q.reject('already-in-progress');
            }

            var fileUpload = document.getElementById("FileUpload1");
            if (!fileUpload.files || fileUpload.files.length === 0) {
                toastr.warning("Please select a file.");
                return $q.reject('no-file');
            }

            $scope.loading = true;
            var validFiles = Array.from(fileUpload.files);
            var extensions = validFiles.map(function (f) {
                return f.name.split('.').pop().toLowerCase();
            });

            function uploadFile(file, ext) {
                var deferred = $q.defer();
                var fileData = new FormData();
                fileData.append('serverIP', $scope.Server.ServerIP);
                fileData.append('ftpPort', $scope.Server.ServerPort);
                fileData.append('ftpUserName', $scope.Server.FtpUserName);
                fileData.append('ftpPassword', $scope.Server.FtpPassword);
                fileData.append('serverURL', $scope.Server.FileServerURL);
                fileData.append('documentID', $scope.Server.DocumentID);
                fileData.append('Ext', ext);
                fileData.append(file.name, file);

                $.ajax({
                    url: '/VendorSelectionModule/TechnicalQuotation/UploadOtherFiles',
                    type: "POST",
                    contentType: false,
                    processData: false,
                    data: fileData
                }).done(function (result) {
                    $timeout(function () {
                        if (!result || result.ResponseCode !== "S201") {
                            deferred.reject(result);
                        } else {
                            deferred.resolve(result);
                        }
                    });
                }).fail(function (err) {
                    $timeout(function () {
                        deferred.reject(err);
                    });
                });

                return deferred.promise;
            }

            function uploadOne(index) {
                if (index >= validFiles.length) {
                    return $http.post('/VendorSelectionModule/TechnicalQuotation/UpdateExtensionByDocId', {
                        DocumentID: $scope.MaterialInvitation.SampleDocumentID,
                        Extension: extensions.join(',')
                    }).then(function (response) {
                        if (response.data && response.data.respStatus && response.data.respStatus.Message) {
                            $scope.Server.Extensions = extensions.join(',');
                            document.getElementById("FileUpload1").value = "";
                            toastr.success("Document Updated Successfully");
                        } else {
                            toastr.error("Document Update Failed");
                            return $q.reject("extension-update-failed");
                        }
                    }).catch(function (err) {
                        console.error(err);
                        toastr.error("Failed to update document record");
                        return $q.reject(err);
                    });
                }

                var file = validFiles[index];
                var ext = extensions[index];
                return uploadFile(file, ext).then(function () {
                    return uploadOne(index + 1);
                });
            }

            // IMPORTANT: return this promise so callers can chain after it finishes
            return uploadOne(0)
                .catch(function (err) {
                    console.error('Upload error:', err);
                    toastr.error("Document Upload Failed");
                    return $q.reject(err);   // re-reject so $scope.Update knows it failed
                })
                .finally(function () {
                    $scope.loading = false;
                });
        };




