        $scope.FormatDigits = function (txtVendor, lmt) {
            if (!IsPositiveNumber($("#" + txtVendor).val())) {
                $("#" + txtVendor).val('');
            }
            else if (isNaN($("#" + txtVendor).val())) {
                $("#" + txtVendor).val('');
            }
            else {
                var d = $("#" + txtVendor).val().split('.');
                if ((d[0].length > (lmt - 0))) {
                    $("#" + txtVendor).val("");
                    $("#btnSaveDoc").prop("disabled", true);
                    return;
                }
                else {
                    $("#btnSaveDoc").prop("disabled", false);
                    $("#" + txtVendor).val(($("#" + txtVendor).val() - 0).toFixed(3));
                }
            }

        }


