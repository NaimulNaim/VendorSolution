        $scope.openFileViewer = function (documentID, ext) {
            ext = (ext || '').replace(/^\./, '').toLowerCase();

            var imageExts = ['jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp'];
            var videoExts = ['mp4', 'webm', 'ogg'];
            var audioExts = ['mp3', 'wav', 'ogg'];

            if (ext === 'pdf') $scope.ViewerType = 'pdf';
            else if (imageExts.indexOf(ext) !== -1) $scope.ViewerType = 'image';
            else if (videoExts.indexOf(ext) !== -1) $scope.ViewerType = 'video';
            else if (audioExts.indexOf(ext) !== -1) $scope.ViewerType = 'audio';
            else $scope.ViewerType = 'download';

            $scope.ViewerFileName = documentID + '.' + ext;
            $scope.ViewerUrl = '/VendorSelectionModule/TechnicalQuotation/DownloadDocument'
                + '?documentID=' + documentID
                + '&Ext=' + ext;

            $('#FileViewerModal').modal('show');
        };

