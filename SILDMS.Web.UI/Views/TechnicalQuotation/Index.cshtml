            (function () {
                var ENDPOINTS = {
                    byDocumentID: '/VendorSelectionModule/FinancialQuotation/GetDocumentsByDocumentID',
                    view: '/VendorSelectionModule/FinancialQuotation/ViewDocument',
                    download: '/VendorSelectionModule/FinancialQuotation/DownloadDocument'
                };

                function decorateDocuments(documents) {
                    return (documents || []).map(function (doc) {
                        var ext = (doc.FileExtension || '').toLowerCase();
                        var isMp4 = ext === '.mp4' || ext === 'mp4';
                        var isPdf = ext === '.pdf' || ext === 'pdf';
                        var isImage = ['.jpg', 'jpg', '.jpeg', 'jpeg', '.png', 'png'].indexOf(ext) !== -1;
                        return {
                            documentID: doc.DocumentID,
                            fileName: doc.FileOriginalName,
                            fileExtension: ext,
                            canView: !isMp4,
                            isPdf: isPdf,
                            isImage: isImage,
                            // "inline-renderable" = the browser can actually display it in
                            // an <iframe>/<img> (pdf, images). Everything else that isn't
                            // mp4 still gets a View button, but View just opens/downloads
                            // via whatever the OS has associated with that file type.
                            isInlineRenderable: isPdf || isImage,
                            viewUrl: ENDPOINTS.view + '?documentID=' + encodeURIComponent(doc.DocumentID),
                            downloadUrl: ENDPOINTS.download + '?documentID=' + encodeURIComponent(doc.DocumentID) +
                                '&fileName=' + encodeURIComponent(doc.FileOriginalName || 'Document')
                        };
                    });
                }

                function fetchGroup(documentID) {
                    if (!documentID) {
                        // No anchor id for this section on this row -> nothing to show,
                        // skip the call entirely rather than hitting the server for nothing.
                        return $q.when({ data: { success: true, documents: [] } });
                    }
                    return $http.post(ENDPOINTS.byDocumentID, { documentID: documentID });
                }

                $scope.OpenAllDocumentsModal = function (row) {
                    $scope.loading = true;

                    // row.MasterDocumentID and row.sampleDocId are each just one
                    // DocumentID belonging to their respective group — the server
                    // derives the rest (BillReceiveID/BillTrackingNo) from that alone.
                    var masterPromise = fetchGroup(row.MasterDocumentID);
                    var materialPromise = fetchGroup(row.sampleDocId);

                    $q.all([masterPromise, materialPromise]).then(function (results) {
                        var masterRes = results[0].data;
                        var materialRes = results[1].data;

                        $scope.AllDocSections = [
                            {
                                title: 'Overall Documents',
                                documents: decorateDocuments(masterRes.success ? masterRes.documents : [])
                            },
                            {
                                title: 'Material Documents',
                                documents: decorateDocuments(materialRes.success ? materialRes.documents : [])
                            }
                        ];

                        $scope.loading = false;
                        $('#AllDocumentsViewModal').modal('show');
                    }, function () {
                        $scope.loading = false;
                        toastr.error('Failed to load documents.');
                    });
                };

                $scope.ViewDocumentFile = function (doc) {
                    $scope.PreviewDoc = doc;
                    // $sce.trustAsResourceUrl is required — Angular blocks binding
                    // ng-src on an iframe to a same-origin-but-dynamic URL otherwise.
                    $scope.PreviewTrustedUrl = $sce.trustAsResourceUrl(doc.viewUrl);
                    $('#DocumentPreviewModal').modal('show');
                };

                $scope.DownloadDocumentFile = function (doc) {
                    window.open(doc.downloadUrl, '_blank');
                };
            })();






        $scope.deleteAttachedDocument = function () {
            if (!confirm('Are you sure you want to delete the attached document?')) return;

            $scope.loading = true;

            $http.post('/VendorSelectionModule/TechnicalQuotation/DeleteDocument', {
                documentID: $scope.MaterialInvitation.SampleDocumentID
            })
                .success(function (response) {
                    $scope.loading = false;

                    if (response.Success) {
                        // Clear local references
                        $scope.MaterialInvitation.SampleDocumentID = '';
                        $scope.TechnicalQuotation.SampleDocumentID = '';
                        $scope.IsDownload = false;
                        $scope.Server.Extensions = '';

                        // Reset file input so it doesn't re-submit the old file
                        var $el = $('#FileUpload1');
                        $el.wrap('<form>').closest('form').get(0).reset();
                        $el.unwrap();

                        toastr.success(response.respStatus.Message || 'Document deleted successfully');
                    } else {
                        toastr.error(response.respStatus.Message || 'Delete failed');
                    }
                })
                .error(function () {
                    $scope.loading = false;
                    toastr.error('Error occurred while deleting the document');
                });
        };





