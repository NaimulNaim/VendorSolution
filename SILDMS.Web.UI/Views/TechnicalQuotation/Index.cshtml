        $scope.Post = function () {

            if ($scope.loading) {
                return; // already in-flight, ignore extra clicks
            }

            var DocIDsCounter = 0;

            if ($scope.TechnicalQuotation.Techtype === 'SPARES') {
                var yearOfManufacturing = $('#YearOfManufacturing').val();
                if (yearOfManufacturing) {
                    $scope.TechnicalQuotation.YearOfManufacturing =
                        $scope.formatDate(yearOfManufacturing);
                }
                if ($("#ItemName").val() == "") {
                    toastr.error("ItemName is required.");
                    return;
                }
                if ($("#ManufacturerName").val() == "") {
                    toastr.error("Manufacturer Name is required.");
                    return;
                }
            }
            else {
                if ($scope.TechnicalQuotation.PharmacopeialReference) {
                    $scope.TechnicalQuotation.AllPharmacopeialReference = $scope.TechnicalQuotation.PharmacopeialReference.join(',');
                }
                if ($("#MoleculeName").val() == "") {
                    toastr.error("MoleculeName is required.");
                    return;
                }
                if ($("#ManufacturerName").val() == "") {
                    toastr.error("Manufacturer Name is required.");
                    return;
                }
            }

            // Moved outside both branches so BOTH SPARES and non-SPARES materials
            // correctly lock the button — previously only the non-SPARES branch set this.
            $scope.loading = true;

            $timeout(function () {
                $scope.TechnicalQuotation.rowIndex = $scope.MaterialInvitation.rowIndex;
                $scope.TechnicalQuotation.Proposal = $scope.proposal;
                $scope.TechnicalQuotation.techtype = $scope.techtype;
                console.log('TechnicalQuotation:', $scope.TechnicalQuotation);

                var hasUploadedFiles = $("#FileUpload1").get(0).files.length > 0;

                if (!$scope.TechnicalQuotation.SampleDocumentID) {
                    if (!hasUploadedFiles) {
                        console.log('No documents found, submitting quotation directly...');
                        $scope.submit();
                        $scope.p = 0;
                        return;
                    }
                    console.log('Documents found, saving document first...');
                    $scope.SaveTechnicalDocumentAndSubmit();
                }
                else {
                    console.log('Document ID exists, submitting directly...');
                    $scope.submit();
                    $scope.p = 0;
                }
            }, 0);
        };



