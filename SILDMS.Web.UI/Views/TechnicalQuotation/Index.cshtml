        $scope.SaveTechnicalDocumentAndSubmit = function () {
            var fileUpload = $("#FileUpload1").get(0);
            var files = fileUpload.files;
            var validFiles = [];
            var extensions = [];
            angular.forEach(files, function (file) {
                validFiles.push(file);
                extensions.push(file.name.split('.').pop().toLowerCase());
            });
            if (validFiles.length === 0) {
                $scope.loading = false;
                toastr.error("There are no documents.");
                return;
            }
            $scope.BillReceiveModel.Extensions = extensions.join(',');
            $http.post('/VendorSelectionModule/TechnicalQuotation/AddDocumentInfo', {
                _modelDocumentsInfo: $scope.BillReceiveModel
            }).then(function (response) {
                if (response.data.ResponseCode !== "S201") {
                    toastr.error("Failed to save document information");
                    $scope.loading = false; // was a silent dead-end — button stayed stuck disabled
                    return;
                }
                var doc = response.data.DistinctID[0];
                $scope.TechnicalQuotation.SampleDocumentID = doc.BillReceiveID;
                $scope.myarray.push($scope.MaterialInvitation);
                $scope.myarray2.push($scope.TechnicalQuotation);
                var uploadCount = 0;
                angular.forEach(validFiles, function (file) {
                    var fileData = new FormData();
                    fileData.append('serverIP', doc.ServerIP);
                    fileData.append('ftpPort', doc.ServerPort);
                    fileData.append('ftpUserName', doc.FtpUserName);
                    fileData.append('ftpPassword', doc.FtpPassword);
                    fileData.append('serverURL', doc.FileServerUrl);
                    fileData.append('documentID', doc.DocumentID);
                    fileData.append('Ext', file.name.split('.').pop().toLowerCase());
                    fileData.append(file.name, file);
                    $.ajax({
                        url: '/VendorSelectionModule/TechnicalQuotation/UploadOtherFiles',
                        type: "POST",
                        contentType: false,
                        processData: false,
                        data: fileData,
                        success: function () {
                            uploadCount++;
                            if (uploadCount === validFiles.length) {
                                toastr.success("Files uploaded successfully");
                                var $el = $('#FileUpload1');
                                $el.wrap('<form>').closest('form').get(0).reset();
                                $el.unwrap();
                                $scope.submit(); // submit() now owns resetting loading from here
                                $scope.p = 0;
                            }
                        },
                        error: function (err) {
                            toastr.error("File upload failed");
                            console.error('Upload error:', err);
                            $scope.loading = false; // was missing — button stayed stuck disabled
                            $scope.$apply(); // $.ajax runs outside Angular's digest cycle
                        }
                    });
                });
            }, function (error) {
                console.error('Error sending document info', error);
                toastr.error("Failed to save document information");
                $scope.loading = false; // was missing — button stayed stuck disabled
            });
        };




