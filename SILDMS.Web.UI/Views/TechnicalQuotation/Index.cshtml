                <div class="modal-body" style="min-height:500px">

                    <!-- PDF -->
                    <div ng-if="ViewerType === 'pdf'">
                        <iframe ng-src="{{ViewerUrl | trustAsResourceUrl}}"
                                width="100%" height="600px" style="border:none">
                        </iframe>
                    </div>

                    <!-- Image -->
                    <div ng-if="ViewerType === 'image'" style="text-align:center">
                        <img ng-src="{{ViewerUrl | trustAsResourceUrl}}"
                             style="max-width:100%;max-height:600px" />
                    </div>

                    <!-- Video -->
                    <div ng-if="ViewerType === 'video'">
                        <video controls style="width:100%"
                               ng-src="{{ViewerUrl | trustAsResourceUrl}}">
                        </video>
                    </div>

                    <!-- Audio -->
                    <div ng-if="ViewerType === 'audio'" style="padding:40px 0;text-align:center">
                        <audio controls ng-src="{{ViewerUrl | trustAsResourceUrl}}"></audio>
                    </div>

                    <!-- Unsupported — download only -->
                    <div ng-if="ViewerType === 'download'"
                         style="padding:60px 0;text-align:center">
                        <p>This file type cannot be previewed in the browser.</p>
                        <a class="btn btn-warning" ng-href="{{ViewerUrl}}">Download {{ViewerFileName}}</a>
                    </div>

                </div>

                <div class="modal-footer">
                    <a class="btn btn-warning" ng-href="{{ViewerUrl}}">Download</a>
                    <button class="btn btn-default" data-dismiss="modal"
                            ng-click="closeFileViewer()">
                        Close
                    </button>
                </div>

            </div>
        </div>
    </div>



