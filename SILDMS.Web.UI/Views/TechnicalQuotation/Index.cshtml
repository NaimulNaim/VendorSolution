        $scope.toggleQuotationSelect = function (InvitationNumber, quotationNo, RFQDeadline) {

            $scope.RFQDeadline = RFQDeadline;


            var parts = $scope.RFQDeadline.split('/');

            // dd/MM/yyyy
            var deadlineDate = new Date(
                parseInt(parts[2]),     // year
                parseInt(parts[1]) - 1, // month (0-based)
                parseInt(parts[0])      // day
            );
            // Convert both dates to Date objects

            var currentDate = new Date();

            // Optional: remove time part if you only want date comparison
            deadlineDate.setHours(0, 0, 0, 0);
            currentDate.setHours(0, 0, 0, 0);

            // Set status
            $scope.lowestshowstatus = deadlineDate >= currentDate ? 1 : 0;
            $scope.loading = true;                     // show loader if needed
            $scope.Quotation = quotationNo;
            $scope.InvitationNumber = InvitationNumber;

            $http.post('/VendorSelectionModule/TechnicalQuotation/QuotWiseMaterial', {
                QuotationNo: quotationNo
            }).then(function (res) {

                // Defensive: ensure response exists
                var data = res.data && res.data.AllQuotation ? res.data.AllQuotation : [];

                $scope.MaterialList = data;
                $scope.GridDisplayCollection = [].concat(data);

                // Flags for UI
                $scope.flagToShow = data.length === 0;     // true if no data
                $scope.flagToShowMasterTbl = true;        // always show the container

                // Only hide modal AFTER Angular updates the table DOM
                $timeout(function () {
                    angular.element('#QuotationModal').modal('hide');
                }, 0);

            }).catch(function () {
                toastr.error('Data Loading Failed.');
            }).finally(function () {
                $scope.loading = false;
            });
        };



