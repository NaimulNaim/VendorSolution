

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<style type="text/css">
    label {
        margin-bottom: 2px;
        font-weight: bold;
        font-size: 12px;
    }

    .form-control {
        height: 25px;
        font-size: smaller;
        padding: 3px 6px 3px;
    }

    .selected-row {
        background-color: #a4f5da !important;
    }

</style>

<div class="box box-primary box-body" ng-controller="TechnicalQuotationCtrl">





    <div class="box-header with-border" style="font-family: Verdana; background: #E4E9E3; color: black; ">
        <i class="fa fa-user"></i>
        <h3 style="font-family: Verdana" class="box-title">Technical Quotation</h3>


        <div class="box-tools pull-right">
            <div class="col-lg-12 pull-right">
                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button type="button" data-ng-click="toggleRefreshTable()" class="btn btn-warning btn-flat pull-right" ng-disabled="btnRefresh"><i class="fa fa-refresh" style="padding-right: 5px"></i>Refresh</button>
                </div>

                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button type="button" data-ng-click="Search()" class="btn btn-flat btn-primary pull-right " ng-disabled="btnSave"><i class="fa fa-search" style="padding-right: 5px"></i>Search</button>
                </div>
                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button type="button" data-ng-click="submit()" class="btn btn-flat btn-primary pull-right " ng-disabled="btnSave"><i class="fa fa-save" style="padding-right: 5px"></i>Submit</button>
                </div>


            </div>
        </div>
    </div>




    <div class="box-body " style="margin: 1%; padding: 5px 10px 10px 10px;" data-ng-disabled="">
        <div class="row">
            <div class="col-lg-3 ">
                <div class="form-group">
                    <label for="InvitationNumber">RFQ Number :</label>
                </div>
            </div>
            <div class="col-lg-2">
                <div class="form-group">
                    <input id="InvitationNumber" name="InvitationNumber" ng-model="InvitationNumber" readonly class="form-control" autofocus />

                </div>
            </div>

            <div class="col-lg-1">
                <button type="button" ng-show="!fromDashboard" ng-if="!Quotation" ng-click="InvitationList()" class="form-control">Search</button>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-3 " ng-if="Quotation">
                <div class="form-group">
                    <label for="QuotationNumber">Quotation Number :</label>
                </div>
            </div>
            <div class="col-lg-2" ng-if="Quotation">
                <div class="form-group">
                    <input id="QuotationNumber" name="QuotationNumber" type="text" data-ng-model="Quotation" class="form-control"
                           placeholder="Quotation Number" ng-readonly="true" />
                    @*<div ng-show="masterDataFrm.$submitted || masterDataFrm.UDCode.$touched">
                            <span ng-show="masterDataFrm.UDCode.$error.required" class="label label-danger">Please enter UD Code</span>
                        </div>*@
                </div>
            </div>

        </div>

    </div>



    <div style=" margin: 1%; background-color: #f0f0f0; box-shadow: 2px 2px 5px #888888; padding: 0px 10px 0px 10px;" ng-show="flagToShowMasterTbl">
        <div class="row">
            <div class="col-sm-12 col-md-12 col-lg-12" style="padding: 11px;">
                <div ng-if="flagToShow" style="text-align:center">
                    <h4 style="color:red;">No data available!</h4>
                </div>
                @* Master Table *@
                <div id="PndRecomAndApprovalTable" class="table-responsive" ng-if="!flagToShow">
                    @*<h5 style="color:chocolate; font-weight:bold">No of Requisitions: {{prList[0].Row_count}}</h5>*@
                    <table id="tableId" style="width:100%;" st-table="GridDisplayCollection" st-safe-src="MaterialList" class="table table-condensed table-bordered table-striped table-hover pnlView">
                        <thead>
                            <tr style="font-size: 15px;">
                                <th colspan="7" style="text-align: left; font-weight: bold">Material List</th>
                            </tr>
                            <tr style="background-color: #84abc1; color: darkblue; font-size: 13px;">
                                <th>Material Code</th>
                                <th>Material Name</th>
                                <th style="text-align:right">Quantity</th>
                                <th>Unit</th>
                                <th>Documents</th>
                                <th>Type</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr id="rowID" ng-repeat="row in GridDisplayCollection" style="height:20px; font-size:13px;" ng-class="{'selected-row': row.selected}">

                                <td class="col-lg-1 col-md-1 col-sm-1">{{formatMaterialCode(row.materialCode)}}</td>
                                <td class="col-lg-6 col-md-6 col-sm-6">{{row.materialName}}</td>
                                <td class="col-lg-1 col-md-1 col-sm-1" style="text-align:right">{{row.MaterialQuantity| number:3}}</td>
                                <td class="col-lg-1 col-md-1 col-sm-1">{{row.Unit}}</td>
                                <td class="col-lg-1 col-md-1 col-sm-1">
                                    <button type="button" class="button-detail" ng-click="AddDocument(row)" data-dismiss="modal" title="Show detail">Details <i class="fa fa-eye"></i></button>
                                </td>


                                <td class="col-lg-1 col-md-1 col-sm-1">{{row.MatInvType}}</td>


                                <td class="col-lg-1 col-md-1 col-sm-1">
                                    <button ng-click="DetailItem(row,$index+1)">
                                        {{ row.Action === 'A' ? 'Add' : 'Edit' }}
                                    </button>

                                </td>

                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="9" class="text-center">
                                </td>
                            </tr>
                        </tfoot>
                    </table>



                    @*<div class="box-tools pull-right">
                            <button type="button" id="btnRefresh" data-ng-click="fetchfromgoogle()" class="btn btn-warning btn-flat pull-right" ng-disabled="loading"><i class="fa fa-refresh"></i> Fetch from Google</button>
                        </div>*@


                </div>
            </div>
        </div>
    </div>

    <div style=" margin: 1%; background-color: #f0f0f0; box-shadow: 2px 2px 5px #888888; padding: 0px 10px 0px 10px;" ng-show="TechnicalQuote">

        <div class=" row" style=" margin: 1%;">
            @*Technical Quotation of Item {{Material}}*@
        </div>

        <div class="row" ng-if="p===1" @*style="background: #9ebdc7; padding: 11px; border-radius: 10px; border: 2px solid #b7ced5; "*@>
            <div class="col-sm-12 col-md-12 col-lg-12" style="padding: 11px; margin-right: 15px; margin-left: 15px;">

                <div class="row">

                    <div class="col-lg-3 ">
                        <div class="form-group">
                            <label for="MoleculeName">Molecule Name :</label>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="form-group">
                            <input id="MoleculeName" name="MoleculeName" type="text" ng-model="TechnicalQuotation.MoleculeName" class="form-control"
                                   placeholder="Molecule Name" />

                        </div>
                    </div>


                    <div class="col-lg-2">
                        <div class="form-group">
                            <label for="Sample">Representative Sample :</label>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="form-group">

                            <input type="radio" ng-model="TechnicalQuotation.sampleAvailable" ng-value="'yes'"> Yes
                            <input type="radio" ng-model="TechnicalQuotation.sampleAvailable" ng-value="'no'"> No
                            <input type="radio" ng-model="TechnicalQuotation.sampleAvailable" ng-value="'other'"> Other<br>
                            @*<input type="text" ng-show="sampleAvailable === 'other'" ng-model="otherSample" placeholder="Specify Other">*@


                        </div>
                    </div>
                    @*<div class="col-lg-3">
                            gfg
                        </div>*@
                    <!--<div class="col-lg-3">
                        <div class="form-group" ng-show="TechnicalQuotation.sampleAvailable === 'other'">
                            <input type="text" class="form-control" ng-model="TechnicalQuotation.otherSample" placeholder="Specify Other">
                        </div>
                    </div>-->



                </div>

                <div class="row">

                    <div class="col-lg-3">
                        <div class="form-group">
                            <label for="CASNO">CAS No :</label>
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <input id="CASNO" name="CASNO" type="text" ng-model="TechnicalQuotation.CASNO" class="form-control"
                               placeholder="CAS No" />

                    </div>




                    <div class="col-lg-2">
                        <div class="form-group">
                            <label for="RepresentativePackSize">Representative Sample Pack Size :</label>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="form-group">
                            <input id="RepresentativePackSize" name="RepresentativePackSize" type="text" data-ng-model="TechnicalQuotation.RepresentativePackSize" class="form-control"
                                   placeholder="Representative Pack" />

                        </div>
                    </div>




                </div>

                <div class="row">

                    <div class="col-lg-3">
                        <div class="form-group">
                            <label for="Manufacturer">Manufacturer :</label>
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <input id="Manufacturer" name="Manufacturer" type="text" ng-model="TechnicalQuotation.Manufacturer" class="form-control"
                               placeholder="Manufacturer" />

                    </div>







                    <div class="col-lg-2">
                        <div class="form-group">
                            <label for="Regulatory">Production Regularity :</label>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="form-group">

                            <input type="radio" ng-model="TechnicalQuotation.regulatory" ng-value="'rx'"> Campaign based product
                            <input type="radio" ng-model="TechnicalQuotation.regulatory" ng-value="'ry'"> Regular product

                            @*<input type="text" ng-show="sampleAvailable === 'other'" ng-model="otherSample" placeholder="Specify Other">*@



                        </div>
                    </div>







                </div>

                <div class="row">
                    <div class="col-lg-3">
                        <div class="form-group">
                            <label for="Supplier">Supplier :</label>
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <input id="Supplier" name="Supplier" type="text" data-ng-model="TechnicalQuotation.Supplier" class="form-control"
                               placeholder="Supplier" />

                    </div>


                    <div class="col-lg-2 ">
                        <div class="form-group">
                            <label for="CurrentStatus">Current API Status :</label>
                        </div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">


                            <select id="CurrentStatus" class="form-control" ng-model="TechnicalQuotation.CurrentStatus"
                                    ng-options="option.value as option.label for option in statusOptions">
                                <option value="" style="display: none;">--Select--</option>
                                @*<option value="ZNB Manual PR">ZNB Manual PR</option>*@

                            </select>

                        </div>
                    </div>


                </div>
                <div class="row">
                    <div class="col-lg-3">
                        <div class="form-group">
                            <label for="ManufactureAddress">Manufacturing Site Address :</label>
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <input id="ManufactureAddress" name="ManufactureAddress" type="text" data-ng-model="TechnicalQuotation.ManufactureAddress" class="form-control"
                               placeholder="Manufacturer Address" />

                    </div>


                    <div class="col-lg-2">
                        <div class="form-group">
                            <label for="ProdCapacity">Production Capacity :</label>
                        </div>
                    </div>

                    <div class="col-lg-2">
                        <input id="ProdCapacity" name="ProdCapacity" data-ng-model="TechnicalQuotation.ProdCapacity" class="form-control"
                               type="number" placeholder="0.00" min="0.01" onblur="CheckPositive('ProdCapacity'); FormatDigit('ProdCapacity', '13'); " autofocus />

                    </div>




                </div>

                <div class="row">
                    <div class="col-lg-3">
                        <div class="form-group">
                            <label for="RDPrice">R&D Price Offer :</label>
                        </div>
                    </div>

                    <div class="col-lg-2">
                        <input id="RDPrice" name="RDPrice" data-ng-model="TechnicalQuotation.RDPrice" class="form-control"
                               type="number" placeholder="0.000" min="0.001" ng-blur="checkAndFormat('RDPrice')" autofocus />

                    </div>
                    <div class="col-lg-1">
                        <div class="form-group">
                            <select id="RNDPriceCur" class="form-control" ng-model="TechnicalQuotation.RNDPriceCur"
                                    ng-options="ItemTypes as ItemTypes.MasterDataValue for ItemTypes in ItemTypeList track by ItemTypes.MasterDataValue " ng-required="true" style="height: 26px; font-size:smaller">

                                <option value="" selected style="display: none">--</option>


                            </select>

                        </div>
                    </div>

                    <div class="col-lg-2">
                        <div class="form-group">
                            <label for="Shelf">Shelf Life :</label>
                        </div>
                    </div>

                    <div class="col-lg-2">
                        <input id="Shelf" name="Shelf" data-ng-model="TechnicalQuotation.Shelf" class="form-control"
                               type="number" placeholder="0.00" min="0.01" onblur="CheckPositive('Shelf'); FormatDigit('ProdCapacity', '13'); " autofocus />

                    </div>

                    <div class="col-lg-1">
                        <div class="form-group">
                            <select id="ShelfUnit" class="form-control" ng-model="TechnicalQuotation.ShelfUnit"
                                    ng-options="allshelf.value as allshelf.label for allshelf in allshelfunit" ng-required="true" style="height: 26px; font-size:smaller">
                                <option value="" selected style="display: none"> --</option>


                            </select>

                        </div>
                    </div>




                </div>

                <div class="row">
                    <div class="col-lg-3">
                        <div class="form-group">
                            <label for="CommercialPrice">Commercial Price :</label>
                        </div>
                    </div>

                    <div class="col-lg-2">
                        <input id="CommercialPrice" name="CommercialPrice" data-ng-model="TechnicalQuotation.CommercialPrice" class="form-control"
                               type="number" placeholder="0.00" min="0.01" ng-blur="checkAndFormat('CommercialPrice')" autofocus />

                    </div>
                    <div class="col-lg-1">
                        <div class="form-group">
                            <select id="ComPriceCur" class="form-control" ng-model="TechnicalQuotation.ComPriceCur"
                                    ng-options="ItemTypes as ItemTypes.MasterDataValue for ItemTypes in ItemTypeList track by ItemTypes.MasterDataValue " ng-required="true" style="height: 26px; font-size:smaller">

                                <option value="" selected style="display: none">---</option>


                            </select>

                        </div>
                    </div>


                    <div class="col-lg-2">
                        <div class="form-group">
                            <label for="Condition">Storage Condition :</label>
                        </div>
                    </div>

                    <div class="col-lg-2">
                        <input id="Condition" name="Condition" type="text" data-ng-model="TechnicalQuotation.Condition" class="form-control"
                               placeholder="Condition" />

                    </div>



                </div>

                <div class="row">
                    <div class="col-lg-3">
                        <div class="form-group">
                            <label for="OrderQty">Minimum Order Qty :</label>
                        </div>
                    </div>
                    <div class="col-lg-2">

                        <input id="OrderQty" name="OrderQty" data-ng-model="TechnicalQuotation.OrderQty" class="form-control"
                               type="number" placeholder="0.00" min="0.01" ng-blur="checkAndFormat('OrderQty')" autofocus />



                    </div>
                    <div class="col-lg-1">




                        <select id="Item" name="Item" ng-model="TechnicalQuotation.OrderQtyUnit" class="form-control" autofocus
                                ng-options="Item as Item.Item_Code for Item in ItemList track by Item.Item_Code" style="padding:1px;">
                            <option value="" style="display: none;">---</option>
                        </select>




                    </div>

                    <div class="col-lg-2 ">
                        <div class="form-group">
                            <label for="Specification">Specification Complies :</label>
                        </div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <select id="Specification" class="form-control" ng-model="TechnicalQuotation.Specification"
                                    ng-options="option.value as option.label for option in specificComplies">
                                <option value="" style="display: none;">--Select--</option>

                            </select>

                        </div>
                    </div>
                    <br />
                    <div class="col-lg-2" ng-if="TechnicalQuotation.Specification === 'other'">
                        <div class="form-group">
                            <input type="text" class="form-control" ng-model="TechnicalQuotation.OtherSpecification" placeholder="Specify Other">
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-3">
                        <div class="form-group">
                            <label for="CommercialConsignment">Lead Time for Commercial Consignment :</label>
                        </div>
                    </div>
                    <div class="col-lg-3">

                        <input id="CommercialConsignment" name="CommercialConsignment" data-ng-model="TechnicalQuotation.CommercialConsignment" class="form-control"
                               type="number" placeholder="0.000" min="0.001" ng-blur="checkAndFormat('CommercialConsignment')" @*onblur="CheckPositive('CommercialConsignment'); FormatDigit('CommercialConsignment', '13'); "*@ autofocus />




                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <label for="Currency">Currency :</label>
                        </div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <select id="Currency" class="form-control" ng-model="TechnicalQuotation.Currency"
                                    ng-options="ItemTypes as ItemTypes.MasterDataValue for ItemTypes in ItemTypeList track by ItemTypes.MasterDataValue " ng-required="true" style="height: 26px; font-size:smaller">

                                <option value="" selected style="display: none">-- Select One --</option>


                            </select>

                        </div>
                    </div>


                </div>

                <div class="row">
                    <div class="col-lg-3">
                        <div class="form-group">
                            <label for="AvailPackSize">Available Commercial Pack Size :</label>
                        </div>
                    </div>
                    <div class="col-lg-3">

                        <input id="AvailPackSize" name="AvailPackSize" ng-model="TechnicalQuotation.AvailPackSize" class="form-control"
                               type="number" placeholder="0.00" min="0.01" onblur="CheckPositive('AvailPackSize'); FormatDigit('AvailPackSize', '13'); " autofocus />



                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <label for="Reference">Reference :</label>
                        </div>
                    </div>
                    <div class="col-lg-2">
                        <input id="Reference" name="Reference" type="text" ng-model="TechnicalQuotation.Reference" class="form-control"
                               placeholder="Reference" />

                    </div>



                </div>


                <div class="row">
                    <div class="col-lg-3">
                        <div class="form-group">
                            <label for="MinPack">Minimum Pack Size :</label>
                        </div>
                    </div>
                    <div class="col-lg-3">

                        <input id="MinPack" name="MinPack" data-ng-model="TechnicalQuotation.MinPack" class="form-control"
                               type="number" placeholder="0.00" min="0.01" onblur="CheckPositive('MinPack'); FormatDigit('MinPack', '13'); " autofocus />



                    </div>


                    <div class="col-lg-2 ">
                        <div class="form-group">
                            <label for="Specification">API Regulatory Approval :</label>
                        </div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <select id="Specification" class="form-control" ng-model="TechnicalQuotation.APIRegApproval"
                                    ng-options="option.value as option.label for option in allAPIRegApproval">
                                <option value="" style="display: none;">--Select--</option>

                            </select>

                        </div>
                    </div>

                </div>



                <div class="row">
                    <div class="col-lg-3">
                        <div class="form-group">
                            <label for="Example">Remarks :</label>
                        </div>
                    </div>

                    <div class="col-lg-7">
                        <input id="Example" name="Example" type="text" data-ng-model="TechnicalQuotation.Example" class="form-control"
                               placeholder="Remarks" />

                    </div>


                </div>
            </div>

        </div>




        <div class="row" ng-if="p===2" @*style="background: #9ebdc7; padding: 11px; border-radius: 10px; border: 2px solid #b7ced5; "*@>
            <div class="col-sm-12 col-md-12 col-lg-12" style="padding: 11px; margin-right: 15px; margin-left: 15px;">

                <div class="row">

                    <div class="col-lg-3 ">
                        <div class="form-group">
                            <label for="ManufacturerPart">Manufacturer Part No :</label>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="form-group">
                            <input id="ManufacturerPart" name="ManufacturerPart" type="text" ng-model="TechnicalQuotation.ManufacturerPart" class="form-control"
                                   placeholder="Manufacturer Part" />

                        </div>
                    </div>

                    <div class="col-lg-2 ">
                        <div class="form-group">
                            <label for="Installation">Installation,Testing & Commissioning :</label>
                        </div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <input id="Installation" name="Installation" type="text" ng-model="TechnicalQuotation.Installation" class="form-control"
                                   placeholder=" " />

                        </div>
                    </div>

                </div>

                <div class="row">

                    <div class="col-lg-3">
                        <div class="form-group">
                            <label for="Manufacturer">Manufacturer :</label>
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <input id="Manufacturer" name="Manufacturer" type="text" ng-model="TechnicalQuotation.Manufacturer" class="form-control"
                               placeholder="Manufacturer" />

                    </div>



                    <div class="col-lg-2">
                        <div class="form-group">
                            <label for="Subcontractor">Subcontractor :</label>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="form-group">

                            <input type="radio" ng-model="TechnicalQuotation.Subcontractor" ng-value="'Yes'"> Yes
                            <input type="radio" ng-model="TechnicalQuotation.Subcontractor" ng-value="'No'"> No

                            @*<input type="text" ng-show="sampleAvailable === 'other'" ng-model="otherSample" placeholder="Specify Other">*@



                        </div>
                    </div>




                </div>

                <div class="row">

                    <div class="col-lg-3">
                        <div class="form-group">
                            <label for="ManufacturerOrigin">Manufacturer Origin :</label>
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <input id="ManufacturerOrigin" name="ManufacturerOrigin" type="text" ng-model="TechnicalQuotation.ManufacturerOrigin" class="form-control"
                               placeholder="Manufacturer Origin" />

                    </div>




                    <div class="col-lg-2">
                        <div class="form-group">
                            <label for="Reference">Reference :</label>
                        </div>
                    </div>
                    <div class="col-lg-2">
                        <input id="Reference" name="Reference" type="text" ng-model="TechnicalQuotation.Reference" class="form-control"
                               placeholder="Reference" />

                    </div>






                </div>

                <div class="row">

                    <div class="col-lg-3">
                        <div class="form-group">
                            <label for="LocalPartner">Local Partner :</label>
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <input id="LocalPartner" name="LocalPartner" type="text" ng-model="TechnicalQuotation.LocalPartner" class="form-control"
                               placeholder="Local Partner " />

                    </div>


                </div>








                <div class="row">
                    <div class="col-lg-3">
                        <div class="form-group">
                            <label for="Prerequisite">Prerequisite/Assistance At Site :</label>
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <input id="Prerequisite" name="Prerequisite" type="text" ng-model="TechnicalQuotation.Prerequisite" class="form-control"
                               placeholder="Prerequisite " />

                    </div>


                    <div class="col-lg-2 ">
                        <div class="form-group">
                            <label for="Penalty">Penalty Clause :</label>
