        $scope.Post = function () {


            var DocIDsCounter = 0;

            $scope.TechnicalQuotation.rowIndex = $scope.MaterialInvitation.rowIndex;
            for (var i = 0; i < $scope.GridDisplayCollection.length; i++) {
                if ($scope.GridDisplayCollection[i].materialCode === $scope.MaterialInvitation.materialCode) {
                    $scope.GridDisplayCollection[i].Action = 'E';
                }
            }

            if ($scope.p === 2) {
                $scope.TechnicalQuotation.Alldocuments = $scope.TechnicalQuotation.Document.join(',');
            }
            console.log($scope.TechnicalQuotation);


            if (!$scope.MaterialInvitation.SampleDocumentID) {
                var fileUpload = $("#FileUpload1").get(0);
                var files = fileUpload.files;
                var validFiles = [];
                var extensions = [];
                var concatenatedExtensions = "";
                console.log(files);
                // Process files and filter out PDF files
                if (files.length > 0) {
                    angular.forEach(files, function (file) {
                        var ext = file.name.split('.').pop().toLowerCase();

                        validFiles.push(file);
                        extensions.push(ext);

                    });

                    if (validFiles.length === 0) {
                        alert('No valid files to upload.');
                        return;
                    }

                    // Concatenate extensions

                    concatenatedExtensions = extensions.join(',');
                    concatenatedExtensions = extensions.join(',') + ',.pdf';
                }
                else {
                    concatenatedExtensions = '.pdf';
                }

                $scope.BillReceiveModel.Extensions = concatenatedExtensions;


                // Send model to server to get upload information
                if (concatenatedExtensions === '.pdf') {
                    if (dwObject.HowManyImagesInBuffer === 0) {
                        $scope.loading = false;
                        toastr.error("There are no  documents.");
                        return;
                    }
                }



                $http.post('/VendorSelectionModule/TechnicalQuotation/AddDocumentInfo',
