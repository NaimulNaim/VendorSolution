        $scope.DeleteItem = function (deleterow, deleteindex) {

            if (!deleterow || !deleterow.TechQuotationItemID) return; // safety

            $("#btnSaveDoc").prop("disabled", true);

            $http.post('/VendorSelectionModule/TechnicalQuotation/DeleteTechquot',
                { TechQuotationItemID: deleterow.TechQuotationItemID })
                .then(function (response) {
                    var data = response.data;

                    if (data && data.Success) {
                        // ✅ show success message
                        toastr.success(data.respStatus.Message || 'Deleted successfully');

                        // Delay table refresh so user can see the toast
                        setTimeout(function () {
                            $scope.$apply(function () {
                                $scope.toggleRefreshTable();
                            });
                        }, 1000);

                        // remove row from UI


                    } else {
                        // ❌ show error message
                        alert((data && data.respStatus ? data.respStatus.Message : '') || 'Delete failed.');
                    }

