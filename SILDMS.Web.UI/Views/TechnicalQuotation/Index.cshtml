    app.directive('threeDecimals', function () {
        return {
            require: 'ngModel',
            link: function (scope, element, attrs, ngModelController) {
                // Remove the $parsers that convert to number
                // Let the model value stay as string

                ngModelController.$formatters.push(function (modelValue) {
                    if (modelValue === null || modelValue === undefined || modelValue === '') {
                        return '';
                    }
                    // Convert to number, format, then return as string
                    var num = parseFloat(modelValue);
                    return isNaN(num) ? modelValue : num.toFixed(3);
                });

                element.on('blur', function () {
                    var value = element.val();
                    if (value !== '') {
                        var num = parseFloat(value);
                        if (!isNaN(num)) {
                            var formatted = num.toFixed(3);
                            element.val(formatted);
                            ngModelController.$setViewValue(formatted);
                            ngModelController.$render();
                        }
                    }
                });
            }
        };
    });

