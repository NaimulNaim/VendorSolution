        $scope.FormatDigits = function (txtVendor, lmt) {

            var val = $("#" + txtVendor).val();

            // empty or non-numeric → reject
            if (val === '' || isNaN(val)) {
                $("#" + txtVendor).val('');
                $("#btnSaveDoc").prop("disabled", true);
                return;
            }

            val = Number(val);

            // negative numbers → reject (0 allowed)
            if (val < 0) {
                $("#" + txtVendor).val('');
                $("#btnSaveDoc").prop("disabled", true);
                return;
            }

            var d = val.toString().split('.');
            if (d[0].length > lmt) {
                $("#" + txtVendor).val('');
                $("#btnSaveDoc").prop("disabled", true);
                return;
            }

            // valid: includes 0
            $("#btnSaveDoc").prop("disabled", false);
            $("#" + txtVendor).val(val.toFixed(2));
        };





