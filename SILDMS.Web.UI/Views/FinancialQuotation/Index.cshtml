

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<style type="text/css">
    label {
        margin-bottom: 2px;
        font-weight: bold;
        font-size: 12px;
    }

    .form-control {
        height: 25px;
        font-size: smaller;
        padding: 3px 6px 3px;
    }

    .selected-row {
        background-color: #a4f5da !important;
    }
</style>

<div class="box box-primary box-body" ng-controller="FinancialQuotationCtrl">




    @*<i class="fa fa-user"></i>
            <h3 style="font-family: Verdana" class="box-title" ng-if="fromMenu">Purchase Requisition Wise Materials Assign from Menu</h3>
            <h3 style="font-family: Verdana" class="box-title" ng-if="!fromMenu">Purchase Requisition Wise Materials Assign from Dashboard</h3>
            <div class="box-tools pull-right">
                <button type="button" id="btnRefresh" data-ng-click="toggleRefreshTable(row)" class="btn btn-warning btn-flat pull-right" ng-disabled="loading"><i class="fa fa-refresh"></i> Refresh</button>
            </div>
        </div>*@















    <div class="box-header with-border" style="font-family: Verdana; background: #E4E9E3; color: black; ">
        <i class="fa fa-user"></i>
        <h3 style="font-family: Verdana" class="box-title">Financial Quotation</h3>


        <div class="box-tools pull-right">
            <div class="col-lg-12 pull-right">
                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button type="button" data-ng-click="Refresh()" class="btn btn-warning btn-flat pull-right" ng-disabled="btnRefresh"><i class="fa fa-refresh" style="padding-right: 5px"></i>Refresh</button>
                </div>

                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button type="button" data-ng-click="Search()" class="btn btn-flat btn-primary pull-right " ng-disabled="btnSave"><i class="fa fa-search" style="padding-right: 5px"></i>Search</button>
                </div>
                @*<div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                        <button type="button" data-ng-click="submit()" class="btn btn-flat btn-primary pull-right " ng-disabled="btnSave"><i class="fa fa-save" style="padding-right: 5px"></i>Submit</button>
                    </div>*@


            </div>
        </div>
    </div>




    <div class="box-body " style="margin: 1%; padding: 5px 10px 10px 10px;" data-ng-disabled="">
        <div class="row">
            <div class="col-lg-2">
                <div class="form-group">
                    <label for="InvitationNumber">RFQ No :</label>
                </div>
            </div>
            <div class="col-lg-2">
                <div class="form-group">
                    <input id="InvitationNumber" name="InvitationNumber" ng-model="InvitationNumber" readonly class="form-control" autofocus />

                </div>
            </div>

            <div class="col-lg-1">
                <button type="button"
                        ng-show="!fromDashboard && !Quotation"
                        ng-click="InvitationList()"
                        class="form-control">
                    Search
                </button>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-2" ng-if="Quotation">
                <div class="form-group">
                    <label for="QuotationNumber">Quotation No :</label>
                </div>
            </div>
            <div class="col-lg-2" ng-if="Quotation">
                <div class="form-group">
                    <input id="QuotationNumber" name="QuotationNumber" type="text" data-ng-model="Quotation" class="form-control"
                           placeholder="Quotation No" ng-readonly="true" />
                    @*<div ng-show="masterDataFrm.$submitted || masterDataFrm.UDCode.$touched">
                            <span ng-show="masterDataFrm.UDCode.$error.required" class="label label-danger">Please enter UD Code</span>
                        </div>*@
                </div>
            </div>

        </div>

    </div>



    <div style=" margin: 1%; background-color: #f0f0f0; box-shadow: 2px 2px 5px #888888; padding: 0px 10px 0px 10px;" ng-show="flagToShowMasterTbl">
        <div class="row">
            <div class="col-sm-12 col-md-12 col-lg-12" style="padding: 11px;">
                <div ng-if="flagToShow" style="text-align:center">
                    <h4 style="color:red;">No data available!</h4>
                </div>
                @* Master Table *@
                <div id="PndRecomAndApprovalTable" class="table-responsive" ng-if="!flagToShow">
                    @*<h5 style="color:chocolate; font-weight:bold">No of Requisitions: {{prList[0].Row_count}}</h5>*@
                    <table id="tableId" st-table="GridDisplayCollection" st-safe-src="MaterialList" class="table table-condensed table-bordered table-striped table-hover pnlView">
                        <thead>
                            <tr style="font-size: 15px;">
                                <th colspan="7" style="text-align: left;font-weight: bold">Material List</th>
                            </tr>
                            <tr style="background-color: #84abc1; color: darkblue; font-size: 13px;">
                                <th style="text-align:center">Material Code</th>
                                <th style="text-align:center">Material Name</th>
                                <th style="text-align:center">RFQ Quantity</th>
                                <th style="text-align:center">RFQ Unit</th>
                                <th style="text-align:center">Documents</th>
                                @*<th style="text-align:center">Type</th>*@
                                <th style="text-align:center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr id="rowID" ng-repeat="row in GridDisplayCollection" style="height:20px; font-size:13px;" ng-class="{'selected-row': row.selected}">
                                <td class="col-lg-2 col-md-2 col-sm-2" style="text-align:center">{{formatMaterialCode(row.materialCode)}}</td>
                                <td class="col-lg-4 col-md-4 col-sm-4">{{row.materialName}}</td>
                                <td class="col-lg-2 col-md-2 col-sm-2" style="text-align:right">{{row.MaterialQuantity| number:3}}</td>
                                <td class="col-lg-1 col-md-1 col-sm-1" style="text-align:center">{{row.Unit}}</td>
                                <td class="col-lg-1 col-md-1 col-sm-1 text-center">
                                    <button type="button"
                                            class="button-detail"
                                            ng-click="AddDocument(row)"
                                            data-dismiss="modal"
                                            title="Show detail"
                                            ng-show="row.sampleDocId">
                                        Details <i class="fa fa-eye"></i>
                                    </button>
                                </td>


                                @*<td class="col-lg-1 col-md-1 col-sm-1" style="text-align:center">{{row.Fintype}}</td>*@


                                <td class="col-lg-2 col-md-2 col-sm-2" style="text-align:center">
                                    <button ng-click="DetailItem(row)"
                                            ng-class="{
    'btn btn-success': row.Action === 'A',
    'btn btn-warning': row.Action !== 'A'
}">
                                        {{ row.Action === 'A' ? 'Add' : 'Edit' }}
                                    </button>
                                    <button ng-if="row.FinanQuotationItemID"
                                            ng-click="openDeleteModal(row)"
                                            class="btn btn-danger btn-sm"
                                            style="margin-left:5px">
                                        Delete
                                    </button>


                                </td>


                                @*<td class="col-lg-1 col-md-1 col-sm-1" style="text-align:center">
                                        <button ng-click="DetailItem(row)">
                                            {{ row.Action === 'A' ? 'Add' : 'Edit' }}
                                        </button>

                                    </td>*@

                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="9" class="text-center">
                                </td>
                            </tr>
                        </tfoot>
                    </table>



                    @*<div class="box-tools pull-right">
                            <button type="button" id="btnRefresh" data-ng-click="fetchfromgoogle()" class="btn btn-warning btn-flat pull-right" ng-disabled="loading"><i class="fa fa-refresh"></i> Fetch from Google</button>
                        </div>*@


                </div>
            </div>
        </div>
    </div>

    <div style=" margin: 1%; background-color: #f0f0f0; box-shadow: 2px 2px 5px #888888; padding: 0px 10px 0px 10px;" ng-show="TechnicalQuote">

        <div class=" row" style=" margin: 1%;">
            @*Technical Quotation of Item {{Material}}*@
        </div>

        <div class="row" ng-show="p===1" @*style="background: #9ebdc7; padding: 11px; border-radius: 10px; border: 2px solid #b7ced5; "*@>
            <div class="row" ng-show="p===1" style="padding:11px; border-radius:10px; border:2px solid #b7ced5; background:#f8f9fa;">
                <div class="col-sm-12 col-md-12 col-lg-12" style="padding:11px; margin:0 15px;">

                    <!-- Row 1: Supplier / Local Agent / Currency -->
                    <div class="row">
                        <div class="col-lg-3"><label>Supplier Name:</label></div>
                        <div class="col-lg-3"><input type="text" class="form-control" ng-model="FinancialQuotationDetail.SupplierName" /></div>

                        <div class="col-lg-3"><label>Local Agent Name:</label></div>
                        <div class="col-lg-3"><input type="text" class="form-control" ng-model="FinancialQuotationDetail.LocalAgentName" /></div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-lg-3"><label>Currency:<span class="text-danger">*</span></label></div>
                        <div class="col-lg-3">
                            <select id="Currency" class="form-control" ng-model="FinancialQuotationDetail.Currency"
                                    ng-options="ItemTypes as ItemTypes.MasterDataValue for ItemTypes in ItemTypeList track by ItemTypes.MasterDataValue " ng-required="true" style="height: 26px; font-size:smaller">

                                <option value="" selected style="display: none">-- Select One --</option>


                            </select>
                        </div>
                    </div>

                    <!-- Row 2: Price, Per, Price Unit -->
                    <div class="row mt-2">
                        <div class="col-lg-3"><label>Price: <span class="text-danger">*</span></label></div>
                        <div class="col-lg-3">
                            <input type="number"
                                   id="price"
                                   class="form-control"
                                   ng-model="FinancialQuotationDetail.Price"
                                   ng-blur="checkAndFormat('price')">
                        </div>

                        <div class="col-lg-1"><label>Per:<span class="text-danger">*</span></label></div>
                        <div class="col-lg-1"><input type="number" class="form-control" ng-model="FinancialQuotationDetail.Per" min="0.01" /></div>
                        <div class="col-lg-1"></div>
                        <div class="col-lg-2"><label>Price Unit:<span class="text-danger">*</span></label></div>
                        <div class="col-lg-1">
                            <select class="form-control" id="ItemName" ng-model="FinancialQuotationDetail.PriceUnit"
                                      ng-options="i as i.Item_Code for i in ItemList track by i.Item_Code">
                                  
                                <option value="" style="display:none">---</option>
                            </select>
                        </div>
                    </div>


                    <!-- Row 3: Taxes / Freight -->
                    <div class="row mt-2">

                        <div class="col-lg-3"><label>Taxes</label></div>
                        <div class="col-lg-3">
                            <select class="form-control"
                                    ng-model="FinancialQuotationDetail.Tax">
                                <option value="">--Select--</option>
                                <option value="Included">Included</option>
                                <option value="Excluded">Excluded</option>
                            </select>
                        </div>
                        <div class="col-lg-3"><label>Freight:</label></div>
                        <div class="col-lg-2" style="padding-right:0px;">
                            <input type="number" class="form-control" id="Freight" ng-model="FinancialQuotationDetail.Freight"
                                   ng-blur="checkAndFormat('Freight')" />
                        </div>
                        <div class="col-lg-1" style="padding-left:0px;">
                            <select class="form-control" ng-model="FinancialQuotationDetail.FreightPer">
                                <option value="P">%</option>
                                <option value="A">Amount</option>
                            </select>
                        </div>
                    </div>

                    <!-- Row 4: RFQ Qty / RFQ Qty Unit / Quotation Qty / Quotation Qty Unit -->


                    <div class="row mt-2">
                        <div class="col-lg-3"><label>Quotation Qty:<span class="text-danger">*</span></label></div>
                        @*<div class="col-lg-3"><input type="number" class="form-control" ng-model="FinancialQuotationDetail.QuotationQty" min="0.01" /></div>*@
                        <div class="col-lg-3">
                            <input type="text"
                                   class="form-control text-right"
                                   ng-model="FinancialQuotationDetail.QuotationQty"
                                   three-decimals
                                   onkeypress="return (event.charCode >= 48 && event.charCode <= 57) || event.charCode == 46">
                        </div>


                        <div class="col-lg-3"><label>Quotation Qty Unit:<span class="text-danger">*</span></label></div>
                        <div class="col-lg-3">
                            <select class="form-control" ng-model="FinancialQuotationDetail.QuotationQtyUnit"
                                      ng-options="i as i.Item_Code for i in ItemList track by i.Item_Code">
                                <option value="" style="display:none">---</option>
                            </select>
                        </div>
                    </div>

                    <!-- Row 5: Delivery Timeline / Incoterms / Incoterms Location / Shipment Mode / Payment Mode -->
                    <div class="row mt-2">
                        <div class="col-lg-3"><label>Delivery Timeline:<span class="text-danger">*</span></label></div>
                        <div class="col-lg-3"><input type="text" class="form-control DatePicker" id="DeliveryTimeline1" ng-model="FinancialQuotationDetail.DeliveryTimeline" placeholder="DD/MM/YYYY" /></div>

                        <div class="col-lg-3"><label>Incoterms:</label></div>
                        <div class="col-lg-3">
                            <select class="form-control" ng-model="FinancialQuotationDetail.Incoterms"
                                    ng-options="i.MasterDataValue for i in IncotermsList track by i.MasterDataValue">
                                <option value="" style="display:none">---</option>
                            </select>
                        </div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-lg-3"><label>Incoterms Location:<span class="text-danger">*</span></label></div>
                        <div class="col-lg-3">
                            <select class="form-control" ng-model="FinancialQuotationDetail.IncotermsLocation"
                                    ng-options="i.MasterDataValue for i in IncotermsLocationList track by i.MasterDataValue">
                                <option value="" style="display:none">---</option>
                            </select>
                        </div>

                        <div class="col-lg-3"><label>Shipment Mode:<span class="text-danger">*</span></label></div>
                        <div class="col-lg-3">

                            <select class="form-control" ng-model="FinancialQuotationDetail.ShipmentMode">
                                <option value="">--Select--</option>
                                <option value="AIR">Air</option>
                                <option value="SEA">Sea</option>
                                <option value="ROAD">Road</option>
                                <option value="TRAIN">Train</option>
                                <option value="MAIL">Mail</option>
                                <option value="AIR/SEA">Air/Sea</option>
                                <option value="AIR/ROAD">Air/Road</option>
                                <option value="AIR/TRAIN">Air/Train</option>
                                <option value="AIR/SEA/ROAD">Air/Sea/Road</option>
                                <option value="AIR/SEA/ROAD/TRAIN">Air/Sea/Road/Train</option>
                                <option value="SEA/ROAD">Sea/Road</option>
                                <option value="SEA/TRAIN">Sea/Train</option>
                                <option value="ROAD/TRAIN">Road/Train</option>


                            </select>

                        </div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-lg-3"><label>Payment Mode:<span class="text-danger">*</span></label></div>
                        <div class="col-lg-3">
                            <select class="form-control" ng-model="FinancialQuotationDetail.PaymentMode"
                                    ng-options="p.MasterDataValue for p in PaymentModeList track by p.MasterDataValue">
                                <option value="" style="display:none">---</option>
                            </select>
                        </div>
                    </div>

                    <!-- Row 6: Quotation Validity / Qty Tolerance / Part Delivery -->
                    <div class="row mt-2">
                        <div class="col-lg-3"><label>Quotation Validity:</label></div>
                        <div class="col-lg-3"><input type="text" class="form-control DatePicker" id="QuotationValidity1" ng-model="FinancialQuotationDetail.QuotationValidity" placeholder="DD/MM/YYYY" /></div>

                        <div class="col-lg-3"><label>Qty Tolerance (%):</label></div>
                        <div class="col-lg-3"><input type="number" class="form-control" id="QtyTolerance" ng-model="FinancialQuotationDetail.QtyTolerance" min="0" ng-blur="checkAndFormat('QtyTolerance')"/></div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-lg-3"><label>Part Delivery:</label></div>
                        <div class="col-lg-3">
                            <select class="form-control" ng-model="FinancialQuotationDetail.PartDelivery">
                                <option value="" style="display:none">--Select--</option>
                                <option value="Y">Allowed</option>
                                <option value="N">Not Allowed</option>
                            </select>
                        </div>
                    </div>

                    <!-- Row 7: Manufacturer / Site / Discount / Charges -->
                    <div class="row mt-2">
                        <div class="col-lg-3"><label>Manufacturer Name:</label></div>
                        <div class="col-lg-3"><input type="text" class="form-control" ng-model="FinancialQuotationDetail.ManufacturerName" /></div>

                        <div class="col-lg-3"><label>Manufacturer Part No:</label></div>
                        <div class="col-lg-3"><input type="text" class="form-control" ng-model="FinancialQuotationDetail.ManufacturerPartNo" /></div>


                    </div>

                    <div class="row mt-2">
                        <div class="col-lg-3"><label>Manufacturer Site Address:</label></div>
                        <div class="col-lg-3"><input type="text" class="form-control" ng-model="FinancialQuotationDetail.ManufacturerSiteAddress" /></div>


                    </div>
                    <div class="row mt-3">
                        <div class="col-lg-12">
                            <button type="button" class="btn btn-link"
                                    ng-click="showOptional = !showOptional">
                                {{ showOptional ? 'Hide Additional Details' : 'Show Additional Details' }}
                            </button>
                        </div>
                    </div>
                    <div ng-show="showOptional">
                        <div class="row mt-2">
                            <div class="col-lg-3"><label>Discount:</label></div>
                            <div class="col-lg-2"><input type="number" class="form-control" id="Discount" ng-model="FinancialQuotationDetail.Discount" min="0.01"  ng-blur="checkAndFormat('Discount')"/></div>
                            <div class="col-lg-1" style="padding-left:0px;">
                                <select class="form-control" ng-model="FinancialQuotationDetail.DiscountPer">
                                    <option value="P">%</option>
                                    <option value="A">Amount</option>
                                </select>
                            </div>
                            <div class="col-lg-2"><label>Order Handling Charges:</label></div>
                            <div class="col-lg-1"><input type="number" id="OrderHandlingCharges"  class="form-control" ng-model="FinancialQuotationDetail.OrderHandlingCharges"  ng-blur="checkAndFormat('OrderHandlingCharges')"/></div>

                            <div class="col-lg-2"><label>Packing Charges:</label></div>
                            <div class="col-lg-1"><input type="number" class="form-control" id="PackingCharges" ng-model="FinancialQuotationDetail.PackingCharges" ng-blur="checkAndFormat('PackingCharges')" /></div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-lg-3"><label>Sundry Charges:</label></div>
                            <div class="col-lg-3"><input type="number" class="form-control" id="SundryCharges" ng-model="FinancialQuotationDetail.SundryCharges" ng-blur="checkAndFormat('SundryCharges')" /></div>

                            <div class="col-lg-3"><label>Pack Size:</label></div>
                            <div class="col-lg-3"><input type="text" class="form-control" ng-model="FinancialQuotationDetail.PackSize" /></div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-lg-3"><label>Minimum Order Qty:</label></div>
                            <div class="col-lg-3"><input type="text" class="form-control" ng-model="FinancialQuotationDetail.MinimumOrderQty"
                                                          three-decimals
 onkeypress="return (event.charCode >= 48 && event.charCode <= 57) || event.charCode == 46"/></div>

                            <div class="col-lg-3"><label>Warranty:</label></div>
                            <div class="col-lg-3"><input type="text" class="form-control" ng-model="FinancialQuotationDetail.Warranty" /></div>
                        </div>

                        <!-- Row 8: Installation / Servicing / Inland Transportation -->
                        <div class="row mt-2">
                            <div class="col-lg-3"><label>Installation:</label></div>
                            <div class="col-lg-3"><input type="text" class="form-control" ng-model="FinancialQuotationDetail.Installation" /></div>


                            <div class="col-lg-3"><label>Servicing</label></div>
                            <div class="col-lg-3">
                                <select class="form-control" ng-model="FinancialQuotationDetail.Servicing">
                                    <option value="" style="display:none">--Select--</option>
                                    <option value="Y">Yes</option>
                                    <option value="N">No</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-lg-3"><label>Inland Transportation:</label></div>
                            <div class="col-lg-3"><input type="text" class="form-control" ng-model="FinancialQuotationDetail.InlandTransportation" /></div>
                        </div>

                        <!-- Row 9: Key Customer List / Subcontractor / Returnable Item -->
                        <div class="row mt-2">
                            <div class="col-lg-3">
                                <label>Subcontractor</label>
                            </div>

                            <div class="col-lg-3">
                                <select class="form-control"
                                        ng-model="FinancialQuotationDetail.Subcontractor"
                                        ng-init="FinancialQuotationDetail.Subcontractor = 'No'">
                                    <option value="Yes">Yes</option>
                                    <option value="No">No</option>
                                </select>
                            </div>

                            <!-- Appears only when Yes -->
                            <div class="col-lg-6" ng-if="FinancialQuotationDetail.Subcontractor === 'Yes'">
                                <input type="text"
                                       class="form-control"
                                       ng-model="FinancialQuotationDetail.SubcontractorDetails"
                                       placeholder="Enter subcontractor details">
                            </div>
                        </div>


                        <div class="row mt-2">
                            <div class="col-lg-3"><label>Returnable Item:</label></div>
                            <div class="col-lg-3">
                                <select class="form-control" ng-model="FinancialQuotationDetail.ReturnableItem">
                                    <option value="" style="display:none">--Select--</option>
                                    <option value="Y">Yes</option>
                                    <option value="N">No</option>

                                </select>
                            </div>
                        </div>

                        <!-- Row 10: Penalty Clause / Remarks / Variance Note -->
                        <div class="row mt-2">
                            <div class="col-lg-3"><label>Penalty Clause:</label></div>
                            <div class="col-lg-3"><input type="text" class="form-control" ng-model="FinancialQuotationDetail.PenaltyClause" ng-readonly /></div>

                            <div class="col-lg-3"><label>Remarks:</label></div>
                            <div class="col-lg-3"><input type="text" class="form-control" ng-model="FinancialQuotationDetail.Remarks" /></div>
                        </div>

                    </div>

                </div>
            </div>


        </div>




        <div class="row" ng-show="p===2" @*style="background: #9ebdc7; padding: 11px; border-radius: 10px; border: 2px solid #b7ced5; "*@>
            <div class="col-sm-12 col-md-12 col-lg-12">

                <!-- ================= CORE (MANDATORY) ================= -->
                <!-- Currency -->
                <div class="row mt-2">
                    <div class="col-lg-3"><label>Currency<span class="text-danger">*</span></label></div>
                    <div class="col-lg-3">
                        <select id="Currency" class="form-control" ng-model="FinancialQuotationDetail.Currency"
                                ng-options="ItemTypes as ItemTypes.MasterDataValue for ItemTypes in ItemTypeList track by ItemTypes.MasterDataValue " ng-required="true" style="height: 26px; font-size:smaller">

                            <option value="" selected style="display: none">-- Select One --</option>


                        </select>
                    </div>




                </div>

                <!-- Price / Per -->
                <div class="row mt-2">
                    @*<div class="col-lg-3"><label>Price<span class="text-danger">*</span></label></div>
        <div class="col-lg-3">
            <input id="price1"
                   class="form-control"
                   type="number" placeholder="0.00" min="0.01"
                   ng-model="FinancialQuotationDetail.Price"
                   ng-blur="checkAndFormat('price1')">
        </div>

        <div class="col-lg-1"><label>Per<span class="text-danger">*</span></label></div>
        <div class="col-lg-1">
            <input type="number" class="form-control"
                   ng-model="FinancialQuotationDetail.Per"
                   ng-init="FinancialQuotationDetail.Per=1"
