            element.value = ($scope.FinancialQuotationDetail.TotalPrice).toFixed(3);
            element.dispatchEvent(new Event('change'));
        }

        $scope.calculateGrossPrice = function () {




            $scope.FinancialQuotationDetail.GrossPrice = $scope.FinancialQuotationDetail.TotalPrice - $scope.FinancialQuotationDetail.TaxAmount - $scope.FinancialQuotationDetail.VatAmount;
            $scope.FinancialQuotationDetail.NetPrice = $scope.FinancialQuotationDetail.TotalPrice - $scope.FinancialQuotationDetail.TaxAmount - $scope.FinancialQuotationDetail.VatAmount;
            var element = document.getElementById('GrossPrice');
            element.value = ($scope.FinancialQuotationDetail.GrossPrice).toFixed(3);
            element.dispatchEvent(new Event('change'));

            var element = document.getElementById('NetPrice');
            element.value = ($scope.FinancialQuotationDetail.NetPrice).toFixed(3);
            element.dispatchEvent(new Event('change'));


        }

        $scope.calculateNetPrice = function () {





            $scope.FinancialQuotationDetail.NetPrice = $scope.FinancialQuotationDetail.GrossPrice - $scope.FinancialQuotationDetail.DiscountPrice;


            var element = document.getElementById('NetPrice');
            element.value = ($scope.FinancialQuotationDetail.NetPrice).toFixed(3);
            element.dispatchEvent(new Event('change'));


        }

        $scope.formatDate = function (date) {

            var res = date.split("/");
            return res[0] + "/" + res[1] + "/" + res[2];

        };


        $scope.formatMaterialCode = function (materialCode) {
            return materialCode.replace(/^0+/, '');
        };
        $scope.Refresh = function () {
            location.reload();
        };

        //---------------------

        $scope.fromDashboard = false;

        //var qrStr = window.location.search.substring(1);
        //if (qrStr != "") {

        //    $scope.fromDashboard = true;
        //    var qrStrVariables = qrStr.split('&');
        //    var qrStrone = qrStrVariables[0].split('=');
        //    var info1 = qrStrone[1];
        //    console.log(info1);

        //    $scope.toggleInvitationSelect(info1);

        //}


        var qrStr = window.location.search.substring(1);

        if (qrStr != "") {
            $scope.fromDashboard = true;
            var params = {};
            qrStr.split('&').forEach(function (param) {
                var keyValue = param.split('=');
                params[keyValue[0]] = decodeURIComponent(keyValue[1]);
            });

            if (params.InvitationNumber && params.QuotationNo) {
                // All 3 parameters exist → call Financial quotation select
                $scope.toggleQuotationSelect(params.InvitationNumber, params.QuotationNo);
            } else if (params.InvitationNumber) {
                // Only InvitationNumber → call Invitation select
                $scope.toggleInvitationSelect(params.InvitationNumber);
            }
        }




        $scope.toggleRefreshTable = function (row) {
            window.location.href = "/VendorSelectionModule/FinancialQuotation";
        };

    })
</script>


