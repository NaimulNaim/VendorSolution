        $scope.calculateTotalPrice = function (detail) {
            if (!detail) return 0;

            var pricePerUnit = (detail.Price || 0) / (detail.Per || 1);

            // Apply Unit → QuotationUnit conversion
            /*      var conversionFactor = $scope.getUnitConversionFactor(detail.PriceUnit.Item_Code, detail.QuotationQtyUnit.Item_Code);*/

            var baseTotal = pricePerUnit * (detail.QuotationQty || 0);

            // Apply discount
            if ($scope.p === 2) {
                if (detail.DiscountPer === 'P') {
                    baseTotal *= (1 - (detail.Discount || 0) / 100);
                } else if (detail.DiscountPer === 'A') {
                    baseTotal -= (detail.Discount || 0);
                }

                // Apply delivery
                if (detail.DeliveryPer === 'P') {
                    baseTotal *= (1 + (detail.DeliveryCharge || 0) / 100);
                } else if (detail.DeliveryPer === 'A') {
                    baseTotal += (detail.DeliveryCharge || 0);
                }

                // Ensure not negative
                if (baseTotal < 0) baseTotal = 0;
            }
            else {
                if (detail.DiscountPer === 'P') {
                    baseTotal *= (1 - (detail.Discount || 0) / 100);
                } else if (detail.DiscountPer === 'A') {
                    baseTotal -= (detail.Discount || 0);
                }

                if (detail.FreightPer === 'P') {
                    baseTotal *= (1 + (detail.Freight || 0) / 100);
                } else if (detail.FreightPer === 'A') {
                    baseTotal += (detail.Freight || 0);
                }

                baseTotal += detail.OrderHandlingCharges + detail.SundryCharges + detail.PackingCharges;
                if (baseTotal < 0) baseTotal = 0;
            }

            return baseTotal.toFixed(2); // 2 decimals
        };


