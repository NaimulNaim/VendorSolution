        $scope.openFileViewer = function (documentID, ext) {
            ext = (ext || '').replace(/^\./, '').toLowerCase();
            var baseUrl = '/VendorSelectionModule/TechnicalQuotation/DownloadDocument'
                + '?documentID=' + documentID
                + '&Ext=' + ext;

            $scope.PreviewDoc = {
                fileName: documentID + '.' + ext,
                fileExtension: ext,
                isPdf: ext === 'pdf',
                isImage: ['jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp'].indexOf(ext) !== -1,
                isVideo: ext === 'mp4',
                isMp4: ext === 'mp4',
                isInlineRenderable: ext === 'pdf'
                    || ['jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp'].indexOf(ext) !== -1
                    || ext === 'mp4',
                viewUrl: baseUrl,
                downloadUrl: baseUrl + '&download=true'
            };
            if ($scope.PreviewDoc.isPdf) {
                $scope.PreviewTrustedUrl = $sce.trustAsResourceUrl($scope.PreviewDoc.viewUrl);
            }
            $('#DocumentPreviewModal').modal('show');
        };
