        $scope.submit = function () {

            if ($scope.proposal === 'FINANCIAL') {
                $http.post('/VendorSelectionModule/TechnicalQuotation/submitquotation',
                    {
                        InvId: $scope.BillReceiveModel.InvitationID,
                        VendorID: $scope.BillReceiveModel.VendorID,
                        InvitationNumber: $scope.BillReceiveModel.invitationNumber,
                        MaterialCode: $scope.BillReceiveModel.materialCode,
                        MaterialName: $scope.BillReceiveModel.materialName,
                        RFQUnit: $scope.BillReceiveModel.Unit
                    })
                    .success(function (response) {
                        $scope.flagToShow = false;
                        $scope.flagToShowMasterTbl = true;
                        $scope.QuotationList = response.QuotationList[0];

                        $http.post('/VendorSelectionModule/FinancialQuotation/submitfinancialquotation',
                            {
                                FinancialQuotationlist: $scope.FinancialQuotationDetail,
                                MaterialInvitationlist: $scope.simplifiedMaterialInvitation,
                                ProposalType: $scope.proposal,
                                Quotation: $scope.QuotationList
                            })
                            .success(function (response) {

                                $scope.response = response.respStatus.Message;
                                if ($scope.response === 'Data Saved Successfully') {

                                    toastr.success($scope.response);

                                    $timeout(function () {

                                        $scope.reset();

                                        $scope.masterDataSetupGridData = [];
                                        $scope.GridDisplayCollection = [].concat($scope.masterDataSetupGridData);
                                        $scope.loading = false;
                                        $scope.myarray = [];
                                        $scope.myarray2 = [];

                                        $scope.InvWiseMaterial($scope.InvitationNumber);

                                    }, 2000);
                                    // loading stays true until the $timeout above resets it
                                }
                                else {
                                    toastr.error($scope.response);
                                    $scope.loading = false; // real failure — allow retry
                                }

                            }).error(function () {
                                $scope.loading = false;
                            });

                        $scope.GridDisplayCollection = [].concat($scope.MaterialList);
                        // removed: the stray "$scope.loading = false;" that used to sit here —
                        // it fired synchronously right after issuing the inner request, resetting
                        // the button almost instantly instead of waiting for that request to finish
                    }).error(function () {
                        $scope.loading = false;
                    });
            }
            else {

                $http.post('/VendorSelectionModule/FinancialQuotation/submitfinancialquotation',
                    {
                        FinancialQuotationlist: $scope.FinancialQuotationDetail,
                        MaterialInvitationlist: $scope.simplifiedMaterialInvitation,
                        ProposalType: $scope.proposal,
                        Quotation: ""
                    })
                    .success(function (response) {

                        $scope.response = response.respStatus.Message;
                        if ($scope.response === 'Data Saved Successfully') {
                            toastr.success($scope.response);
                            $timeout(function () {

                                $scope.reset();

                                $scope.masterDataSetupGridData = [];
                                $scope.GridDisplayCollection = [].concat($scope.masterDataSetupGridData);
                                $scope.loading = false;
                                $scope.myarray = [];
                                $scope.myarray2 = [];

                                $scope.InvWiseMaterial($scope.InvitationNumber);

                            }, 2000);
                            // loading stays true until the $timeout above resets it
                        }
                        else {
                            toastr.error($scope.response);
                            $scope.loading = false; // real failure — allow retry
                        }

                    }).error(function () {
                        $scope.loading = false;
                    });

                $scope.GridDisplayCollection = [].concat($scope.MaterialList);
            }
        };


