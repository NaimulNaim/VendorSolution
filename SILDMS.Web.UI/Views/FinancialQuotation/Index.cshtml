@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}







<style type="text/css">
    label {
        margin-bottom: 2px;
        font-weight: bold;
        font-size: 12px;
    }

    .form-control {
        height: 25px;
        font-size: smaller;
        padding: 3px 6px 3px;
    }

    .selected-row {
        background-color: #a4f5da !important;
    }

    .col-lg-3 {
        padding-right: 5px;
        padding-left: 30px;
    }

    .btn-table {
        font-size: 12px !important;
        padding: 1px 5px !important;
        line-height: 1 !important;
        height: 20px;
        border-radius: 3px;
    }

    .col-lg-6 {
        padding-right: 20px;
    }

   


    .readonly-mode input,
    .readonly-mode select,
    .readonly-mode textarea {
        pointer-events: none;
        background-color: #f8f9fa !important;
    }

    .readonly-mode button,
    .readonly-mode .btn {
        pointer-events: none;
    }



</style>

<div class="box box-primary box-body" ng-controller="FinancialQuotationCtrl">




    <div class="box-header with-border" style="font-family: Verdana; background: #E4E9E3; color: black; ">
        <i class="fa fa-user"></i>
        <h3 style="font-family: Verdana" class="box-title">Financial Quotation</h3>


        <div class="box-tools pull-right">
            <div class="col-lg-12 pull-right">
                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button type="button" data-ng-click="Refresh()" class="btn btn-warning btn-flat pull-right" ng-disabled="btnRefresh"><i class="fa fa-refresh" style="padding-right: 5px"></i>Refresh</button>
                </div>

                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button type="button" data-ng-click="Search()" class="btn btn-flat btn-primary pull-right " ng-disabled="btnSave"><i class="fa fa-search" style="padding-right: 5px"></i>Search</button>
                </div>
                @*<div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                        <button type="button" data-ng-click="submit()" class="btn btn-flat btn-primary pull-right " ng-disabled="btnSave"><i class="fa fa-save" style="padding-right: 5px"></i>Submit</button>
                    </div>*@


            </div>
        </div>
    </div>




    <div class="box-body " style="margin: 1%; padding: 5px 10px 10px 10px;" data-ng-disabled="">
        <div class="row">
            <div class="col-lg-2">
                <div class="form-group">
                    <label for="InvitationNumber">RFQ No </label>
                </div>
            </div>
            <div class="col-lg-2">
                <div class="form-group">
                    <input id="InvitationNumber" name="InvitationNumber" ng-model="InvitationNumber" readonly class="form-control" autofocus />

                </div>
            </div>

            <div class="col-lg-1">
                <button type="button"
                        ng-show="!fromDashboard && !Quotation"
                        ng-click="InvitationList()"
                        class="form-control">
                    Search
                </button>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-2">
                <div class="form-group">
                    <label for="InvitationSendingPerson">Contact Person </label>
                </div>
            </div>
            <div class="col-lg-3" style="padding-left:15px;">
                <div class="form-group">
                    <input id="InvitationSendingPerson" name="InvitationSendingPerson" ng-model="InvitationSendingPerson" readonly class="form-control" autofocus />

                </div>
            </div>

        </div>

        <div class="row">
            <div class="col-lg-2" ng-if="Quotation">
                <div class="form-group">
                    <label for="QuotationNumber">Quotation No </label>
                </div>
            </div>
            <div class="col-lg-2" ng-if="Quotation">
                <div class="form-group">
                    <input id="QuotationNumber" name="QuotationNumber" type="text" data-ng-model="Quotation" class="form-control"
                           placeholder="Quotation No" ng-readonly="true" />
                    @*<div ng-show="masterDataFrm.$submitted || masterDataFrm.UDCode.$touched">
                            <span ng-show="masterDataFrm.UDCode.$error.required" class="label label-danger">Please enter UD Code</span>
                        </div>*@
                </div>
            </div>
            <div class="col-lg-4"></div>
            <div class="col-lg-2" ng-if="Quotation && lowestshowstatus">
                <div class="form-group">
                    <label for="LowestPrice">Lowest Quoted Price </label>
                </div>
            </div>
            <div class="col-lg-2" ng-if="Quotation && lowestshowstatus">
                <div class="form-group">
                    <input id="LowestPriceNo" name="LowestPriceNo" type="text" data-ng-model="lowestPrice" class="form-control text-right"
                           placeholder="LowestPrice No" ng-readonly="true" />
                    @*<div ng-show="masterDataFrm.$submitted || masterDataFrm.UDCode.$touched">
                            <span ng-show="masterDataFrm.UDCode.$error.required" class="label label-danger">Please enter UD Code</span>
                        </div>*@
                </div>
            </div>



        </div>

    </div>



    <div style=" margin: 1%; background-color: #f0f0f0; box-shadow: 2px 2px 5px #888888; padding: 0px 10px 0px 10px;" ng-show="flagToShowMasterTbl">

        <div class="col-sm-12 col-md-12 col-lg-12" style="padding: 11px;">
            <div ng-if="flagToShow" style="text-align:center">
                <h4 style="color:red;">No data available!</h4>
            </div>
            @* Master Table *@
            <div id="PndRecomAndApprovalTable" class="table-responsive" ng-if="!flagToShow">
                @*<h5 style="color:chocolate; font-weight:bold">No of Requisitions: {{prList[0].Row_count}}</h5>*@
                <table id="tableId" st-table="GridDisplayCollection" st-safe-src="MaterialList" class="table table-condensed table-bordered table-striped table-hover pnlView">
                    <thead>
                        <tr style="font-size: 15px;">
                            <th colspan="7" style="text-align: left;font-weight: bold">Material List</th>
                        </tr>
                        <tr style="background-color: #84abc1; color: darkblue; font-size: 12px;">
                            <th style="text-align:center">Material Code</th>
                            <th style="text-align:center">Material Name</th>
                            <th style="text-align:center">RFQ Quantity</th>
                            <th style="text-align:center">RFQ Unit</th>
                            <th style="text-align:center">Documents</th>
                            @*<th style="text-align:center">Master Documents</th>*@
                            @*<th style="text-align:center">Type</th>*@
                            <th style="text-align:center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr id="rowID" ng-repeat="row in GridDisplayCollection" style="height:20px; font-size:13px;" ng-class="{'selected-row': row.selected}">
                            <td class="col-lg-2 col-md-2 col-sm-2" style="text-align:center">{{formatMaterialCode(row.materialCode)}}</td>
                            <td class="col-lg-4 col-md-4 col-sm-4">{{row.materialName}}</td>
                            <td class="col-lg-2 col-md-2 col-sm-2" style="text-align:right">{{row.MaterialQuantity| number:3}}</td>
                            <td class="col-lg-1 col-md-1 col-sm-1" style="text-align:center">{{row.Unit}}</td>
                          

                            <td class="col-lg-1 col-md-1 col-sm-1 text-center">
                                <button type="button"
                                        class="btn btn-info btn-table"
                                        ng-click="OpenAllDocumentsModal(row)"
                                        ng-show="row.sampleDocId || row.MasterDocumentID">
                                    Details <i class="fa fa-eye"></i>
                                </button>
                            </td>



                            <td class="col-lg-2 col-md-2 col-sm-2 text-center">

                                <!-- Add/Edit Button -->
                                <button ng-if="lowestshowstatus == 1"
                                        ng-click="DetailItem(row, $index + 1)"
                                        ng-class="{
                'btn btn-success btn-table': row.Action === 'A',
                'btn btn-warning btn-table': row.Action !== 'A'
            }">
                                    {{ row.Action === 'A' ? 'Add' : 'Edit' }}
                                </button>

                                <!-- Delete Button -->
                                <button ng-if="lowestshowstatus == 1 && row.FinanQuotationItemID"
                                        ng-click="openDeleteModal(row)"
                                        class="btn btn-danger btn-table"
                                        style="margin-left:4px">
                                    Delete
                                </button>

                                <!-- View Button -->
                                <button ng-if="lowestshowstatus == 0"
                                        ng-click="DetailItem(row, $index + 1)"
                                        class="btn btn-info btn-table">
                                    View
                                </button>

                            </td>



                            @*<td class="col-lg-1 col-md-1 col-sm-1" style="text-align:center">
                                    <button ng-click="DetailItem(row)">
                                        {{ row.Action === 'A' ? 'Add' : 'Edit' }}
                                    </button>

                                </td>*@

                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="9" class="text-center">
                            </td>
                        </tr>
                    </tfoot>
                </table>



             

            </div>
        </div>

    </div>

    <div style=" margin: 1%; background-color: #f0f0f0; box-shadow: 2px 2px 5px #888888; padding: 0px 10px 0px 10px;" ng-show="TechnicalQuote">




        <div class="row" ng-show="p===1" style="padding:11px; border-radius:10px; border:2px solid #b7ced5; background:#f8f9fa;">

            <div class="readonly-section"
                 ng-class="{'readonly-mode': lowestshowstatus == 0}">




                <div class="row mt-2">
                    <div class="col-lg-3"><label>Supplier Name</label></div>
                    <div class="col-lg-3" style="padding-left:0px;"><input type="text" class="form-control" ng-model="FinancialQuotationDetail.SupplierName" /></div>

                    <div class="col-lg-3"><label>Local Agent Name</label></div>
                    <div class="col-lg-3" style="padding-left:0px;"><input type="text" class="form-control" ng-model="FinancialQuotationDetail.LocalAgentName" /></div>
                </div>

                <div class="row mt-3 gx-3 gy-0">

                    <!-- LEFT SIDE -->
                    <div class="col-lg-6">


                        <div class="card border p-3 mb-3">
                            <h4 class="mb-3 text-center"><strong>Quantity</strong></h4>
                            <!-- your full Quantity content here (unchanged) -->
                            <div class="row mb-3">
                                <div class="col-lg-6"><label>Quotation Qty<span class="text-danger">*</span></label></div>

                                <div class="col-lg-4" style="padding-right:0px;padding-left:0px;">
                                    <input type="text"
                                           class="form-control text-right"
                                           ng-model="FinancialQuotationDetail.QuotationQty"
                                           three-decimals>
                                </div>
                                <div class="col-lg-2" style="padding-left: 0px;padding-right:5px;">
                                    <select class="form-control"
                                            ng-model="FinancialQuotationDetail.QuotationQtyUnit"
                                            ng-change="syncPriceUnit()"
                                            ng-required="true"
                                            ng-options="i as i.Item_Code for i in ItemList track by i.Item_Code">
                                        <option value="" style="display:none">---</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-lg-6"><label>Quotation Validity<span class="text-danger">*</span></label></div>
                                <div class="col-lg-6" style="padding-left:0px;padding-right:5px;">
                                    <input type="text" class="form-control DatePicker"
                                           id="QuotationValidity1"
                                           ng-model="FinancialQuotationDetail.QuotationValidity"
                                           ng-required="true">
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-lg-6"><label>Qty Tolerance (%)</label></div>
                                <div class="col-lg-6" style="padding-left:0px;padding-right:5px;">
                                    <input type="number" class="form-control"
                                           id="QtyTolerance"
                                           ng-model="FinancialQuotationDetail.QtyTolerance" min="0"
                                           ng-blur="checkAndFormat('QtyTolerance1')">
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-lg-6"><label>Minimum Order Qty (MOQ)</label></div>
                                <div class="col-lg-4" style="padding-left:0px;padding-right:0px;">
                                    <input type="text" class="form-control text-right" ng-model="FinancialQuotationDetail.MinimumOrderQty"
                                           three-decimals
                                           onkeypress="return (event.charCode >= 48 && event.charCode <= 57) || event.charCode == 46">
                                </div>

                                <div class="col-lg-2" style="padding-left: 0px;padding-right:5px;">
                                    <select class="form-control"
                                            ng-model="FinancialQuotationDetail.QuotationQtyUnit"
                                            ng-disabled="true"
                                            ng-options="i as i.Item_Code for i in ItemList track by i.Item_Code">
                                        <option value="" style="display:none">---</option>
                                    </select>
                                </div>
                            </div>
                        </div>



                        <!-- PRICE CARD -->



                        <br />


                        <div class="card border p-3">
                            <h4 class="mb-3 text-center"><strong>Price</strong></h4>
                            <!-- Currency (UNCHANGED STRUCTURE) -->
                            <div class="row mb-3">
                                <div class="col-lg-6">
                                    <label>
                                        Currency<span class="text-danger">*</span>
                                    </label>
                                </div>

                                <div class="col-lg-6" style="padding-left:0px;padding-right:5px;">
                                    <select id="Currency"
                                            class="form-control"
                                            ng-model="FinancialQuotationDetail.Currency"
                                            ng-options="ItemTypes as ItemTypes.MasterDataValue
                 for ItemTypes in ItemTypeList
                 track by ItemTypes.MasterDataValue"
                                            ng-required="true"
                                            style="height: 26px; font-size:smaller">

                                        <option value="" selected style="display:none">
                                            -- Select One --
                                        </option>
                                    </select>
                                </div>
                            </div>


                            <!-- Price Per Unit -->
                            <br />
                            <div class="row mb-3">

                                <div class="row" style="padding: 3px; border-radius: 5px;margin:2px; border: 2px solid #b7ced5; background: #f8f9fa;margin-left:2%;">

                                    <!-- Price -->
                                    <div class="col-lg-5 text-center">
                                        <label class="d-block text-center">
                                            Price <span class="text-danger">*</span>
                                        </label>
                                        <input type="number"
                                               class="form-control text-end"
                                               id="price"
                                               placeholder="0.00"
                                               ng-model="FinancialQuotationDetail.Price"
                                               ng-blur="checkAndFormat('price')">
                                    </div>

                                    <div class="col-lg-3 text-center">
                                        <label class="d-block text-center">
                                            Per <span class="text-danger">*</span>
                                        </label>
                                        <input type="number"
                                               class="form-control text-end"
                                               ng-model="FinancialQuotationDetail.Per"
                                               ng-init="FinancialQuotationDetail.Per=1">
                                    </div>

                                    <div class="col-lg-4 text-center">
                                        <label class="d-block text-center">
                                            Unit <span class="text-danger">*</span>
                                        </label>
                                        <select class="form-control"
                                                ng-model="FinancialQuotationDetail.PriceUnit"
                                                ng-disabled="true"
                                                ng-options="i as i.Item_Code for i in ItemList track by i.Item_Code">
                                            <option value="" style="display:none">---</option>
                                        </select>
                                    </div>


                                </div>
                            </div>








                            <br />



                            <div class="row mb-3">

                                <div class="row" style="padding: 3px; border-radius: 5px;margin:2px; border: 2px solid #b7ced5; background: #f8f9fa;margin-left:2%;">

                                    <!-- Price -->
                                    <div class="col-lg-3 text-center">
                                        <label class="d-block text-center">
                                            Incoterms <span class="text-danger">*</span>
                                        </label>
                                        <select class="form-control" ng-model="FinancialQuotationDetail.Incoterms"
                                                ng-options="i.MasterDataValue for i in IncotermsList track by i.MasterDataValue">
                                            <option value="" style="display:none">---</option>
                                        </select>
                                    </div>

                                    <div class="col-lg-5 text-center">
                                        <label class="d-block text-center">
                                            Destination <span class="text-danger">*</span>
                                        </label>
                                        <select class="form-control" ng-model="FinancialQuotationDetail.IncotermsLocation"
                                                ng-options="i.MasterDataValue for i in IncotermsLocationList track by i.MasterDataValue">
                                            <option value="" style="display:none">---</option>
                                        </select>
                                    </div>

                                    <div class="col-lg-4 text-center">
                                        <label class="d-block text-center">
                                            Shipment Mode <span class="text-danger">*</span>
                                        </label>
                                        <select class="form-control" ng-model="FinancialQuotationDetail.ShipmentMode">
                                            <option value="">--Select--</option>
                                            <option value="AIR">Air</option>
                                            <option value="SEA">Sea</option>
                                            <option value="ROAD">Road</option>
                                            <option value="TRAIN">Train</option>
                                            <option value="MAIL">Mail</option>
                                            <option value="AIR/SEA">Air/Sea</option>
                                            <option value="AIR/ROAD">Air/Road</option>
                                            <option value="AIR/TRAIN">Air/Train</option>
                                            <option value="AIR/SEA/ROAD">Air/Sea/Road</option>
                                            <option value="AIR/SEA/ROAD/TRAIN">Air/Sea/Road/Train</option>
                                            <option value="SEA/ROAD">Sea/Road</option>
                                            <option value="SEA/TRAIN">Sea/Train</option>
                                            <option value="ROAD/TRAIN">Road/Train</option>


                                        </select>
                                    </div>


                                </div>
                            </div>

                            <br />









                            <!-- Tax -->
                            <div class="row mb-3">
                                <div class="col-lg-6"><label>Additional Taxes (If Applicable)</label></div>
                                <div class="col-lg-6" style="padding-left:0px;padding-right:5px;">
                                    <select class="form-control"
                                            ng-model="FinancialQuotationDetail.Tax">
                                        <option value="">--Select--</option>
                                        <option value="Included">Included</option>
                                        <option value="Excluded">Excluded</option>
                                    </select>
                                </div>
                            </div>



                            <div class="row mb-3">
                                <div class="col-lg-6"><label>Discount</label></div>
                                @*<div class="col-lg-3"><input type="number" class="form-control" ng-model="FinancialQuotationDetail.Discount"></div>*@

                                <div class="col-lg-3" style="padding-right:0px;padding-left:0px;">

                                    <input type="number" class="form-control" ng-model="FinancialQuotationDetail.Discount" id="Discount" placeholder="Enter discount"
                                           ng-blur="checkAndFormat('Discount')">
                                </div>
                                <div class="col-lg-3" style="padding-left:0px;padding-right:5px;">
                                    <select class="form-control" ng-model="FinancialQuotationDetail.DiscountPer">
                                        <option value="P">%</option>
                                        <option value="A">Amount</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-lg-6"><label>Freight</label></div>
                                <div class="col-lg-3" style="padding-right:0px; padding-left:0px;">
                                    <input type="number" class="form-control" id="Freight" ng-model="FinancialQuotationDetail.Freight"
                                           ng-blur="checkAndFormat('Freight')" />
                                </div>
                                <div class="col-lg-3" style="padding-left:0px;padding-right:5px;">
                                    <select class="form-control" id="FreightPer" ng-model="FinancialQuotationDetail.FreightPer">
                                        <option value="P">%</option>
                                        <option value="A">Amount</option>
                                    </select>
                                </div>
                            </div>


                            <div class="row mb-3">
                                <div class="col-lg-6"><label>Payment Mode<span class="text-danger">*</span></label></div>
                                <div class="col-lg-6" style="padding-left: 0px; padding-right: 5px;">
                                    <select class="form-control" ng-model="FinancialQuotationDetail.PaymentMode"
                                            ng-options="p.MasterDataValue for p in PaymentModeList track by p.MasterDataValue">
                                        <option value="" style="display:none">---</option>
                                    </select>
                                </div>
                            </div>

                            <br />
                            <div class="row mb-3">
                                <div class="col-lg-6">
                                    <h4><strong>Total Price</strong></h4>
                                </div>

                                <div class="col-lg-6" style="padding-left:0px;padding-right:5px;">
                                    <input type="text"
                                           class="form-control text-end"
                                           style="font-size:1.5rem; font-weight:bold;"
                                           ng-value="calculateTotalPrice(FinancialQuotationDetail) | number:3"
                                           readonly>
                                </div>
                            </div>

                        </div>




                    </div>

                    <!-- RIGHT SIDE -->
                    <div class="col-lg-6">

                        <!-- QUANTITY CARD -->
                        <div class="card border p-3">
                            <h4 class="mb-3 text-center"><strong>Delivery</strong></h4>
                            <!-- your full Delivery content here (unchanged) -->
                            <!-- Currency (UNCHANGED STRUCTURE) -->
                            <div class="row mb-3">
                                <div class="col-lg-6"><label>Part Delivery</label></div>
                                <div class="col-lg-6" style="padding-left:0px;padding-right:5px;">
                                    <select class="form-control" ng-model="FinancialQuotationDetail.PartDelivery">
                                        <option value="" style="display:none">--Select--</option>
                                        <option value="Y">Allowed</option>
                                        <option value="N">Not Allowed</option>
                                    </select>
                                </div>
                            </div>

                            <!-- VAT -->
                            <div class="row mb-3">

                                <div class="col-lg-6"><label>Delivery Timeline<span class="text-danger">*</span></label></div>
                                <div class="col-lg-6" style="padding-left:0px;padding-right:5px;">
                                    <input type="text" class="form-control DatePicker"
                                           id="DeliveryTimeline1"
                                           ng-model="FinancialQuotationDetail.DeliveryTimeline"
                                           ng-required="true">
                                </div>
                            </div>


                            <!-- Tax -->

                            <div class="row mb-3">
                                <div class="col-lg-6"><label>Manufacturer Part No.</label></div>
                                <div class="col-lg-6" style="padding-left:0px;padding-right:5px;">
                                    <input type="text"
                                           class="form-control"
                                           ng-model="FinancialQuotationDetail.ManufacturerPartNo"
                                           required>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-lg-6"><label>Manufacturer Name</label></div>
                                <div class="col-lg-6" style="padding-left:0px;padding-right:5px;">
                                    <input type="text"
                                           class="form-control"
                                           ng-model="FinancialQuotationDetail.ManufacturerName"
                                           required>
                                </div>
                            </div>


                            <div class="row mb-3">

                                <div class="col-lg-6"><label>Manufacturer Site Address</label></div>
                                <div class="col-lg-6" style="padding-left:0px;padding-right:5px;">
                                    <input type="text" class="form-control"
                                           ng-model="FinancialQuotationDetail.ManufacturerSiteAddress" />
                                </div>
                            </div>

                        </div>

                        <!-- ADDITIONAL DETAILS -->
                        <br />

                        <h4 class="mb-2 text-center"
                            ng-click="showOptional = !showOptional"
                            style="cursor:pointer;color:darkblue">
                            {{ showOptional ? '-Hide Additional Details' : '+Additional Details' }}
                        </h4>

                        @*<h4 class="mb-2 text-center"
                                ng-click="toggleOptional()"
                                style="cursor:pointer;color:darkblue">
                                {{ showOptional ? '- Hide Additional Details' : '+ Additional Details' }}
                            </h4>*@

                        <div class="card border p-3"
                             ng-show="showOptional">
                            <!-- your full Additional Details content here (unchanged) -->
                            <div class="row mb-3">
                                <div class="col-lg-6"><label>Order Handling Charges</label></div>
                                <div class="col-lg-6" style="padding-left: 0px; padding-right: 5px;"><input type="number" id="OrderHandlingCharges" class="form-control" ng-model="FinancialQuotationDetail.OrderHandlingCharges" ng-blur="checkAndFormat('OrderHandlingCharges')" /></div>


                            </div>

                            <div class="row mb-3">
