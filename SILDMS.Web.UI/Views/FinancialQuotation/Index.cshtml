        function SaveQuotation() {

            $http.post(
                '/VendorSelectionModule/FinancialQuotation/SaveFinQuotwiseDetails',
                { financialQuotation: $scope.FinancialQuotationDetail }
            )
                .success(function (response) {

                    if (response.respStatus.Message === 'Data Updated Successfully') {

                        toastr.success(response.respStatus.Message);

                        $timeout(function () {
                            $scope.p = 0;
                            $scope.Refresh();
                        }, 200);
                    }
                    else {
                        toastr.error(response.respStatus.Message);
                    }

                    $scope.loading = false;
                })
                .error(function () {
                    toastr.error('Update failed');
                    $scope.loading = false;
                });
        }










        $scope.SaveDocumentOnly = function (callback) {
            var fileUpload = $("#FileUpload1").get(0);
            var files = fileUpload.files || [];
            var validFiles = [];

            angular.forEach(files, function (file) {
                validFiles.push(file);
            });

            $scope.BillReceiveModel.Extensions =
                (files.length > 0)
                    ? validFiles.map(f => f.name.split('.').pop().toLowerCase()).join(',') + ',.pdf'
                    : '.pdf';

            // On mobile, dwObject.HowManyImagesInBuffer is always 0 (stub),
            // so if no files either, block the save
            if (dwObject.HowManyImagesInBuffer === 0 && files.length === 0) {
                $scope.loading = false;
                toastr.error("There are no documents.");
                return;
            }

            $http.post('/VendorSelectionModule/FinancialQuotation/AddDocumentInfo', {
                _modelDocumentsInfo: $scope.BillReceiveModel
            }).then(function (response) {
                if (response.data.ResponseCode !== "S201") return;

                var doc = response.data.DistinctID[0];
                $scope.FinancialQuotationDetail.SampleDocumentID = doc.BillReceiveID;

                var otherFilesDone = (files.length === 0);
                var scannerDone = false;

                function checkDone() {
                    if (otherFilesDone && scannerDone) {
                        if (callback) callback();
                    }
                }

                // Scanner upload — skipped automatically on mobile because
                // stub dwObject.HowManyImagesInBuffer is always 0
                if (dwObject.HowManyImagesInBuffer > 0) {
                    var safeFileName = doc.BillReceiveID.replace(/\//g, '_');
                    dwObject.FTPPort = doc.ServerPort;
                    dwObject.FTPUserName = doc.FtpUserName;
                    dwObject.FTPPassword = doc.FtpPassword;
                    var strFTPServer = doc.ServerIP;

                    for (var i = 0; i < dwObject.HowManyImagesInBuffer; i++) {
                        dwObject.SelectedImagesCount = i + 1;
                        dwObject.SetSelectedImageIndex(i, i);
                    }

                    var isUploaded = dwObject.FTPUploadAsMultiPagePDF(
                        strFTPServer,
                        doc.FileServerUrl + "/" + safeFileName + ".pdf"
                    );

                    if (isUploaded) {
                        console.log("Scanner uploaded");
                        dwObject.RemoveAllSelectedImages();
                        toastr.success("Scanner PDF uploaded successfully");
                        scannerDone = true;
                        checkDone();
                    } else {
                        toastr.error("Scanner PDF upload failed");
                    }
                } else {
                    // Mobile: no scanner, go straight to callback
                    scannerDone = true;
                    checkDone();
                }

                // Other files upload
                if (files.length > 0) {
                    var uploadCount = 0;

                    angular.forEach(validFiles, function (file) {
                        var fileData = new FormData();
                        fileData.append('serverIP', doc.ServerIP);
                        fileData.append('ftpPort', doc.ServerPort);
                        fileData.append('ftpUserName', doc.FtpUserName);
                        fileData.append('ftpPassword', doc.FtpPassword);
                        fileData.append('serverURL', doc.FileServerUrl);
                        fileData.append('documentID', doc.BillReceiveID);
                        fileData.append('Ext', file.name.split('.').pop().toLowerCase());
                        fileData.append(file.name, file);

                        $.ajax({
                            url: '/VendorSelectionModule/FinancialQuotation/UploadOtherFiles',
                            type: "POST",
                            contentType: false,
                            processData: false,
                            data: fileData,
                            success: function (result) {
                                uploadCount++;
                                if (uploadCount === validFiles.length) {
                                    toastr.success("Files uploaded successfully");
                                    var $el = $('#FileUpload1');
                                    $el.wrap('<form>').closest('form').get(0).reset();
                                    $el.unwrap();
                                    otherFilesDone = true;
                                    checkDone();
                                }
                            },
                            error: function (err) {
                                toastr.error("File upload failed");
                                console.error('Upload error:', err);
                            }
                        });
                    });
                }
            });
        };











