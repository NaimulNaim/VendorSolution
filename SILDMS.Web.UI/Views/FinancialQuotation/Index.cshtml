

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<style type="text/css">
    label {
        margin-bottom: 2px;
        font-weight: bold;
        font-size: 12px;
    }

    .form-control {
        height: 25px;
        font-size: smaller;
        padding: 3px 6px 3px;
    }

    .selected-row {
        background-color: #a4f5da !important;
    }
</style>

<div class="box box-primary box-body" ng-controller="FinancialQuotationCtrl">




    @*<i class="fa fa-user"></i>
            <h3 style="font-family: Verdana" class="box-title" ng-if="fromMenu">Purchase Requisition Wise Materials Assign from Menu</h3>
            <h3 style="font-family: Verdana" class="box-title" ng-if="!fromMenu">Purchase Requisition Wise Materials Assign from Dashboard</h3>
            <div class="box-tools pull-right">
                <button type="button" id="btnRefresh" data-ng-click="toggleRefreshTable(row)" class="btn btn-warning btn-flat pull-right" ng-disabled="loading"><i class="fa fa-refresh"></i> Refresh</button>
            </div>
        </div>*@















    <div class="box-header with-border" style="font-family: Verdana; background: #E4E9E3; color: black; ">
        <i class="fa fa-user"></i>
        <h3 style="font-family: Verdana" class="box-title">Financial Quotation</h3>


        <div class="box-tools pull-right">
            <div class="col-lg-12 pull-right">
                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button type="button" data-ng-click="Refresh()" class="btn btn-warning btn-flat pull-right" ng-disabled="btnRefresh"><i class="fa fa-refresh" style="padding-right: 5px"></i>Refresh</button>
                </div>

                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button type="button" data-ng-click="Search()" class="btn btn-flat btn-primary pull-right " ng-disabled="btnSave"><i class="fa fa-search" style="padding-right: 5px"></i>Search</button>
                </div>
                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button type="button" data-ng-click="submit()" class="btn btn-flat btn-primary pull-right " ng-disabled="btnSave"><i class="fa fa-save" style="padding-right: 5px"></i>Submit</button>
                </div>


            </div>
        </div>
    </div>




    <div class="box-body " style="margin: 1%; padding: 5px 10px 10px 10px;" data-ng-disabled="">
        <div class="row">
            <div class="col-lg-3 ">
                <div class="form-group">
                    <label for="InvitationNumber">RFQ Number :</label>
                </div>
            </div>
            <div class="col-lg-2">
                <div class="form-group">
                    <input id="InvitationNumber" name="InvitationNumber" ng-model="InvitationNumber" readonly class="form-control" autofocus />

                </div>
            </div>

            <div class="col-lg-1">
                <button type="button" ng-show="!fromDashboard" ng-if="!Quotation" ng-click="InvitationList()" class="form-control">Search</button>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-3 " ng-if="Quotation">
                <div class="form-group">
                    <label for="QuotationNumber">Quotation Number :</label>
                </div>
            </div>
            <div class="col-lg-2" ng-if="Quotation">
                <div class="form-group">
                    <input id="QuotationNumber" name="QuotationNumber" type="text" data-ng-model="Quotation" class="form-control"
                           placeholder="Quotation Number" ng-readonly="true" />
                    @*<div ng-show="masterDataFrm.$submitted || masterDataFrm.UDCode.$touched">
                            <span ng-show="masterDataFrm.UDCode.$error.required" class="label label-danger">Please enter UD Code</span>
                        </div>*@
                </div>
            </div>

        </div>

    </div>



    <div style=" margin: 1%; background-color: #f0f0f0; box-shadow: 2px 2px 5px #888888; padding: 0px 10px 0px 10px;" ng-show="flagToShowMasterTbl">
        <div class="row">
            <div class="col-sm-12 col-md-12 col-lg-12" style="padding: 11px;">
                <div ng-if="flagToShow" style="text-align:center">
                    <h4 style="color:red;">No data available!</h4>
                </div>
                @* Master Table *@
                <div id="PndRecomAndApprovalTable" class="table-responsive" ng-if="!flagToShow">
                    @*<h5 style="color:chocolate; font-weight:bold">No of Requisitions: {{prList[0].Row_count}}</h5>*@
                    <table id="tableId" st-table="GridDisplayCollection" st-safe-src="MaterialList" class="table table-condensed table-bordered table-striped table-hover pnlView">
                        <thead>
                            <tr style="font-size: 15px;">
                                <th colspan="7" style="text-align: left;font-weight: bold">Material List</th>
                            </tr>
                            <tr style="background-color: #84abc1; color: darkblue; font-size: 13px;">
                                <th>Material Code</th>
                                <th>Material Name</th>
                                <th>Quantity</th>
                                <th>Unit</th>
                                <th>Documents</th>
                                <th>Type</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr id="rowID" ng-repeat="row in GridDisplayCollection" style="height:20px; font-size:13px;" ng-class="{'selected-row': row.selected}">
                                <td class="col-lg-1 col-md-1 col-sm-1">{{formatMaterialCode(row.materialCode)}}</td>
                                <td class="col-lg-6 col-md-6 col-sm-6">{{row.materialName}}</td>
                                <td class="col-lg-1 col-md-1 col-sm-1" style="text-align:right">{{row.MaterialQuantity| number:3}}</td>
                                <td class="col-lg-1 col-md-1 col-sm-1">{{row.Unit}}</td>
                                <td class="col-lg-1 col-md-1 col-sm-1">
                                    <button type="button" class="button-detail" ng-click="AddDocument(row)" data-dismiss="modal" title="Show detail">Details <i class="fa fa-eye"></i></button>
                                </td>


                                <td class="col-lg-1 col-md-1 col-sm-1">{{row.MatInvType}}</td>


                                <td class="col-lg-1 col-md-1 col-sm-1">
                                    <button ng-click="DetailItem(row,$index+1)">
                                        {{ row.Action === 'A' ? 'Add' : 'Edit' }}
                                    </button>

                                </td>

                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="9" class="text-center">
                                </td>
                            </tr>
                        </tfoot>
                    </table>



                    @*<div class="box-tools pull-right">
                            <button type="button" id="btnRefresh" data-ng-click="fetchfromgoogle()" class="btn btn-warning btn-flat pull-right" ng-disabled="loading"><i class="fa fa-refresh"></i> Fetch from Google</button>
                        </div>*@


                </div>
            </div>
        </div>
    </div>

    <div style=" margin: 1%; background-color: #f0f0f0; box-shadow: 2px 2px 5px #888888; padding: 0px 10px 0px 10px;" ng-show="TechnicalQuote">

        <div class=" row" style=" margin: 1%;">
            @*Technical Quotation of Item {{Material}}*@
        </div>

        <div class="row" ng-show="p===1" @*style="background: #9ebdc7; padding: 11px; border-radius: 10px; border: 2px solid #b7ced5; "*@>
            <div class="col-sm-12 col-md-12 col-lg-12" style="padding: 11px; margin-right: 15px; margin-left: 15px;">


                <div class="row">
                    <div class="col-lg-3">
                        <div class="form-group">
                            <label for="ProposeQty">Propose Qty :</label>
                        </div>
                    </div>
                    <div class="col-lg-2">

                        <input id="ProposeQty" name="ProposeQty" data-ng-model="FinancialQuotationDetail.ProposeQty" class="form-control"
                               type="number" placeholder="0.00" min="0.01" ng-blur="checkAndFormat('ProposeQty')" autofocus />



                    </div>
                    <div class="col-lg-1">




                        <select id="Unit" name="Unit" ng-model="FinancialQuotationDetail.Unit" class="form-control" autofocus
                                ng-options="Item as Item.Item_Code for Item in ItemList track by Item.Item_Code" style="padding:1px;">
                            <option value="" style="display: none;">---</option>
                        </select>




                    </div>


                    <div class="col-lg-2">
                        <div class="form-group">
                            <label for="UnitPrice">Unit Price :</label>
                        </div>
                    </div>

                    <div class="col-lg-2">
                        <input id="UnitPrice" name="UnitPrice" data-ng-model="FinancialQuotationDetail.UnitPrice" class="form-control"
                               type="number" placeholder="0.00" min="0.01" ng-blur="checkAndFormat('UnitPrice'); calculateTotalPrice()" autofocus />

                    </div>
                    <div class="col-lg-1">
                        <div class="form-group">
                            <select id="Currency" name="Currency" class="form-control" ng-model="FinancialQuotationDetail.Currency"
                                    @*ng-options="ItemTypes.MasterDataValue as ItemTypes.MasterDataValue for ItemTypes in ItemTypeList track by ItemTypes.MasterDataValue " ng-required="true" style="height: 26px; font-size:smaller">*@
                                    ng-options="ItemTypes as ItemTypes.MasterDataValue for ItemTypes in ItemTypeList track by ItemTypes.MasterDataValue " ng-required="true" style="height: 26px; font-size:smaller">
                                <option value="" selected style="display: none">---</option>


                            </select>

                        </div>
                    </div>









                </div>




                <div class="row">
                    <div class="col-lg-3">
                        <div class="form-group">
                            <label for="TotalPrice">Total Price :</label>
                        </div>
                    </div>

                    <div class="col-lg-2">
                        <input id="TotalPrice" name="TotalPrice" readonly data-ng-model="FinancialQuotationDetail.TotalPrice" class="form-control"
                               type="number" placeholder="0.000" min="0.001" ng-blur="checkAndFormat('TotalPrice')" autofocus />

                    </div>
                    <div class="col-lg-1">
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <label for="VatAmount">Vat Amount :</label>
                        </div>
                    </div>

                    <div class="col-lg-2">
                        <input id="VatAmount" name="VatAmount" data-ng-model="FinancialQuotationDetail.VatAmount" class="form-control"
                               type="number" placeholder="0.00" min="0.01" ng-blur="checkAndFormat('VatAmount'); calculateGrossPrice()" autofocus />

                    </div>




                </div>

                <div class="row">



                    <div class="col-lg-3">
                        <div class="form-group">
                            <label for="TaxAmount">Tax Amount :</label>
                        </div>
                    </div>

                    <div class="col-lg-2">
                        <input id="TaxAmount" name="TaxAmount" data-ng-model="FinancialQuotationDetail.TaxAmount" class="form-control"
                               type="number" placeholder="0.00" min="0.01" ng-blur="checkAndFormat('TaxAmount'); calculateGrossPrice() " autofocus />

                    </div>
                    <div class="col-lg-1">
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <label for="GrossPrice">Gross Amount :</label>
                        </div>
                    </div>

                    <div class="col-lg-2">
                        <input id="GrossPrice" name="GrossPrice" readonly data-ng-model="FinancialQuotationDetail.GrossPrice" class="form-control"
                               type="number" placeholder="0.00" min="0.01" ng-blur="checkAndFormat('GrossPrice')" autofocus />

                    </div>





                </div>



                <div class="row">
                    <div class="col-lg-3">
                        <div class="form-group">
                            <label for="DiscountPrice">Discount Price :</label>
                        </div>
                    </div>

                    <div class="col-lg-2">
                        <input id="DiscountPrice" name="DiscountPrice" data-ng-model="FinancialQuotationDetail.DiscountPrice" class="form-control"
                               type="number" placeholder="0.00" min="0.01" ng-blur="checkAndFormat('DiscountPrice'); calculateNetPrice()" autofocus />

                    </div>
                    <div class="col-lg-1">
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <label for="NetPrice">Net Price :</label>
                        </div>
                    </div>

                    <div class="col-lg-2">
                        <input id="NetPrice" name="NetPrice" readonly data-ng-model="FinancialQuotationDetail.NetPrice" class="form-control"
                               type="number" placeholder="0.00" min="0.01" ng-blur="checkAndFormat('NetPrice')" autofocus />

                    </div>


                </div>



                <div class="row">

                    <div class="col-lg-3">
                        <div class="form-group">
                            <label>QuotValid Delivery Date :</label>
                        </div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <input id="QuotValidDate" name="QuotValidDate" readonly type="text" class="DatePicker form-control" placeholder="DD/MM/YYYY"
                                   ng-model="FinancialQuotationDetail.QuotValidDate" ng-disabled="loading " ng-style="{ 'background-color': (loading) ? '#f0f0f0' : 'white' }" />
                        </div>
                    </div>
                    <div class="col-lg-1">
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <label>Expected Delivery Date :</label>
                        </div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <input id="ExpecDeliDate" name="ExpecDeliDate" type="text" class="DatePicker form-control" placeholder="DD/MM/YYYY"
                                   ng-model="FinancialQuotationDetail.ExpecDeliDate" @*ng-disabled="loading || PurreqMaster.PurreqNumber !== '' " ng-style="{ 'background-color': (loading || PurreqMaster.PurreqDate !== '') ? '#f0f0f0' : 'white' }"*@ />
                        </div>
                    </div>




                </div>







            </div>

        </div>




        <div class="row" ng-show="p===2" @*style="background: #9ebdc7; padding: 11px; border-radius: 10px; border: 2px solid #b7ced5; "*@>
            <div class="col-sm-12 col-md-12 col-lg-12" style="padding: 11px; margin-right: 15px; margin-left: 15px;">

                <div class="row">

                    <div class="col-lg-3 ">
                        <div class="form-group">
                            <label for="ManufacturerPart">Manufacturer Part No :</label>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="form-group">
                            <input id="ManufacturerPart" name="ManufacturerPart" type="text" ng-model="TechnicalQuotation.ManufacturerPart" class="form-control"
                                   placeholder="Manufacturer Part" />

                        </div>
                    </div>

                    <div class="col-lg-2 ">
                        <div class="form-group">
                            <label for="Installation">Installation,Testing & Commissioning :</label>
                        </div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <input id="Installation" name="Installation" type="text" ng-model="TechnicalQuotation.Installation" class="form-control"
                                   placeholder=" " />

                        </div>
                    </div>

                </div>

                <div class="row">

                    <div class="col-lg-3">
                        <div class="form-group">
                            <label for="Manufacturer">Manufacturer :</label>
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <input id="Manufacturer" name="Manufacturer" type="text" ng-model="TechnicalQuotation.Manufacturer" class="form-control"
                               placeholder="Manufacturer" />

                    </div>



                    <div class="col-lg-2">
                        <div class="form-group">
                            <label for="Subcontractor">Subcontractor :</label>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="form-group">

                            <input type="radio" ng-model="TechnicalQuotation.Subcontractor" ng-value="'Yes'"> Yes
                            <input type="radio" ng-model="TechnicalQuotation.Subcontractor" ng-value="'No'"> No

                            @*<input type="text" ng-show="sampleAvailable === 'other'" ng-model="otherSample" placeholder="Specify Other">*@



                        </div>
                    </div>




                </div>

                <div class="row">

                    <div class="col-lg-3">
                        <div class="form-group">
                            <label for="ManufacturerOrigin">Manufacturer Origin :</label>
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <input id="ManufacturerOrigin" name="ManufacturerOrigin" type="text" ng-model="TechnicalQuotation.ManufacturerOrigin" class="form-control"
                               placeholder="Manufacturer Origin" />

                    </div>




                    <div class="col-lg-2">
                        <div class="form-group">
                            <label for="Reference">Reference :</label>
                        </div>
                    </div>
                    <div class="col-lg-2">
                        <input id="Reference" name="Reference" type="text" ng-model="TechnicalQuotation.Reference" class="form-control"
                               placeholder="Reference" />

                    </div>






                </div>

                <div class="row">

                    <div class="col-lg-3">
                        <div class="form-group">
                            <label for="LocalPartner">Local Partner :</label>
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <input id="LocalPartner" name="LocalPartner" type="text" ng-model="TechnicalQuotation.LocalPartner" class="form-control"
                               placeholder="Local Partner " />

                    </div>


                </div>








                <div class="row">
                    <div class="col-lg-3">
                        <div class="form-group">
                            <label for="Prerequisite">Prerequisite/Assistance At Site :</label>
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <input id="Prerequisite" name="Prerequisite" type="text" ng-model="TechnicalQuotation.Prerequisite" class="form-control"
                               placeholder="Prerequisite " />

                    </div>


                    <div class="col-lg-2 ">
                        <div class="form-group">
                            <label for="Penalty">Penalty Clause :</label>
                        </div>
                    </div>
                    <div class="col-lg-2">
                        <input id="Penalty" name="Penalty" type="text" ng-model="TechnicalQuotation.Penalty" class="form-control"
                               placeholder="Penalty Clause " />

                    </div>



                </div>
                <div class="row">
                    <div class="col-lg-3">
                        <div class="form-group">
                            <label for="Fat">Fat At Manufacture's Site :</label>
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <input id="Fat" name="Fat" type="text" data-ng-model="TechnicalQuotation.Fat" class="form-control"
                               placeholder="" />

                    </div>


                    <div class="col-lg-2 ">
                        <div class="form-group">
                            <label for="Calibration">Calibration :</label>
                        </div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <select id="Calibration" class="form-control" ng-model="TechnicalQuotation.Calibration"
                                    ng-options="option.value as option.label for option in allcalibration">
                                <option value="" style="display: none;">--Select--</option>

                            </select>

                        </div>
                    </div>




                </div>

                <div class="row">
                    <div class="col-lg-3">
                        <div class="form-group">
                            <label for="Document">Qualification Documents :</label>
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <select ui-select2="{ allowClear: true}" id="select-option" multiple ng-model="TechnicalQuotation.Document" data-placeholder="Material Cat" style="width:100%;" class="form-control"
                                ng-options="option.value as option.label for option in allcalibration">
                        </select>
                    </div>






                </div>

                <div class="row">
                    <div class="col-lg-3">
                        <div class="form-group">
                            <label for="Validation">Validation Scope :</label>
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <input id="Validation" name="Validation" type="text" data-ng-model="TechnicalQuotation.Validation" class="form-control"
                               placeholder="Validation" />
                    </div>



                    <div class="col-lg-2">
                        <div class="form-group">
                            <label for="Training">Training :</label>
                        </div>
                    </div>

                    <div class="col-lg-2">
                        <select id="Training" class="form-control" ng-model="TechnicalQuotation.Training"
                                ng-options="option.value as option.label for option in alltraining">
                            <option value="" style="display: none;">--Select--</option>

                        </select>

                    </div>



                </div>









            </div>

        </div>

        <div class="row" ng-if="p===1 || p===2">

            <div class="btn-group pull-right" style=" margin-right: 70px;">

                <button type="submit" id="btnSubmit1" ng-if="MaterialInvitation.FinanQuotationItemID!='' " ng-click=" Update()" class="btn btn-primary btn-flat">Update</button>
                <button type="submit" id="btnSubmit" ng-if="MaterialInvitation.FinanQuotationItemID==''" ng-click=" Post()" class="btn btn-primary btn-flat">Save</button>


                @*<button type="button" data-ng-click="ConfirmVision()" class="form-control" ng-disabled="btnConfirm"><i class="fa fa-plus" style="padding-right: 5px"></i>Add Item</button>*@
            </div>



        </div>




    </div>


    <div class="row">
        <div class="col-lg-12">
            <div class="row">
                <!-- /.col -->
                <div class="col-md-10">

                    <div class="box-header with-border">
                        <h4 class="box-title">Process Documents:</h4>
                    </div>
                    <div class="box-body no-padding">
                        <div class="row">
                        </div>
                        <div class="row">
                            <div class="col-lg-6">

                                <input type="file" id="FileUpload1" name="FileUpload1" multiple />
                            </div>
                            <div class="col-lg-6" style="margin-bottom:10px" ng-show="IsDownload">
                                <div style="float: right; display: flex;">
                                    <div style="font-weight: bold; padding-right: 11px;">
                                        Existing Document:
                                    </div>
                                    <div style="padding-right: 11px;" ng-show="FileExtension!='.pdf'">{{MaterialInvitation.SampleDocumentID +"."+ FileExtension }}</div>
                                    <a class="btn btn-sm btn-warning" ng-show="FileExtension!='.pdf'" style="display: inline-block;" href="/VendorSelectionModule/TechnicalQuotation/DownloadDocument?documentID={{MaterialInvitation.SampleDocumentID}}&Ext={{FileExtension}}">Download</a>
                                </div>

                            </div>



                        </div>
                        <div class="row">
                            <div class="col-lg-12">

                                <div id="dwtHorizontalThumbnil"></div>

                            </div>
                        </div>
                        <div class="row">
                            <div id="external-events">


                                <div class="col-lg-6">
                                    <div class="external-event bg-gray " style="position: relative;">
                                        Scanner
                                        <select id="source" class="form-control"></select>
                                    </div>
                                </div>
                                @*<div class="col-lg-6">
                                        <div class="external-event bg-gray " style="position: relative;">
                                            Upload Type
                                            <select class="form-control" id="uploadType" name="uploadType" ng-model="uploadType" ng-init="uploadType='1'">
                                                <option value="1">Normal Upload</option>
                                                <option value="2">Other Upload</option>
                                                <option value="3">Secure Upload</option>
                                            </select>
                                        </div>
                                    </div>*@




                            </div>
                        </div>
                    </div>
                    <!-- /.box-body -->
                    <!-- /. box -->
                </div>
                <!-- /.col -->

                <div class="col-md-2" style="padding-left:0px;">

                    <div class="box-header with-border">
                        <h4 class="box-title">Options</h4>
                    </div>
                    <div class="box-body">
                        <!-- the events -->
                        <div id="external-events">

                            <div class="external-event bg-yellow " ng-click="AcquireImage();" style="position: relative; cursor:pointer">
                                <i class="fa fa-print"></i> Scan
                            </div>
                            <div class="external-event bg-aqua " ng-click="LoadImage()" style="position: relative; cursor: pointer">

                                <i class="fa fa-inbox"></i> Load PDF

                            </div>
                            <div class="external-event bg-purple" ng-click="LoadImageWithoutBlank()" style="position: relative; cursor: pointer">

                                <i class="fa fa-pagelines"></i> Load Blank PDF

                            </div>

                            <div class=" btnAnoLoad external-event bg-maroon" ng-click="Load()" style="position: relative; cursor: pointer">

                                <i class="fa fa-clipboard"></i> Load Another PDF

                            </div>


                            <div ng-click="RemoveAllSelectedImages()" class="external-event bg-light-blue " style="position: relative; cursor: pointer">

                                <i class="fa fa-remove"></i> Remove

                            </div>
                            <div ng-click="RotateRight()" class="external-event bg-red " style="position: relative; cursor: pointer">

