        $scope.SaveDocumentAndSubmit = function () {
            console.log('SaveDocumentAndSubmit called');

            var fileUpload = $("#FileUpload1").get(0);
            var files = fileUpload.files;
            var validFiles = [];
            var extensions = [];
            var concatenatedExtensions = "";

            if (files.length > 0) {
                angular.forEach(files, function (file) {
                    var ext = file.name.split('.').pop().toLowerCase();
                    validFiles.push(file);
                    extensions.push(ext);
                });



                if (validFiles.length === 0) {
                    alert('No valid files to upload.');
                    return;
                }

                concatenatedExtensions = extensions.join(',') + ',.pdf';
            } else {
                concatenatedExtensions = '.pdf';
            }

            $scope.BillReceiveModel.Extensions = concatenatedExtensions;

            // On mobile stub, HowManyImagesInBuffer is always 0
            if (concatenatedExtensions === '.pdf' && dwObject.HowManyImagesInBuffer === 0) {
                $scope.loading = false;
                toastr.error("There are no documents.");
                return;
            }

            $http.post('/VendorSelectionModule/FinancialQuotation/AddDocumentInfo', {
                _modelDocumentsInfo: $scope.BillReceiveModel
            }).then(function (response) {

                if (response.data.ResponseCode === "S201") {
                    $scope.data = response.data.DistinctID[0];
                    $scope.FinancialQuotationDetail.SampleDocumentID = response.data.DistinctID[0].BillReceiveID;

                    var otherFilesComplete = (files.length === 0);
                    var scannerPDFComplete = false;

                    var checkAllUploadsComplete = function () {
                        if (otherFilesComplete && scannerPDFComplete) {
                            console.log('All uploads complete, calling submit...');
                            $scope.submit();
                            $scope.p = 0;
                        }
                    };

                    // Other files upload
                    if (files.length > 0) {
                        var uploadCount = 0;

                        angular.forEach(validFiles, function (file) {
                            var fileData = new FormData();
                            fileData.append('serverIP', response.data.DistinctID[0].ServerIP);
                            fileData.append('ftpPort', response.data.DistinctID[0].ServerPort);
                            fileData.append('ftpUserName', response.data.DistinctID[0].FtpUserName);
                            fileData.append('ftpPassword', response.data.DistinctID[0].FtpPassword);
                            fileData.append('serverURL', response.data.DistinctID[0].FileServerUrl);
                            fileData.append('documentID', response.data.DistinctID[0].BillReceiveID);
                            fileData.append('Ext', file.name.split('.').pop().toLowerCase());
                            fileData.append(file.name, file);

                            $.ajax({
                                url: '/VendorSelectionModule/FinancialQuotation/UploadOtherFiles',
                                type: "POST",
                                contentType: false,
                                processData: false,
                                data: fileData,
                                success: function (result) {
                                    uploadCount++;
                                    if (uploadCount === validFiles.length) {
                                        toastr.success("Other files uploaded successfully");
                                        var $el = $('#FileUpload1');
                                        $el.wrap('<form>').closest('form').get(0).reset();
                                        $el.unwrap();
                                        otherFilesComplete = true;
                                        checkAllUploadsComplete();
                                    }
                                },
                                error: function (err) {
                                    toastr.error("File upload failed");
                                    console.error('Upload error:', err);
                                }
                            });
                        });
                    }

                    // Scanner upload — skipped on mobile because stub HowManyImagesInBuffer === 0
                    if (dwObject.HowManyImagesInBuffer > 0) {
                        var strFTPServer = response.data.DistinctID[0].ServerIP;

                        if (!strFTPServer) {
                            toastr.error("FTP Server is not assigned");
                            $scope.loading = false;
                            return;
                        }

                        dwObject.FTPPort = response.data.DistinctID[0].ServerPort;
                        dwObject.FTPUserName = response.data.DistinctID[0].FtpUserName;
                        dwObject.FTPPassword = response.data.DistinctID[0].FtpPassword;

                        var safeFileName = response.data.DistinctID[0].BillReceiveID.replace(/\//g, '_');

                        for (var i = 0; i <= dwObject.HowManyImagesInBuffer - 1; i++) {
                            dwObject.SelectedImagesCount = i + 1;
                            dwObject.SetSelectedImageIndex(i, i);
                        }
                        dwObject.SelectedImagesCount = dwObject.HowManyImagesInBuffer;

                        var isSave = dwObject.FTPUploadAsMultiPagePDF(
                            strFTPServer,
                            response.data.DistinctID[0].FileServerUrl + "//" + safeFileName + ".pdf"
                        );

                        if (isSave) {
                            dwObject.RemoveAllSelectedImages();
                            toastr.success("Scanner PDF uploaded successfully");
                            scannerPDFComplete = true;
                            checkAllUploadsComplete();
                        } else {
                            toastr.error("Scanner PDF upload failed");
                        }

                    } else {
                        // Mobile or no scanner images
                        scannerPDFComplete = true;
                        checkAllUploadsComplete();
                    }
                }

            }, function (error) {
                console.error('Error sending document info', error);
                toastr.error("Failed to save document information");
            });
        };




