        $scope.UpdateDocument = function () {


            var isMobile = /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);

            if (isMobile) {
               /* toastr.warning("Document update is not available on mobile devices.");*/
                return;
            }


            dwObject.IfShowFileDialog = false;
            $scope.IsDownload = false;








            var fileUpload = $("#FileUpload1").get(0);
            var files = fileUpload.files;
            var validFiles = [];
            var extensions = [];
            var concatenatedExtensions = "";

            console.log(files);

            if (files.length > 0) {

                angular.forEach(files, function (file) {

                    var ext = file.name.split('.').pop().toLowerCase();

                    validFiles.push(file);
                    extensions.push(ext);

                });

                if (validFiles.length === 0) {
                    alert('No valid files to upload.');
                    return;
                }

                var uploadCount = 0;

                angular.forEach(validFiles, function (file) {

                    var fileData = new FormData();

                    fileData.append('serverIP', $scope.Server.ServerIP);
                    fileData.append('ftpPort', $scope.Server.ServerPort);
                    fileData.append('ftpUserName', $scope.Server.FtpUserName);
                    fileData.append('ftpPassword', $scope.Server.FtpPassword);
                    fileData.append('serverURL', $scope.Server.FileServerURL);

                    // same document id = replace existing document
                    fileData.append('documentID', $scope.MaterialInvitation.SampleDocumentID);

                    fileData.append('Ext', file.name.split('.').pop().toLowerCase());
                    fileData.append(file.name, file);

                    $.ajax({
                        url: '/VendorSelectionModule/FinancialQuotation/UploadOtherFiles',
                        type: "POST",
                        contentType: false,
                        processData: false,
                        data: fileData,
                        success: function (result) {

                            uploadCount++;

                            if (uploadCount === validFiles.length) {

                                toastr.success("Document Replaced Successfully");

                                var $el = $('#FileUpload1');
                                $el.wrap('<form>').closest('form').get(0).reset();
                                $el.unwrap();
                            }
                        },
                        error: function (err) {

                            toastr.error("Document Upload Failed");
                        }
                    });
                });












                // Concatenate extensions

                concatenatedExtensions = extensions.join(',');
                concatenatedExtensions = extensions.join(',') + ',.pdf';
                $scope.Server.Extensions = concatenatedExtensions;
            }



            dwObject.FTPPort = $scope.Server.ServerPort;
            dwObject.FTPUserName = $scope.Server.FtpUserName;
            dwObject.FTPPassword = $scope.Server.FtpPassword;

            var safeFileName = $scope.MaterialInvitation.SampleDocumentID
                .replace(/\//g, '_');

            var isSave = dwObject.FTPUploadAllAsPDF($scope.Server.ServerIP,
                $scope.Server.FileServerURL + "//" +
                safeFileName + ".pdf");
            //var isSave = dwObject.FTPUploadAllAsPDF($scope.Server.ServerIP,
            //    $scope.Server.FileServerURL + "//" +
            //    $scope.MaterialInvitation.SampleDocumentID + ".pdf");





            if (isSave) {
                // dwObject.RemoveAllImages();
                $http.post('/VendorSelectionModule/FinancialQuotation/UpdateExtensionByDocId', {
                    DocumentID: $scope.MaterialInvitation.SampleDocumentID,
                    Extension: $scope.Server.Extensions
                })
                    .success(function (response) {
                        if (response.respStatus.Message) {
                            $scope.loading = false;
                            toastr.success("Document Updated Successfully");

                            dwObject.RemoveAllImages();

                        }
                        else {
                            toastr.error('Document Update Failed');
                        }
                        $scope.loading = false;
                    }).error(function () {
                        $scope.loading = false;
                    });

            }
            else {
                toastr.error('Document Update Failed');
            }


        };


