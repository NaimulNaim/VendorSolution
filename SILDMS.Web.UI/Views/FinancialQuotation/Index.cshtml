                    toastr.error("Failed to save document information");
                    $scope.loading = false; // was a silent dead-end before — button stayed stuck disabled
                    return;
                }
                var doc = response.data.DistinctID[0];
                $scope.FinancialQuotationDetail.SampleDocumentID = doc.BillReceiveID;
                var uploadCount = 0;
                angular.forEach(validFiles, function (file) {
                    var fileData = new FormData();
                    fileData.append('serverIP', doc.ServerIP);
                    fileData.append('ftpPort', doc.ServerPort);
                    fileData.append('ftpUserName', doc.FtpUserName);
                    fileData.append('ftpPassword', doc.FtpPassword);
                    fileData.append('serverURL', doc.FileServerUrl);
                    fileData.append('documentID', doc.DocumentID);
                    fileData.append('Ext', file.name.split('.').pop().toLowerCase());
                    fileData.append(file.name, file);
                    $.ajax({
                        url: '/VendorSelectionModule/FinancialQuotation/UploadOtherFiles',
                        type: "POST",
