        $scope.FormatDigits = function (txtVendor, lmt) {
            var val = $("#" + txtVendor).val();

            // Allow 0 or positive numbers only
            if (val === "" || isNaN(val) || Number(val) < 0) {
                $("#" + txtVendor).val('');
                $("#btnSaveDoc").prop("disabled", true);
                return;
            }

            var d = val.split('.');

            // Check integer part length
            if (d[0].length > lmt) {
                $("#" + txtVendor).val('');
                $("#btnSaveDoc").prop("disabled", true);
                return;
            }

            // Format to 2 decimal places
            $("#" + txtVendor).val(Number(val).toFixed(2));
            $("#btnSaveDoc").prop("disabled", false);
        };



