        <script type="text/javascript">

    app.directive('threeDecimals', function ($filter) {
        return {
            require: 'ngModel',
            link: function (scope, element, attrs, ngModelController) {

                // Model → View: format with commas when model changes programmatically
                ngModelController.$formatters.push(function (modelValue) {
                    if (modelValue === null || modelValue === undefined || modelValue === '') {
                        return '';
                    }
                    var num = parseFloat(modelValue);
                    return isNaN(num) ? modelValue : $filter('number')(num, 3);
                });

                // View → Model: strip commas, save as plain number
                ngModelController.$parsers.push(function (viewValue) {
                    if (!viewValue) return viewValue;
                    var clean = viewValue.toString().replace(/,/g, '');
                    var num = parseFloat(clean);
                    return isNaN(num) ? 0 : num;
                });

                // Real-time formatting as user types
                element.on('input', function () {
                    var raw = element.val();

                    // Only allow digits and one decimal point
                    raw = raw.replace(/[^0-9.]/g, '');

                    // Prevent multiple decimal points
                    var parts = raw.split('.');
                    if (parts.length > 2) {
                        raw = parts[0] + '.' + parts.slice(1).join('');
                    }

                    // Limit to 3 decimal places while typing
                    if (parts[1] !== undefined && parts[1].length > 3) {
                        raw = parts[0] + '.' + parts[1].substring(0, 3);
                    }

                    // Add commas to integer part only
                    var intPart = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
                    var formatted = parts.length === 2 ? intPart + '.' + (parts[1] || '') : intPart;

                    // Save cursor position
                    var cursorPos = element[0].selectionStart;
                    var oldLen = element.val().length;

                    element.val(formatted);

                    // Adjust cursor for added/removed commas
                    var newLen = formatted.length;
                    var newCursor = cursorPos + (newLen - oldLen);
                    element[0].setSelectionRange(newCursor, newCursor);

                    // Update model with plain number
                    ngModelController.$setViewValue(raw.replace(/,/g, ''));
                    ngModelController.$commitViewValue();
                });

                // Blur: finalize with full 3 decimal places e.g. 10,000.000
                element.on('blur', function () {
                    var value = element.val().replace(/,/g, '');
                    var num = parseFloat(value);
                    if (!isNaN(num) && value !== '') {
                        element.val($filter('number')(num, 3));
                        ngModelController.$setViewValue(num);
                    }
                });
            }
        };
    });

