        function setValue(id, value) {
            var element = document.getElementById(id);
            if (!element) return;

            var safeValue = (value !== null && value !== undefined)
                ? Number(value).toFixed(2)
                : '0.00';

            element.value = safeValue;
            element.dispatchEvent(new Event('change'));
        }


